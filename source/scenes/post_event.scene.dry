title: Post Event
new-page: true
on-arrival: {!
Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;
// make sure no stat is below 0.
for (var c of Q.classes) {
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
    }
}

if (Q.prov_gov_legitimacy < 1) Q.prov_gov_legitimacy = 1;
if (Q.prov_gov_legitimacy > 100) Q.prov_gov_legitimacy = 100;
if (Q.soviet_cooperation < 0.01) Q.soviet_cooperation = 0.01;
if (Q.soviet_cooperation > 1) Q.soviet_cooperation = 1;
if (Q.prov_gov_efficacy < 0.01) Q.prov_gov_efficacy = 0.01;
if (Q.prov_gov_efficacy > 1) Q.prov_gov_efficacy = 1;
if (Q.soviet_efficacy < 0.01) Q.soviet_efficacy = 0.01;
if (Q.soviet_efficacy > 1) Q.soviet_efficacy = 1;
if (Q.war_weariness < 0) Q.war_weariness = 0;
if (Q.war_weariness > 99) Q.war_weariness = 99;

// round to integers...
Q.train_capacity = Math.round(Q.train_capacity);




if (Q.hunger > 10) {
	Q.disillusionment += (Q.hunger >= 50 ? 4 :
						  Q.hunger >= 40 ? 2 :
						  Q.hunger >= 30 ? 1 :
						  Q.hunger >= 20 ? 0.5 :
						  Q.hunger > 10 ? 0.25 : 0)
						  * (1 - Q.democraticity / 200);				  
	} else {
		Q.disillusionment -= 1 + (Q.democraticity / 400);
}

if (Q.war_weariness >= 30) {
	Q.disillusionment += (Q.war_weariness >= 60 ? 2 :
						  Q.war_weariness >= 40 ? 1 :
						  Q.war_weariness >= 30 ? 0.5 : 0)
						  * (1 - Q.democraticity / 200);				  
	} else {
		Q.disillusionment -= 0.25 + (Q.democraticity / 400);
}

if (Q.monthly_inflation > 5) {
	Q.disillusionment += (Q.monthly_inflation >= 15 ? 3 :
						  Q.monthly_inflation >= 12.5 ? 2 :
						  Q.monthly_inflation >= 10 ? 1.5 :
						  Q.monthly_inflation >= 7.5 ? 1 :
						  Q.monthly_inflation > 5 ? 0.5 : 0)
						  * (1 - Q.democraticity / 200);				  
	} else {
		Q.disillusionment -= 0.5 + (Q.democraticity / 400);
}

if (Q.crime > 20) {
	Q.disillusionment += (Q.crime >= 60 ? 1.5 :
						  Q.crime >= 50 ? 1 :
						  Q.crime >= 40 ? 0.5 :
						  Q.crime >= 30 ? 0.25 :
						  Q.crime > 20 ? 0.125 : 0)
						  * (1 - Q.democraticity / 200);				  
	} else {
		Q.disillusionment -= 0.5 + (Q.democraticity / 400);
}
if (Q.disillusionment < 0) Q.disillusionment = 0;


for (var c of Q.classes) {
    var unrest = Q[c + "_unrest"];
    for (var party of Q.parties) {
		if (party == "none") {
            continue;
        }
        if (Q.governing_parties.includes(party)) {
            if (unrest < 50) {
                Q[c + "_" + party] += (50 - unrest) / 10
                    * Q.base_attractiveness[c][party]
                    * Math.max(1, Q[party + "_strength"]) / 50
                    * (1 - Q.instability / 200);
} else {
                Q[c + "_" + party] += (50 - unrest) / 10
                    * Q.base_attractiveness[c][party]
                    * 50 / Math.max(1, Q[party + "_strength"])
                    * (1 + Q.instability / 200);
}
        } else {
            if (unrest > 50) {
                Q[c + "_" + party] += (unrest - 50) / 10
                    * Q.base_attractiveness[c][party]
                    * Math.max(1, Q[party + "_strength"]) / 50
                    * (1 - Q.instability / 200);
            } else {
                Q[c + "_" + party] += (unrest - 50) / 10
                    * Q.base_attractiveness[c][party]
                    * 50 / Math.max(1, Q[party + "_strength"])
                    * (1 + Q.instability / 200);
            }
        }
    }
}


for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
        class_votes += Q[c+'_'+party];
    }
    for (var party of Q.parties) {
        Q[c + '_' + party + '_normalized'] = 100*Q[c+'_'+party]/class_votes;

        Q[c + '_' + party + '_display'] = Math.round(100*Q[c+'_'+party]/class_votes);
    }
}
// calculate support for each of the parties
var total_support = 0; 
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        if (Q.old_demographics) { 
            party_support += Q[c]*Q[c+'_'+party];
        } else  { 
            party_support += Q[c]*Q[c+'_'+party+'_normalized'];
        } 
    }
    Q[party + '_support'] = party_support;
    total_support += party_support; 
}
// 2. normalize support (fraction)
for (var party of Q.parties) {
    Q[party+'_normalized'] = Q[party + '_support']/total_support;
    Q[party+'_votes'] = Math.round(Q[party+'_normalized']*100);
    Q[party+'_votes_display'] = Math.round(Q[party+'_normalized']*100);
}

console.log("Disillusionment:", Q.disillusionment);
console.log("none support:", Q.none_support);
for (var party of Q.parties) {
    console.log(party + ": " + Q[party + "_normalized"]);
}


console.log(
    "NONE RAW:",
    Q.none_support,
    "NONE NORMALIZED:",
    Q.none_normalized,
    "TOTAL:",
    total_support
);

for (var party of Q.parties) {
    console.log(
        party,
        "raw:",
        Q[party + "_support"],
        "normalized:",
        Q[party + "_normalized"]
    );
}








// set faction strength/dissent to 0
// re-calculate dissent.
for (var p of Q.parties) {
    var total_strength = 0;
    var total_dissent = 0;
    if (Q[p+"_factions"]) {
        for (var c of (Q[p+"_factions"])) {
            if (Q[c+'_dissent'] < 0) {
                Q[c+'_dissent'] = 0;
            } else if (Q[c+'_dissent'] >= 100) {
                Q[c+'_dissent'] = 99;
            }
            if (Q[c+'_strength'] < 0) {
                Q[c+'_strength'] = 0.1;
            }
            total_strength += Q[c+'_strength'];
        }
        for (var c of (Q[p+"_factions"])) {
            Q[c+'_strength'] = 100*Q[c+'_strength']/total_strength;
            total_dissent += Q[c+'_dissent']*Q[c+'_strength']/total_strength;
        }
        Q[p+'_dissent'] = 0.01*total_dissent;
        Q[p+'_percent_dissent'] = total_dissent;
        console.log(p+'_dissent', Q[p+'_dissent']);
    }
}

// should we normalize militia/defense force support levels? Or should they be treated like demographic supports? Normalizing would make support changes more dramatic.
// Normalize them, so that they're dramatic.
var total_workers_militia_loyalty = Q.workers_militia_independent;
for (var p of Q.workers_militia_parties) {
    total_workers_militia_loyalty += Q['workers_militia_' + p + '_loyalty'];
}
for (var p of Q.workers_militia_parties) {
    Q['workers_militia_' + p + '_loyalty'] = 100*Q['workers_militia_' + p + '_loyalty']/total_workers_militia_loyalty;
}
Q.workers_militia_independent = 100*Q.workers_militia_independent/total_workers_militia_loyalty;
// normalize city militia loyalty
var total_city_militia_loyalty = Q.city_militia_independent;
for (var p of Q.city_militia_parties) {
    total_city_militia_loyalty += Q['city_militia_' + p + '_loyalty'];
}
for (var p of Q.city_militia_parties) {
    Q['city_militia_' + p + '_loyalty'] = 100*Q['city_militia_' + p + '_loyalty']/total_city_militia_loyalty;
}
Q.city_militia_independent = 100*Q.city_militia_independent/total_city_militia_loyalty;

// Garrison loyalty is the same as that for the soldiers demographic as a whole.
var total_garrison_loyalty = 0;
for (var p of Q.parties) {
    total_garrison_loyalty += Q['soldiers_' + p];
}
non_independent = 0;
for (var p of Q.garrison_parties) {
    Q['garrison_' + p + '_loyalty'] = 100*Q['soldiers_' + p]/total_garrison_loyalty;
    non_independent += Q['garrison_' + p + '_loyalty'];
}
Q.garrison_independent = 100*(100-non_independent)/total_garrison_loyalty;

if (Q.unemployed <= 1) {
    Q.unemployed = 1;
}

Q.leaders = {};
// Bolsheviks
Q.leaders.None = { auctoritas: 1, administration: 1, idealogism: 1, military: 1, economic: 1, partyorg: 1, diplomacy: 1, culture: 1, legalism: 1, nationalities: 1 };
Q.leaders.Vacant = { auctoritas: 1, administration: 1, idealogism: 1, military: 1, economic: 1, partyorg: 1, diplomacy: 1, culture: 1, legalism: 1, nationalities: 1 };
Q.leaders.Skvortsov = { auctoritas: 2.5, administration: 2, idealogism: 1, military: 1, economic: 2.5, partyorg: 3, diplomacy: 1, culture: 1, legalism: 1.5, nationalities: 1 };
Q.leaders.Lenin = { auctoritas: 6, administration: 5, idealogism: 5, military: 2, economic: 3.5, partyorg: 4, diplomacy: 3.5, culture: 2, legalism: 3, nationalities: 3 };
Q.leaders.Trotsky = { auctoritas: 5, administration: 5, idealogism: 5, military: 5, economic: 3, partyorg: 3.5, diplomacy: 3.5, culture: 1.5, legalism: 2, nationalities: 1 };
Q.leaders.Krylenko = { auctoritas: 3, administration: 3, idealogism: 2, military: 4, economic: 2, partyorg: 3, diplomacy: 1, culture: 1, legalism: 4, nationalities: 1 };
Q.leaders.Lunacharsky = { auctoritas: 3.5, administration: 4, idealogism: 4, military: 1, economic: 2, partyorg: 2, diplomacy: 3, culture: 5, legalism: 2, nationalities: 1.5 };
Q.leaders.Rykov = { auctoritas: 4, administration: 5, idealogism: 2, military: 2, economic: 4, partyorg: 3, diplomacy: 2.5, culture: 1.5, legalism: 2.5, nationalities: 1.5 };
Q.leaders.Nogin = { auctoritas: 3, administration: 3.5, idealogism: 2, military: 2, economic: 3.5, partyorg: 2.5, diplomacy: 2, culture: 1, legalism: 2, nationalities: 1 };
Q.leaders.Oppokov = { auctoritas: 2.5, administration: 3, idealogism: 2, military: 2, economic: 2, partyorg: 2, diplomacy: 2, culture: 1, legalism: 4, nationalities: 1 };
Q.leaders.Shliapnikov = { auctoritas: 4, administration: 4, idealogism: 4, military: 2, economic: 3.5, partyorg: 3.5, diplomacy: 3, culture: 1.5, legalism: 1, nationalities: 1 };
Q.leaders.Milyutin = { auctoritas: 2.5, administration: 3, idealogism: 1.5, military: 1, economic: 2, partyorg: 2, diplomacy: 1.5, culture: 1, legalism: 1.5, nationalities: 1 };
Q.leaders.Teodorovich = { auctoritas: 3, administration: 4, idealogism: 3, military: 2, economic: 3, partyorg: 2.5, diplomacy: 1.5, culture: 1, legalism: 2, nationalities: 1 };
Q.leaders.Avilov = { auctoritas: 2.5, administration: 3, idealogism: 2.5, military: 1, economic: 2.5, partyorg: 3, diplomacy: 1.5, culture: 3, legalism: 2, nationalities: 1 };
Q.leaders.Stalin = { auctoritas: 4, administration: 4, idealogism: 3, military: 2, economic: 3, partyorg: 5, diplomacy: 3, culture: 2, legalism: 2, nationalities: 5 };
Q.leaders.Chicherin = { auctoritas: 3, administration: 4, idealogism: 3, military: 1, economic: 2, partyorg: 2.5, diplomacy: 5, culture: 2, legalism: 3, nationalities: 3 };
Q.leaders.Ioffe = { auctoritas: 2.5, administration: 3, idealogism: 2, military: 1.5, economic: 1.5, partyorg: 2.5, diplomacy: 3, culture: 2, legalism: 2, nationalities: 1.5 };
Q.leaders.Dybenko = { auctoritas: 3, administration: 3, idealogism: 1.5, military: 4, economic: 1.5, partyorg: 2, diplomacy: 2, culture: 1, legalism: 3, nationalities: 1.5 };
Q.leaders.Podvoisky = { auctoritas: 3.5, administration: 4, idealogism: 1.5, military: 4, economic: 1.5, partyorg: 3, diplomacy: 2, culture: 1.5, legalism: 2.5, nationalities: 1.5 };
Q.leaders.Krupskaya = { auctoritas: 2.5, administration: 3, idealogism: 1.5, military: 1, economic: 1.5, partyorg: 2.5, diplomacy: 2, culture: 4, legalism: 2.5, nationalities: 1 };
Q.leaders.Pokrovsky = { auctoritas: 3.5, administration: 4, idealogism: 3.5, military: 1.5, economic: 2, partyorg: 2.5, diplomacy: 2, culture: 3, legalism: 2.5, nationalities: 1.5 };
Q.leaders.Bubnov = { auctoritas: 2.5, administration: 3, idealogism: 1.5, military: 2.5, economic: 2, partyorg: 3, diplomacy: 1.5, culture: 2, legalism: 1.5, nationalities: 1 };
Q.leaders.Lebedev = { auctoritas: 2, administration: 3, idealogism: 1, military: 1, economic: 2, partyorg: 2, diplomacy: 2, culture: 3, legalism: 2.5, nationalities: 1.5 };
Q.leaders.Bogdanov = { auctoritas: 3, administration: 4, idealogism: 5, military: 2, economic: 3, partyorg: 4, diplomacy: 2, culture: 5, legalism: 2.5, nationalities: 2 };
Q.leaders.Sokolnikov = { auctoritas: 3, administration: 4, idealogism: 2, military: 2, economic: 5, partyorg: 3, diplomacy: 2, culture: 2, legalism: 2.5, nationalities: 1.5 };
Q.leaders.Kollontai = { auctoritas: 3, administration: 3, idealogism: 4, military: 1.5, economic: 2, partyorg: 2.5, diplomacy: 3.5, culture: 4, legalism: 1.5, nationalities: 1.5 };
Q.leaders.Vinokurov = { auctoritas: 2.5, administration: 3.5, idealogism: 2.5, military: 1.5, economic: 3, partyorg: 3, diplomacy: 2.5, culture: 2, legalism: 3.5, nationalities: 1 };
Q.leaders.N_Milyutin = { auctoritas: 2, administration: 3, idealogism: 2, military: 1.5, economic: 3, partyorg: 3, diplomacy: 1.5, culture: 2.5, legalism: 1.5, nationalities: 1.5 };

// Mensheviks
Q.leaders.Martov = { auctoritas: 5, administration: 4, idealogism: 4, military: 1.5, economic: 3, partyorg: 4, diplomacy: 3, culture: 2, legalism: 3, nationalities: 1.5 };
Q.leaders.Sukhanov = { auctoritas: 3.5, administration: 4, idealogism: 3, military: 1.5, economic: 2.5, partyorg: 3.5, diplomacy: 3, culture: 1.5, legalism: 2.5, nationalities: 1.5 };


// SRs
Q.leaders.Natanson = { auctoritas: 3.5, administration: 4, idealogism: 3, military: 1.5, economic: 3, partyorg: 4, diplomacy: 3, culture: 1.5, legalism: 2, nationalities: 1.5 };


Q.finalefficacy_sovnarkom =
    Q.efficacy_sovnarkom
    + (0.25 * (
        (Q.leaders[Q.prime_minister].auctoritas / 5)
        + (Q.leaders[Q.prime_minister].administration / 5)
    ))
    + (0.125 * (
        Q.leaders[Q.deputy_pm].administration / 5
    ));

Q.finalefficacy_foreign =
    Q.efficacy_foreign
    + (0.25 * (
        (Q.leaders[Q.foreign_minister].auctoritas / 20)
        + (Q.leaders[Q.foreign_minister].administration / 10)
        + (Q.leaders[Q.foreign_minister].diplomacy / 4)
    ));

Q.finalefficacy_military =
    Q.efficacy_military
    + (0.25 * (
        (Q.leaders[Q.war_minister].auctoritas / 20)
        + (Q.leaders[Q.war_minister].administration / 10)
        + (Q.leaders[Q.war_minister].military / 5)
    ));

Q.finalefficacy_enlightenment =
    Q.efficacy_enlightenment
    + (0.25 * (
        (Q.leaders[Q.education_minister].auctoritas / 20)
        + (Q.leaders[Q.education_minister].administration / 10)
        + (Q.leaders[Q.education_minister].culture / 5)
    ));

Q.finalefficacy_internal =
    Q.efficacy_internal
    + (0.25 * (
        (Q.leaders[Q.interior_minister].auctoritas / 20)
        + (Q.leaders[Q.interior_minister].administration / 10)
        + (Q.leaders[Q.interior_minister].military / 5)
    ));

Q.finalefficacy_railways =
    Q.efficacy_railways
    + (0.25 * (
        (Q.leaders[Q.transport_minister].auctoritas / 20)
        + (Q.leaders[Q.transport_minister].administration / 10)
        + (Q.leaders[Q.transport_minister].military / 10)
        + (Q.leaders[Q.transport_minister].economic / 10)
    ));

Q.finalefficacy_trade =
    Q.efficacy_trade
    + (0.25 * (
        (Q.leaders[Q.trade_minister].auctoritas / 20)
        + (Q.leaders[Q.trade_minister].administration / 10)
        + (Q.leaders[Q.trade_minister].economic / 5)
        + (Q.leaders[Q.trade_minister].diplomacy / 10)
    ));

Q.finalefficacy_finance =
    Q.efficacy_finance
    + (0.25 * (
        (Q.leaders[Q.finance_minister].auctoritas / 20)
        + (Q.leaders[Q.finance_minister].administration / 10)
        + (Q.leaders[Q.finance_minister].economic / 5)
    ));

Q.finalefficacy_justice =
    Q.efficacy_justice
    + (0.25 * (
        (Q.leaders[Q.justice_minister].auctoritas / 20)
        + (Q.leaders[Q.justice_minister].administration / 10)
        + (Q.leaders[Q.justice_minister].legalism / 10)
    ));

Q.finalefficacy_agriculture =
    Q.efficacy_agriculture
    + (0.25 * (
        (Q.leaders[Q.agriculture_minister].auctoritas / 20)
        + (Q.leaders[Q.agriculture_minister].administration / 10)
        + (Q.leaders[Q.agriculture_minister].economic / 5)
    ));

Q.finalefficacy_foodsupply =
    Q.efficacy_foodsupply
    + (0.25 * (
        (Q.leaders[Q.food_minister].auctoritas / 20)
        + (Q.leaders[Q.food_minister].administration / 10)
        + (Q.leaders[Q.food_minister].economic / 5)
    ));

Q.finalefficacy_labor =
    Q.efficacy_labor
    + (0.25 * (
        (Q.leaders[Q.labor_minister].auctoritas / 20)
        + (Q.leaders[Q.labor_minister].administration / 10)
        + (Q.leaders[Q.labor_minister].economic / 5)
        + (Q.leaders[Q.labor_minister].diplomacy / 10)
    ));

Q.finalefficacy_posts =
    Q.efficacy_posts
    + (0.25 * (
        (Q.leaders[Q.posts_minister].auctoritas / 20)
        + (Q.leaders[Q.posts_minister].administration / 10)
        + (Q.leaders[Q.posts_minister].economic / 5)
    ));

Q.finalefficacy_nationalities =
    Q.efficacy_nationalities
    + (0.25 * (
        (Q.leaders[Q.nationalities_minister].auctoritas / 20)
        + (Q.leaders[Q.nationalities_minister].administration / 10)
        + (Q.leaders[Q.nationalities_minister].nationalities / 5)
    ));

Q.finalefficacy_welfare =
    Q.efficacy_welfare
    + (0.25 * (
        (Q.leaders[Q.welfare_minister].auctoritas / 20)
        + (Q.leaders[Q.welfare_minister].administration / 10)
        + (Q.leaders[Q.welfare_minister].economic / 5)
        + (Q.leaders[Q.welfare_minister].culture / 20)
    ));

if (Q.finalefficacy_sovnarkom + Q.finalefficacy_foreign + Q.finalefficacy_military + Q.finalefficacy_enlightenment + Q.finalefficacy_internal + Q.finalefficacy_railways + Q.finalefficacy_trade + Q.finalefficacy_finance + Q.finalefficacy_justice + Q.finalefficacy_agriculture + Q.finalefficacy_foodsupply + Q.finalefficacy_labor + Q.finalefficacy_posts + Q.finalefficacy_nationalities + Q.finalefficacy_welfare >= 21) {
    Q.dreamteam = 1;
}


if (Q.sovnarkom_expend < 0.25) Q.sovnarkom_expend = 0.25;
if (Q.internal_expend < 0.25) Q.internal_expend = 0.25;
if (Q.foreignaffairs_expend < 0.25) Q.foreignaffairs_expend = 0.25;
if (Q.military_expend < 0.25) Q.military_expend = 0.25;
if (Q.enlightmenet_expend < 0.25) Q.enlightmenet_expend = 0.25;
if (Q.railways_expend < 0.25) Q.railways_expend = 0.25;
if (Q.trade_expend < 0.25) Q.trade_expend = 0.25;
if (Q.finance_expend < 0.25) Q.finance_expend = 0.25;
if (Q.justice_expend < 0.25) Q.justice_expend = 0.25;
if (Q.agriculture_expend < 0.25) Q.agriculture_expend = 0.25;
if (Q.foodsupply_expend < 0.25) Q.foodsupply_expend = 0.25;
if (Q.nationalities_expend < 0.25) Q.nationalities_expend = 0.25;
if (Q.welfare_expend < 0.25 && Q.welfare_founded != 1) Q.welfare_expend = 0;
if (Q.welfare_expend < 0.25 && Q.welfare_founded == 1) Q.welfare_expend = 0.25;

Q.government_functions = (
    Q.sovnarkom_expend +
    Q.internal_expend +
    Q.foreignaffairs_expend +
    Q.military_expend +
    Q.enlightmenet_expend +
    Q.railways_expend +
    Q.trade_expend +
    Q.finance_expend +
    Q.justice_expend +
    Q.agriculture_expend +
    Q.foodsupply_expend +
    Q.nationalities_expend +
    Q.welfare_expend
);

Q.income_tax_1 =
(
    (
        Q.elites *
        (75 - ((Q.elite_unrest / 10) * (Q.elite_strength / 100))) / 100
    )
    +
    (
        Q.middle *
        (6.25 - ((Q.middle_unrest / 10) * (Q.middle_strength / 100))) / 100
    )
) * Q.income_tax_rate_1;

Q.income_tax_2 =
(
    (
        Q.elites *
        (25 - ((Q.elite_unrest / 10) * (Q.elite_strength / 100))) / 400
    )
    +
    (
        Q.middle *
        (25 - ((Q.middle_unrest / 10) * (Q.middle_strength / 100))) / 400
    )
    +
    (
        Q.intelligentsia *
        (12.5 - ((Q.intelligentsia_unrest / 10) * (Q.intelligentsia_strength / 100))) / 400
    )
) * Q.income_tax_rate_2;

Q.income_tax_3 =
(
    (
        Q.middle *
        (68.75 - ((Q.middle_unrest / 10) * (Q.middle_strength / 100))) / 600
    )
    +
    (
        Q.intelligentsia *
        (50 - ((Q.intelligentsia_unrest / 10) * (Q.intelligentsia_strength / 100))) / 600
    )
    +
    (
        Q.kulaks *
        (25 - ((Q.kulak_unrest / 10) * (Q.kulak_strength / 100))) / 600
    )
) * Q.income_tax_rate_3;

Q.income_tax_4 =
(
    (
        Q.kulaks *
        (75 - ((Q.kulak_unrest / 10) * (Q.kulak_strength / 100))) / 1000
    )
    +
    (
        Q.workers *
        (75 - ((Q.labor_unrest / 10) * (Q.labor_strength / 100))) / 1000
    )
) * Q.income_tax_rate_4;

Q.income_tax_5 =
(
    (
        Q.peasants *
        (75 - ((Q.peasant_unrest / 10) * (Q.peasant_strength / 100))) / 3000
    )
    +
    (
        Q.workers *
        (25 - ((Q.labor_unrest / 10) * (Q.labor_strength / 100))) / 3000
    )
) * Q.income_tax_rate_5;


Q.income_tax =
(
    Q.income_tax_1
    + Q.income_tax_2
    + Q.income_tax_3
    + Q.income_tax_4
    + Q.income_tax_5
)
*
(
    ((Q.income_tax_efficacy / 4 * 3) + (Q.finalefficacy_finance / 4))
);


Q.property_tax =
(
    (
        (
            Q.elites *
            (100 - ((Q.elite_unrest / 10) * (Q.elite_strength / 100))) / 100
        )
        *
        (Q.elite_wealth / 50)
    )
    +
    (
        (
            Q.middle *
            (100 - ((Q.middle_unrest / 10) * (Q.middle_strength / 100))) / 100
        )
        *
        (Q.middle_wealth / 500)
    )
    +
    (
        (
            Q.intelligentsia *
            (75 - ((Q.intelligentsia_unrest / 10) * (Q.intelligentsia_strength / 100))) / 100
        )
        *
        (Q.intelligentsia_wealth / 500)
    )
    +
    (
        (
            Q.kulaks *
            (75 - ((Q.kulak_unrest / 10) * (Q.kulak_strength / 100))) / 100
        )
        *
        (Q.kulak_wealth / 5000)
    )
    +
    (
        (
            Q.workers *
            (100 - ((Q.labor_unrest / 10) * (Q.labor_strength / 100))) / 100
        )
        *
        (Q.labor_wealth / 2500)
    )
    +
    (
        (
            Q.peasants *
            (75 - ((Q.peasant_unrest / 10) * (Q.peasant_strength / 100))) / 100
        )
        *
        (Q.peasant_wealth / 7500)
    )
)
*
Q.wealth_tax_rate
*
(
    ((Q.wealth_tax_efficacy / 4 * 3) + (Q.finalefficacy_finance / 4))
);


Q.business_tax =
(
    (
        Q.elites *
        (100 - ((Q.elite_unrest / 10) * (Q.elite_strength / 100))) / 100
        *
        (Q.elite_business / 50)
    )
    +
    (
        Q.middle *
        (100 - ((Q.middle_unrest / 10) * (Q.middle_strength / 100))) / 100
        *
        (Q.middle_business / 500)
    )
)
*
(
    ((Q.business_tax_efficacy / 4 * 3) + (Q.finalefficacy_finance / 4))
);

console.log("interest:", Q.interest);
Q.interest = (
    (Q.loans_high * 0.16) +
    (Q.loans_med * 0.12) +
    (Q.loans_low * 0.08) +
    (Q.bonds * (Q.bond_rate / 100)) +
    (Q.bank_advances * 0.02)
);
console.log("interest:", Q.interest);

Q.expenditure = Math.round(
    (
    Q.interest +
    Q.indemnities +
    Q.government_functions
    ) * 100
) / 100;


Q.income = Math.round(
    (
    Q.income_tax +
    Q.property_tax +
    Q.business_tax +
    Q.monopolies +
    Q.customs +
    Q.railway_revenue +
    Q.enterprises_revenue
    ) * 100
) / 100;

Q.publicdebt = Math.round(
    Q.loans_high +
    Q.loans_med +
    Q.loans_low +
    Q.bonds +
    Q.bank_advances
);

Q.resources = Math.round(Q.resources * 10) /10; 

// inflation
Q.inflation = Math.pow(1+0.01*Q.monthly_inflation, 12);
Q.inflation = Math.round(1000*(Q.inflation - 1))/10;

// food production and distribution
// food demand
Q.urban_population = 145000000*(Q.workers)/100;
Q.rural_population = 145000000*(100 - Q.workers - Q.soldiers)/100;
Q.soldiers_population = 145000000*(Q.soldiers)/100;
// These are basic demands
Q.food_demand_urban = Q.urban_population*500/1000000;// in million kg/year
Q.food_demand_rural = Q.rural_population*500/1000000; // million kg/year - minimal demand; lower than this would provoke famine/violence
Q.food_demand_military = Q.soldiers_population*700/1000000; // million kg/year
Q.food_requisitioned = 1.2*Q.food_demand_military/Q.food_production;

// hunger
Q.food_supply_urban = Q.food_production*Q.food_sold;
// food transport is 15% of civilian supply trains (arbitrary number)
Q.food_transport_capacity = Q.train_capacity*Q.civilian_trains*0.15/100;
// food transport capacity is an upper bound on food supply
if (Q.food_supply_urban > Q.food_transport_capacity) {
    Q.food_supply_urban = Q.food_transport_capacity;
}
Q.hunger = 100*(Q.food_demand_urban - Q.food_supply_urban)/Q.food_demand_urban;
if (Q.hunger < 0) {
    Q.hunger = 0;
}
Q.food_demand_urban = Math.round(Q.food_demand_urban);
Q.food_supply_urban = Math.round(Q.food_supply_urban);
Q.hunger = Math.round(Q.hunger); 
// rural hunger 
Q.food_supply_rural = Q.food_production*(1 - Q.food_sold)*(1 - Q.food_requisitioned); 
Q.rural_hunger = 100*(Q.food_demand_rural - Q.food_supply_rural)/Q.food_demand_rural;
if (Q.rural_hunger < 0) {
    Q.rural_hunger = 0;
}
// soldier hunger
Q.food_supply_soldier = Q.food_production*Q.food_requisitioned;
// again, 15% of military trains are for food
Q.food_transport_capacity_soldier = Q.train_capacity*Q.military_trains*0.15/100;
if (Q.food_supply_soldier > Q.food_transport_capacity_soldier) {
    Q.food_supply_soldier = Q.food_transport_capacity_soldier; 
}
Q.soldier_hunger = 100*(Q.food_demand_military - Q.food_supply_soldier)/
Q.food_demand_military;
if (Q.soldier_hunger < 0) {
    Q.soldier_hunger = 0; 
}


// 1. update dates
if (Q.week_actions >= 1 && Q.current_player >= Q.n_players) {
    Q.week_actions = 0;
    Q.time += 1;
    Q.week += 1;
    if (Q.week >= 5) {
        Q.month += 1;
        Q.week = 1;

    }
    if (Q.month >= 13) {
        Q.month = 1;
        Q.year += 1;
    }
    // update records
    if (Q.time > 0) {
        var party_support_results = {'date': new Date(Q.year, Q.month - 1, 1+Q.week*7)};
        for (var party of Q.soviet_parties) {
            party_support_results[party] = Q[party + '_soviet'];
        }
    }
    Q.soviet_support_records.push(party_support_results);
    Q.economic_records.push({'date': new Date(Q.year, Q.month - 1, 1+Q.week*7),
                             'inflation': Q.inflation,
                             'unemployment': Q.unemployed,
                             'industry': Q.industry,
                             'hunger': Q.hunger});

    // Update Soviet representation on every new week
    var petrograd_classes = ["workers", "soldiers"];

    for (var c of petrograd_classes) {
        var class_votes = 0;
        for (var party of Q.parties) {
            if (party == "none") {
                continue;
            }
            if (!Q[c+'_'+party] || Q[c+'_'+party] < 0) {
                Q[c+'_'+party] = 0;
            }
            class_votes += Q[c+'_'+party];
        }
        for (var party of Q.parties) {
            Q[c + '_' + party + '_normalized'] = 100*Q[c+'_'+party]/class_votes;
            Q[c + '_' + party + '_display'] = Math.round(100*Q[c+'_'+party]/class_votes);
        }
    }
    // 1. calculate support for each of the parties
    var total_support = 0;
    for (var party of Q.parties) {
        if (party == "none") {
            continue;
        }
        var party_support = 0;
        for (var c of petrograd_classes) {
            party_support += Q[c + '_petrograd']*Q[c+'_'+party+'_normalized'];
        }
        if (Q[party + '_soviet_bonus']) {
          party_support += Q[party + '_soviet_bonus'];
        }
        Q[party + '_support'] = party_support;
        total_support += party_support;
    }
    // 2. normalize support (fraction)
    // 3. Round to integers
    // round to 1 decimal instead of rounding to integers
    // to do that, we multiply party_normalized*1000 and divide the rounded number by 10.
    for (var party of Q.parties) {
        if (party == "none") {
            continue;
        }
        Q[party+'_soviet_normalized'] = Q[party + '_support']/total_support;
        Q[party+'_soviet_votes_dec'] = Math.round(Q[party+'_soviet_normalized']*1000)/10;
        Q[party+'_soviet_votes'] = Math.round(Q[party+'_soviet_normalized']*100);
        Q[party + '_soviet_votes_disp'] = Q[party+'_soviet_votes_dec'].toFixed(1);
    }
    Q.m_soviet = Q.m_soviet_votes_dec;
    Q.sr_soviet = Q.sr_soviet_votes_dec;
    Q.b_soviet = Q.b_soviet_votes_dec;
    Q.anarchist_soviet = Q.anarchist_soviet_votes_dec;
    Q.other_soviet = Math.round(10*(Q.popular_socialist_soviet_votes_dec + Q.other_soviet_votes_dec + Q.k_soviet_votes_dec + Q.conservative_soviet_votes_dec))/10;
    if (Q.internationalist_split) {
        Q.internationalist_soviet = Q.internationalist_soviet_votes_dec;
    }
    if (Q.defensist_split) {
        Q.defensist_soviet = Q.defensist_soviet_votes_dec;
    }
    if (Q.left_sr_split) {
        Q.left_sr_soviet = Q.left_sr_soviet_votes_dec;
    }
    if (Q.right_sr_split) {
        Q.right_sr_soviet = Q.right_sr_soviet_votes_dec;
    }

    // decrement timers
    for (var timer of Q.timers) {
        if (Q[timer+'_timer'] && Q[timer+'_timer'] > 0) {
            Q[timer+'_timer'] -= 1;
        }
    }

    // military movement capacity
    Q.movement_capacity = Math.round(0.001*Q.military_trains*Q.train_capacity/100);
    Q.soldiers_moved = 0;

    // industrial changes
    Q.industrial_changes = 0;

    // industrial production ////////////////////////////////////////
    Q.military_production = Q.military_industry*Q.industry/100;
    Q.civilian_production = Q.civilian_industry*Q.industry/100;
    Q.agricultural_industry_production = Q.agricultural_industry*Q.industry/100;
    Q.transportation_production = Q.transportation_industry*Q.industry/100;
    Q.capital_production = Q.capital_industry*Q.industry/100;
    // military production -> supply quality (maybe this should be more sophisticated? nah)
    Q.supply_quality = Q.military_production/100;
    // agricultural industry effects on food acquisition
    if (Q.agricultural_industry_production >= 5) {
        Q.food_production *= 1.001;
        if (Q.food_production < 140000) {
            Q.food_production *= 1.005;
        }
        if (Q.agricultural_industry_production >= 10) {
            Q.food_production *= 1.002;
            if (Q.food_production < 155000) {
                Q.food_production *= 1.005;
            }
        }
        if (Q.food_sold < 0.07 + (Q.agricultural_industry_production - 3)/100 && Q.rural_hunger <= 0) {
            Q.food_sold += 0.002;
        }
    } else {
        if (Q.food_sold > 0.07 + (Q.agricultural_industry_production - 1)/100) {
            Q.food_sold -= 0.002;
        }
    }
    if (Q.rural_hunger > 0) {
        Q.food_sold -= 0.01;
        Q.rural_unrest += 1;
    }

    // civilian production effects on inflation and food_sold /////////
    if (Q.civilian_production >= 90) {
        if (Q.monthly_inflation >= 0.5) Q.monthly_inflation -= 0.1;
        if (Q.rural_hunger <= 0 && Q.food_sold <= 0.22) {
            Q.food_sold += 0.002;
        }
    }
    if (Q.civilian_production >= 80) {
        if (Q.monthly_inflation >= 1) Q.monthly_inflation -= 0.1;
        if (Q.rural_hunger <= 0 && Q.food_sold <= 0.2) {
            Q.food_sold += 0.002;
        }
    }
    if (Q.civilian_production >= 70) {
        if (Q.monthly_inflation >= 2) Q.monthly_inflation -= 0.1;
        if (Q.rural_hunger <= 0 && Q.food_sold <= 0.15) {
            Q.food_sold += 0.002;
        }
    }
    if (Q.civilian_production >= 60) {
        if (Q.monthly_inflation >= 3) Q.monthly_inflation -= 0.1;
        if (Q.rural_hunger <= 0 && Q.food_sold <= 0.1) {
            Q.food_sold += 0.001;
        }
    }
    if (Q.civilian_production >= 50) {
        if (Q.monthly_inflation >= 4.5) Q.monthly_inflation -= 0.1;
        if (Q.rural_hunger <= 0 && Q.food_sold <= 0.08) {
            Q.food_sold += 0.001;
        }
    }
    if (Q.civilian_production < 40 && Q.monthly_inflation <= 6.5) {
        Q.monthly_inflation += 0.1;
    }
    // capital production can either lower or raise total capacity
    if (Q.capital_production < 0.01*Q.industry) {
        Q.industry *= 0.995;
    }
    if (Q.capital_production > 0.05*Q.industry) {
        if (Q.industry < 100) {
            Q.industry *= 1.007;
        } else {
            Q.industry *= 1.001;
        }
    }
    // transport capacity can be expanded with transport industry (but degrades under some circumstances)
    if (Q.transportation_production < 1) {
        Q.train_capacity *= 0.995;
    }
    if (Q.transportation_production >= 5) {
        if (Q.train_capcity < 140000) {
            Q.train_capacity *= 1.005;
        } else {
            Q.train_capacity *= 1.001;
        }
    }



    // militia loyalties are affected by support... /////////
    if (Q.workers_m_normalized < Q.workers_militia_m_loyalty) {
        Q.workers_militia_m_loyalty -= 1;
    }
    if (Q.workers_b_normalized < Q.workers_militia_b_loyalty) {
        Q.workers_militia_b_loyalty -= 1;
    }
    if (Q.workers_sr_normalized < Q.workers_militia_sr_loyalty) {
        Q.workers_militia_sr_loyalty -= 1;
    }
    // War exhaustion changes - increase by 1 every week
    if (!Q.is_armistice && !Q.is_peace && !Q.allied_victory && Q.month >= 4) {
        Q.war_weariness += 1;
        Q.soldier_unrest += 0.2;
    }

    // Soldier unrest increases up to war weariness...
    if (Q.soldier_unrest < Q.war_weariness) {
        Q.soldier_unrest += 1;
    }
    if (Q.soldier_unrest < Q.war_weariness + 20) {
        Q.soldier_unrest += 1;
    }

    // Calculate strengths on each of the enemy fronts - just in case the enemy might want to attack!!!
    for (var ef of Q.enemy_fronts) {
        var attacking_soldiers = Q[ef + '_enemy_soldiers'];
        var attacking_morale = Q[ef + '_enemy_morale'];
        var attacking_discipline = Q[ef + '_enemy_discipline'];
        var attacking_supply = Q[ef + '_enemy_supply_quality'];
        Q[ef + '_attack_strength'] = attacking_soldiers*attacking_morale*attacking_discipline*Math.pow(attacking_supply, 1.5);
        console.log(Q[ef + '_attack_strength']);
    }
    for (var front of Q.fronts) {
        var defending_soldiers = Q[front + '_front_soldiers'];
        Q[front+'_defense_strength'] = defending_soldiers*Q.morale*Q.morale*Math.pow(Q.supply_quality, 1.5)*(1+Q.defense_bonus/2);
    }
    Q.northern_ratio = Q.northwestern_attack_strength/Q.northern_defense_strength;
    Q.western_ratio = Q.northwestern_attack_strength/Q.western_defense_strength;
    Q.southwestern_ratio = Q.southwestern_attack_strength/Q.southwestern_defense_strength;
    Q.romanian_ratio = Q.southwestern_attack_strength/Q.romanian_defense_strength;
    Q.caucasus_ratio = Q.caucasus_attack_strength/Q.caucasus_front_defense_strength;
    // find the highest ratio of attack power to defensive power
    Q.best_front = "northern";
    Q.best_enemy_front = "northwestern";
    Q.best_front_ratio = 0;
    for (var front of Q.fronts) {
        if (Q[front + "_ratio"] > Q.best_front_ratio) {
            Q.best_front = front;
            Q.best_enemy_front = Q.fronts_to_enemy[front];
            Q.best_front_ratio = Q[front + "_ratio"];
        }
    }
    console.log("best attacking front:", Q.best_front, Q.best_front_ratio);

} else if (Q.week_actions >= 0 && Q.current_player < Q.n_players) {
    // If there are more players...
    // production & support changes only happen after all players have gone
    Q.week_actions = 0;
    Q.current_player += 1;
    Q.player_party = Q['player'+current_player+'_party'];
    Q.player_party_name = Q.party_name_map[Q.player_party];
}



Q.has_event = 0;
// check if there are any cards in #event, and then go to main if not.
var scene = this.game.scenes['post_event.events_choice'];
var choices = this._compileChoices(scene);
if (choices && choices[0].title != "Continue...") {
    Q.has_event = 1;
} else {
    has_event = 0;
}

Q.war_progress = Q.northern_progress + Q.western_progress + Q.southwestern_progress + Q.romanian_progress + Q.caucasus_progress;

// update player details
if (Q.player_party == "m") {
    Q.player_in_exco = Q.m_in_exco;
    Q.player_in_gov = Q.m_in_gov;
    Q.player_in_soviet = Q.m_in_soviet;
} else if (Q.player_party == "b") {
    Q.player_in_exco = Q.b_in_exco;
    Q.player_in_gov = Q.b_in_gov;
    Q.player_in_soviet = Q.b_in_soviet;
} else if (Q.player_party == "sr") {
    Q.player_in_exco = Q.sr_in_exco;
    Q.player_in_gov = Q.sr_in_gov;
    Q.player_in_soviet = Q.sr_in_soviet;
} else if (Q.player_party == "k") {
    Q.player_in_exco = Q.k_in_exco;
    Q.player_in_gov = Q.k_in_gov;
    Q.player_in_soviet = Q.k_in_soviet;
}
!}
on-departure: {!
// TODO: set historical/international events
if (Q.month == 4 && Q.week == 1) {
    Q.historical_event = "Formation of the USPD - The venerable Social Democratic Party of Germany has split, with the anti-war grouping forming the Independent Social Democratic Party of Germany, or USPD. Some in this faction are urging revolutionary action to overthrow the Kaiser and end the war.";
} else if (Q.month == 4 && Q.week == 3) {
    Q.historical_event = "The Nivelle Offensive - French commander-in-chief Robert Nivelle has ordered a large-scale offensive against German lines in Belgium. The offensive has been a disaster for the Entente, and French troops are on the verge of mutiny.";
} else {
    Q.historical_event = 0;
}
!}
go-to: events_choice if has_event = 1; main if has_event = 0 and difficulty = 0; main.main_easy if has_event = 0 and difficulty < 0; main.main_hard if has_event = 0 and difficulty > 0

= Week [+ week +], [+ month : month +] [+ year +]

@events_choice

- #event

# go-to: main

# This scene is solely for updating numbers after events, and routing to special events.

# TODO: don't have to do event dispatch here - we can just have a tag with a maximum number
