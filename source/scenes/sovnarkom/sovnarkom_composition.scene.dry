<span style="color: var(--m-color); font-weight:bold;">Mensheviks</span>
</td>
<td style="text-align:center; padding:5px; border-bottom:1px solid rgba(128,128,128,0.25);">
[+ ((left_m_relation + centre_m_relation + right_m_relation)/3) : relationships +]
</td>
<td style="text-align:center; padding:5px; border-bottom:1px solid rgba(128,128,128,0.25);">
[+ menshevik_positions +]
</td>
</tr>
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px; border-bottom:1px solid rgba(128,128,128,0.25);">
<span style="color: var(--lsr-color); font-weight:bold;">Left-SRs</span>
</td>
<td style="text-align:center; padding:5px; border-bottom:1px solid rgba(128,128,128,0.25);">
[+ lsr_relation : relationships +]
</td>
<td style="text-align:center; padding:5px; border-bottom:1px solid rgba(128,128,128,0.25);">
[+ lsr_positions +]
</td>
</tr>
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px; border-bottom:1px solid rgba(128,128,128,0.25);">
<span style="color: var(--sr-color); font-weight:bold;">Socialist-Revolutionaries</span>
</td>
<td style="text-align:center; padding:5px; border-bottom:1px solid rgba(128,128,128,0.25);">
[+ ((centre_sr_relation + right_sr_relation)/2) : relationships +]
</td>
<td style="text-align:center; padding:5px; border-bottom:1px solid rgba(128,128,128,0.25);">
[+ sr_positions +]
</td>
</tr>
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px;">
<span style="color: var(--ns-color); font-weight:bold;">Popular Socialists</span>
</td>
<td style="text-align:center; padding:5px;">
[+ ns_relation : relationships +]
</td>
<td style="text-align:center; padding:5px;">
[+ ns_positions +]
</td>
</tr>
?]
</table>


- #sovnarkom_appointments
- @cancel_composition

@cancel_composition
title: Approve composition. 
choose-if: coalition_government = 0 or (coalition_government = 1 and coalition_positions >= coalition_positions_previous and menshevik_positions >= 1 and lsr_positions >= 1 and sr_positions >= 1 and ns_positions >= 1 and sdi_positions >= 1 and (coalition_positions < 9)) or (coalition_government = 2 and coalition_positions >= coalition_positions_previous and lsr_positions >= 1 and (coalition_positions < 9))
unavailable-subtitle: [?if coalition_government = 1 and coalition_positions < coalition_positions_previous : The other parties will not accept a reduction in positions. ?][?if coalition_government = 1 and lsr_positions < 1 : The Left-SRs expect a position. ?][?if coalition_government = 1 and sr_positions < 1 : The SRs expect a position. ?][?if coalition_government = 1 and ns_positions < 1 : The Popular Socialists expect a position. ?][?if coalition_government = 1 and sdi_positions < 1 : The SD-Internationalists expect a position. ?][?if coalition_government = 2 and coalition_positions < coalition_positions_previous : Coalition positions cannot be reduced. ?][?if coalition_government = 2 and (lsr_positions < 1 or (coalition_positions < coalition_positions_previous)) : The Left-SRs will not accept. ?][?if coalition_positions >= 9 : The Central Committee believes we have ceded too much. ?]

The composition is approved.

@terminate
title: On second thought, let's terminate the coalition agreement! 
go-to: coalition_affairs.cancel_coalition






@foreign
title: Foreign Affairs — [+ foreign_minister +] [?if foreign_minister_party=="Bolshevik" and foreign_minister != "None" and foreign_minister != "Vacant" : (<span class="tooltip-text" title="Russian Communist Party (Bolsheviks)" style="color: var(--bolshevik-color);">RCP(b)</span>)?][?if foreign_minister_party=="Menshevik": (<span class="tooltip-text" title="Menshevik" style="color: var(--m-color);">RSDLP</span>)?][?if foreign_minister_party=="Left-SR": (<span class="tooltip-text" title="Left-SR" style="color: var(--lsr-color);">Left-SR</span>)?][?if foreign_minister_party=="SR": (<span class="tooltip-text" title="Socialist Revolutionary" style="color: var(--sr-color);">SR</span>)?][?if foreign_minister_party=="SD-Int": (<span class="tooltip-text" title="Social-Democratic Internationalist" style="color: var(--sdi-color);">SD-Int</span>)?][?if foreign_minister_party=="NS": (<span class="tooltip-text" title="Popular Socialist" style="color: var(--ns-color);">NS</span>)?]
tags: sovnarkom_appointments
choose-if: foreign_minister_party == "Bolshevik" or foreign_minister_party == ""
unavailable-subtitle: We have a coalition agreement keeping this position fixed.

[?if foreign_minister != "Vacant" : Who should we replace [+ foreign_minister +] with? ?][?if foreign_minister == "Vacant" : Who should we appoint to the position? ?]

- #foreign_candidates
- @keep_foreign

@keep_foreign
title: Cancel action.
subtitle: [?if foreign_minister != "Vacant": Keep [+ foreign_minister +] in place. ?]
go-to: sovnarkom_composition


