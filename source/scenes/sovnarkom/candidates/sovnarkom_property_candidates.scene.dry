title: Properties Candidates
new-page: true


@property_karelin
title: Vladimir Karelin
subtitle: {!
<span style="color: var(--lsr-color);">Left-SR</span> — Leading SR organizer and former law student.<ul>
Overall skill: ★★★☆<br>
Suitability: ★★</ul>
!}
unavailable-subtitle: <span style="color: var(--lsr-color);">Left-SR</span> — Leading SR organizer and former law student.<ul>Overall skill: ★★★☆<br>Suitability: ★★</ul>[?if coalition_government = 0 : We haven't assented to Left-SR participation in government. ?]
tags: property_candidates
choose-if: property_minister != "Karelin" and coalition_government > 0
on-arrival: property_minister = "Karelin"; property_minister_party = "Left-SR";
go-to: sovnarkom_composition

