title: Trade
new-page: true
is-card: true
view-if: trade_policy_timer == 0 and trade_minister_party = "Bolshevik"
tags: sovnarkom, government
card-image: img/trade.PNG
on-arrival: {!
  Q.trade_policy_timer += 2; Q.week_actions += 1
  Q.ind_exports_display = Math.round(100 * Q.ind_exports)/100;
  Q.ind_imports_display = Math.round(100 * Q.ind_imports)/100;
  Q.trade_balance_display = Math.round(100 * Q.ind_trade_balance)/100;
  Q.customs_display = Math.round(100 * Q.customs)/100;
  Q.ind_access_display = Math.round(100 * Q.ind_access);
  Q.ind_freight_display = Math.round(1000 * Q.ind_freight)/10;
  Q.cooperative_subsidies = Math.round(10*Q.cooperative_subsidies)/10;
  Q.freight_investment = Math.round(10*Q.freight_investment)/10;
  Q.trade_expend = Math.round(100*Q.trade_expend)/100;
  Q.trade_gdp_display = Math.round(10 * Q.trade_gdp)/10;
  Q.trade_marketization_display = Math.round(Q.trade_marketization);
  for (var firm_size of ['large', 'medium', 'small']) {
      Q['ind_count_' + firm_size + '_display'] = Q['ind_count_' + firm_size].toLocaleString('en-US');
      for (var firm_control of ['private', 'coop', 'nationalized', 'syndicalized']) {
          Q['ind_count_' + firm_size + '_' + firm_control + '_display'] = Q['ind_count_' + firm_size + '_' + firm_control].toLocaleString('en-US');
      }
  }
  Q.ind_energy_display = Math.round(100 * Q.ind_energy_fill);
  Q.ind_wage_display = Math.round(100 * Q.ind.wage);
  Q.monthly_inflation_disp = Math.round(10 * Q.monthly_inflation)/10;
  for (var good of ['arms', 'consumer', 'agri', 'machinery', 'transport', 'timber', 'coal', 'oil', 'ore', 'materials']) {
      Q['ind_tariff_' + good] = Math.round(100 * Q['tariff_imp_' + good]);
      Q['ind_duty_' + good] = Math.round(100 * Q['tariff_exp_' + good]);
  }
!}

= Trade Policy

<table style="width:100%; table-layout:fixed; border-collapse:collapse;">
<tr>
<td style="width:50%; vertical-align:top; padding:0 5px 5px 5px;">
  <div style="border:3px solid #666; border-radius:6px; padding:0; margin-bottom:10px; font-size:0.85em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:5px 6px; margin-bottom:6px; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Foreign Trade
    </div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Imports</b><span style="float:right;"><span style="color: var(--level7-color);">-[+ ind_imports_display +]</span></span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Exports</b><span style="float:right;"><span style="color: var(--level1-color);">+[+ ind_exports_display +]</span></span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Trade Balance</b><span style="float:right;">[? if trade_balance_display >= 0 : <span style="color: var(--level1-color);">+[+ trade_balance_display +]</span> ?][? if trade_balance_display < 0 : <span style="color: var(--level7-color);">[+ trade_balance_display +]</span> ?]</span></div>
    <div style="border-top:2px solid #666; margin-top:3px; padding-top:3px;">
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Customs Revenue</b><span style="float:right;"><span style="color: var(--level1-color);">+[+ customs_display +]</span></span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Port and Border Access</b><span style="float:right;">[+ ind_access_display +]%</span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Freight Cost</b><span style="float:right;">[+ ind_freight_display +]%</span></div>
    </div>
  </div>
  <div style="border:3px solid #666; border-radius:6px; padding:0; margin-bottom:10px; font-size:0.85em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:5px 6px; margin-bottom:6px; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Domestic Market
    </div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Trade Output</b><span style="float:right;">[+ trade_gdp_display +]%</span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Consumer Goods Supply</b><span style="float:right;">[+ ind_supply_consumer +]%</span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Fuel Supply</b><span style="float:right;">[+ ind_energy_display +]%</span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Wage Level</b><span style="float:right;">[+ ind_wage_display +]%</span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Inflation</b><span style="float:right;">[+ monthly_inflation_disp +]%</span></div>
  </div>
  <div style="border:3px solid #666; border-radius:6px; padding:0; font-size:0.85em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:5px 6px; margin-bottom:6px; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Funding
    </div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Expenditure</b><span style="float:right;"><span style="color: var(--level7-color);">-[+ trade_expend +]</span></span></div>
    <div style="border-top:2px solid #666; margin-top:3px; padding-top:3px;">
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Cooperative Subsidies</b><span style="float:right;"><span style="color: var(--level7-color);">-[+ cooperative_subsidies +]</span></span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Freight and Port Investment</b><span style="float:right;"><span style="color: var(--level7-color);">-[+ freight_investment +]</span></span></div>
    </div>
  </div>
</td>
<td style="width:50%; vertical-align:top; padding:0 5px 5px 5px;">
  <div style="border:3px solid #666; border-radius:6px; padding:0; font-size:0.80em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:5px 6px; margin:0 0 6px 0; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Ownership of Industry
    </div>
    <div style="font-size:0.9em; margin:0; padding:0 8px;">
    <table style="width:100%; border-collapse:collapse; font-size:inherit;">
    <tr style="border-bottom:1px solid #666;"><th style="padding:3px 0; line-height:1.2; text-align:left;"></th><th colspan="2" style="padding:3px 0; line-height:1.2; white-space:nowrap; text-align:right;">Share of Output</th></tr>
    <tr><td style="padding:3px 0; line-height:1.2; white-space:nowrap;"><b>Large firms</b></td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;"><b>[+ ind_count_large_display +]</b></td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right; width:1%;"><b>([+ ind_share_large +]%)</b></td></tr>
    <tr style="background:rgba(215,205,180,0.12);"><td style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap;">– Nationalized</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_count_large_nationalized_display +]</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right; width:1%;">([+ ind_share_large_nationalized +]%)</td></tr>
    <tr><td style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap;">– Syndicalized</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_count_large_syndicalized_display +]</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right; width:1%;">([+ ind_share_large_syndicalized +]%)</td></tr>
    <tr style="background:rgba(215,205,180,0.12);"><td style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap;">– Cooperative</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_count_large_coop_display +]</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right; width:1%;">([+ ind_share_large_coop +]%)</td></tr>
    <tr><td style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap;">– Private</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_count_large_private_display +]</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right; width:1%;">([+ ind_share_large_private +]%)</td></tr>
    <tr style="border-top:1px solid #666;"><td style="padding:3px 0; line-height:1.2; white-space:nowrap;"><b>Medium firms</b></td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;"><b>[+ ind_count_medium_display +]</b></td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right; width:1%;"><b>([+ ind_share_medium +]%)</b></td></tr>
    <tr style="background:rgba(215,205,180,0.12);"><td style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap;">– Nationalized</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_count_medium_nationalized_display +]</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right; width:1%;">([+ ind_share_medium_nationalized +]%)</td></tr>
    <tr><td style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap;">– Syndicalized</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_count_medium_syndicalized_display +]</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right; width:1%;">([+ ind_share_medium_syndicalized +]%)</td></tr>
    <tr style="background:rgba(215,205,180,0.12);"><td style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap;">– Cooperative</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_count_medium_coop_display +]</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right; width:1%;">([+ ind_share_medium_coop +]%)</td></tr>
    <tr><td style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap;">– Private</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_count_medium_private_display +]</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right; width:1%;">([+ ind_share_medium_private +]%)</td></tr>
    <tr style="border-top:1px solid #666;"><td style="padding:3px 0; line-height:1.2; white-space:nowrap;"><b>Small firms</b></td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;"><b>[+ ind_count_small_display +]</b></td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right; width:1%;"><b>([+ ind_share_small +]%)</b></td></tr>
    <tr style="background:rgba(215,205,180,0.12);"><td style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap;">– Nationalized</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_count_small_nationalized_display +]</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right; width:1%;">([+ ind_share_small_nationalized +]%)</td></tr>
    <tr><td style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap;">– Syndicalized</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_count_small_syndicalized_display +]</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right; width:1%;">([+ ind_share_small_syndicalized +]%)</td></tr>
    <tr style="background:rgba(215,205,180,0.12);"><td style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap;">– Cooperative</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_count_small_coop_display +]</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right; width:1%;">([+ ind_share_small_coop +]%)</td></tr>
    <tr><td style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap;">– Private</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_count_small_private_display +]</td><td style="padding:3px 0 3px 4px; line-height:1.2; white-space:nowrap; text-align:right; width:1%;">([+ ind_share_small_private +]%)</td></tr>
    </table>
    </div>
  </div>
</td>
</tr>
<tr>
<td colspan="2" style="vertical-align:top; padding:5px 5px 5px 5px;">
  <div style="border:3px solid #666; border-radius:6px; padding:0; font-size:0.85em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:5px 6px; margin-bottom:6px; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Goods and Tariffs
    </div>
    <table style="width:100%; border-collapse:collapse; font-size:0.9em;">
    <tr style="border-bottom:1px solid #666;"><th style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:left;">Good</th><th style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;"><span title="Price level compared with 1913, where 1913 = 100" style="cursor:help; border-bottom:1px dotted #666;">Price</span></th><th style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">Output</th><th style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">Supply</th><th style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">Imports</th><th style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">Exports</th><th style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;"><span title="Import tariff: a tax on goods brought into the country, as a percentage of their value" style="cursor:help; border-bottom:1px dotted #666;">Tariff</span></th><th style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;"><span title="Export duty: a tax on goods sold abroad, as a percentage of their value" style="cursor:help; border-bottom:1px dotted #666;">Duty</span></th></tr>
    <tr><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:left;"><b>Military Equipment</b></td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_price1913_arms +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_out_arms +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_supply_arms +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_imp_arms +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_exp_arms +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_tariff_arms +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_duty_arms +]%</td></tr>
    <tr style="background:rgba(215,205,180,0.12);"><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:left;"><b>Consumer Goods</b></td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_price1913_consumer +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_out_consumer +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_supply_consumer +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_imp_consumer +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_exp_consumer +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_tariff_consumer +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_duty_consumer +]%</td></tr>
    <tr><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:left;"><b>Farm Supplies</b></td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_price1913_agri +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_out_agri +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_supply_agri +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_imp_agri +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_exp_agri +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_tariff_agri +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_duty_agri +]%</td></tr>
    <tr style="background:rgba(215,205,180,0.12);"><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:left;"><b>Machinery</b></td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_price1913_machinery +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_out_machinery +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_supply_machinery +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_imp_machinery +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_exp_machinery +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_tariff_machinery +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_duty_machinery +]%</td></tr>
    <tr><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:left;"><b>Rolling Stock</b></td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_price1913_transport +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_out_transport +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_supply_transport +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_imp_transport +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_exp_transport +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_tariff_transport +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_duty_transport +]%</td></tr>
    <tr style="background:rgba(215,205,180,0.12);"><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:left;"><b>Timber</b></td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_price1913_timber +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_out_timber +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_supply_timber +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_imp_timber +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_exp_timber +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_tariff_timber +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_duty_timber +]%</td></tr>
    <tr><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:left;"><b>Coal</b></td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_price1913_coal +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_out_coal +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_supply_coal +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_imp_coal +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_exp_coal +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_tariff_coal +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_duty_coal +]%</td></tr>
    <tr style="background:rgba(215,205,180,0.12);"><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:left;"><b>Oil</b></td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_price1913_oil +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_out_oil +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_supply_oil +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_imp_oil +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_exp_oil +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_tariff_oil +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_duty_oil +]%</td></tr>
    <tr><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:left;"><b>Ore</b></td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_price1913_ore +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_out_ore +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_supply_ore +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_imp_ore +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_exp_ore +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_tariff_ore +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_duty_ore +]%</td></tr>
    <tr style="background:rgba(215,205,180,0.12);"><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:left;"><b>Raw Materials</b></td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_price1913_materials +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_out_materials +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_supply_materials +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_imp_materials +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_exp_materials +]</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_tariff_materials +]%</td><td style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ind_duty_materials +]%</td></tr>
    </table>
  </div>
</td>
</tr>
</table>


