@trade_null
title: -------------------------------------------------------------------------------------------------
go-to: trade

@trade_return
title: Cancel action
go-to: trade


@administration
title: ADMINISTRATION
new-page: true

= Administration

<table style="width:100%; border-collapse:collapse; margin:10px 0;">
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px; border-bottom:1px solid rgba(128,128,128,0.25);">
<span style="color: var(--bolshevik-color); font-weight:bold;">Spending</span>
</td>
<td style="text-align:center; padding:5px; border-bottom:1px solid rgba(128,128,128,0.25);">
[+ trade_expend +]
</td>
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px; border-bottom:1px solid rgba(128,128,128,0.25);">
<span style="color: var(--bolshevik-color); font-weight:bold;">Efficacy</span>
</td>
<td style="text-align:center; padding:5px; border-bottom:1px solid rgba(128,128,128,0.25);">
[+ efficacy_trade : efficacy +]
</td>
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px; border-bottom:1px solid rgba(128,128,128,0.25);">
<span style="color: var(--bolshevik-color); font-weight:bold;">Corruption</span>
</td>
<td style="text-align:center; padding:5px; border-bottom:1px solid rgba(128,128,128,0.25);">
[+ trade_corruption : corruption +]
</td>
</table>


- @improve_admin
- @hire_staff
- @corruption
- @trade_return

@improve_admin
title: Streamline the commissariat
subtitle: Cut waste and inefficiencies, increase labor intensity
choose-if: trade_streamline_timer = 0
unavailable-subtitle: There's nothing more to cut at the moment. 
on-arrival: trade_expend -= 0.25; efficacy_trade += 0.1 if efficacy_trade < 1; trade_streamline_timer += 8; 

@hire_staff
title: Hire administrative personnel
subtitle: -0.5 resources
choose-if: resources >= 0.5
unavailable-subtitle: -0.5 resources – We lack the resources. 
on-arrival: efficacy_trade += 0.2 if efficacy_trade < 1; trade_expend += 0.25; resources -= 0.5;

@corruption
title: Root-out departmental corruption. 
subtitle: -0.5 resources
choose-if: trade_corruption_timer = 0 and resources >= 0.5
unavailable-subtitle: -0.5 resources – [?if resources < 0.5 : We lack the resources. ?][?if trade_corruption_timer != 0 : We've already initiated an anti-corruption campaign. ?]
on-arrival: {!
  Q.resources -= 0.5; Q.trade_corruption_timer = 8;
  Q.efficacy_trade = Math.min(1, Q.efficacy_trade + 0.1);
  Q.trade_corruption = Math.max(0, Q.trade_corruption - (0.2 * Q.efficacy_trade)); 
!}



@funding
title: FUNDING
new-page: true
on-arrival: {!
	Q.cooperative_subsidies = Math.round(10*Q.cooperative_subsidies)/10;
	Q.freight_investment = Math.round(10*Q.freight_investment)/10;
	Q.trade_expend = Math.round(100*Q.trade_expend)/100;
!}

= Trade Policy

<table style="width:100%; border-collapse:collapse; margin:10px 0;">
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px; border-bottom:1px solid rgba(128,128,128,0.25);">
	<span style="color: var(--bolshevik-color); font-weight:bold;">Cooperative Subsidies</span>
	</td>
    <td style="text-align:center; padding:5px; border-bottom:1px solid rgba(128,128,128,0.25);">
        [+ cooperative_subsidies +]
    </td>
</tr>
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px; border-bottom:2px solid rgba(128,128,128,0.6);">
	<span style="color: var(--bolshevik-color); font-weight:bold;">Freight & Port Investment</span>
	</td>
    <td style="text-align:center; padding:5px; border-bottom:2px solid rgba(128,128,128,0.6);">
        [+ freight_investment +]
    </td>
</tr>
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px;">
<span style="color: var(--bolshevik-color); font-weight:bold;">Total Spending</span>
</td>
<td style="text-align:center; padding:5px;">
[+ trade_expend +]
</td>
</tr>
</table>

- #trade_funding
- @trade_return


@increase_cooperative_subsidies
title: Increase subsidies to cooperatives and artels.
tags: trade_funding
go-to: funding
choose-if: cooperative_subsidies < 2
unavailable-subtitle: Funding is already maxed. 
on-arrival: {!
  Q.cooperative_subsidies += 0.1;
  Q.trade_expend += 0.1;
!}

@decrease_cooperative_subsidies
title: Decrease subsidies to cooperatives and artels.
choose-if: cooperative_subsidies > 0
unavailable-subtitle: Funding is already non-existent. 
tags: trade_funding
go-to: funding
on-arrival: {!
  Q.cooperative_subsidies -= 0.1;
  Q.trade_expend -= 0.1;
!}

@increase_freight_investment
title: Increase investment in freight and port facilities.
tags: trade_funding
go-to: funding
choose-if: freight_investment < 2
unavailable-subtitle: Funding is already maxed. 
on-arrival: {!
  Q.freight_investment += 0.1;
  Q.trade_expend += 0.1;
!}

@decrease_freight_investment
title: Decrease investment in freight and port facilities.
choose-if: freight_investment > 0
unavailable-subtitle: Funding is already non-existent. 
tags: trade_funding
go-to: funding
on-arrival: {!
  Q.freight_investment -= 0.1;
  Q.trade_expend -= 0.1;
!}



@tariffs
title: TARIFFS
new-page: true
on-arrival: {!
  Q.customs_estimate = 0;
  for (var good of ['arms', 'consumer', 'agri', 'machinery', 'transport', 'timber', 'coal', 'oil', 'ore', 'materials']) {
      Q['tariff_imp_' + good] = Math.round(100 * Q['tariff_imp_' + good])/100;
      Q['tariff_exp_' + good] = Math.round(100 * Q['tariff_exp_' + good])/100;
      Q['ind_tariff_' + good] = Math.round(100 * Q['tariff_imp_' + good]);
      Q['ind_duty_' + good] = Math.round(100 * Q['tariff_exp_' + good]);
      var estimate = Q['ind_imp_value_' + good] * Q['tariff_imp_' + good] + Q['ind_exp_value_' + good] * Q['tariff_exp_' + good];
      Q['ind_customs_' + good] = Math.round(100 * estimate)/100;
      Q.customs_estimate += estimate;
  }
  Q.customs_estimate = Math.round(100 * Q.customs_estimate)/100;
!}

