@import_tariffs_header
title: Import tariffs
go-to: tariffs

@increase_all_tariffs
title: – Increase across the board.
go-to: tariffs
on-arrival: {!
  for (var good of ['arms', 'consumer', 'agri', 'machinery', 'transport', 'timber', 'coal', 'oil', 'ore', 'materials']) {
      Q['tariff_imp_' + good] = Math.min(1, Q['tariff_imp_' + good] + 0.05);
  }
!}

@decrease_all_tariffs
title: – Decrease across the board.
go-to: tariffs
on-arrival: {!
  for (var good of ['arms', 'consumer', 'agri', 'machinery', 'transport', 'timber', 'coal', 'oil', 'ore', 'materials']) {
      Q['tariff_imp_' + good] = Math.max(0, Q['tariff_imp_' + good] - 0.05);
  }
!}

@increase_tariff_arms
title: – Increase on military equipment.
go-to: tariffs
choose-if: tariff_imp_arms < 0.99
unavailable-subtitle: The tariff is already at the maximum.
on-arrival: tariff_imp_arms += 0.05;

@decrease_tariff_arms
title: – Decrease on military equipment.
go-to: tariffs
choose-if: tariff_imp_arms > 0.01
unavailable-subtitle: The tariff is already at zero.
