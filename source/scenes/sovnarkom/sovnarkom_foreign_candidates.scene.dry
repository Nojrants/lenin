title: Foreign Candidates
new-page: true

@foreign_trotsky
title: Leon Trotsky
subtitle: {!
<span style="color: var(--b-color);">Left</span> — Internationally-reknown and experienced organizer.<br>
Overall skill: ★★★★★<br>
Suitability: ★★★☆
!}
unavailable-subtitle: {!
Internationally-reknown and experienced organizer.<br>
Overall skill: ★★★★★<br>
Suitability: ★★★☆
!}
tags: foreign_candidates
choose-if: foreign_minister != "Trotsky" 
on-arrival: foreign_minister = "Trotsky"; foreign_minister_party = "Bolshevik";
go-to: sovnarkom_composition

@foreign_chicherin
title: Georgy Chicherin
subtitle: {!
<span style="color: var(--b-color);">Non-Factional</span> — Highly qualified diplomat, polyglot, and negotiator.<br>
Overall skill: ★★★★★<br>
Suitability: ★★★★★
!}
tags: foreign_candidates 
choose-if: foreign_minister != "Chicherin" and chicherin_available = 1
unavailable-subtitle: [?if chicherin_available != 1 and chicherin_negotiation != 1 : Chicherin is currently imprisoned by the British.<br> ?][?if chicherin_available != 1 and chicherin_negotiation = 1 : Chicherin is currently in transit back to Russia.<br> ?] Highly qualified diplomat, polyglot, and negotiator.<br>Overall skill: ★★★★★<br>Suitability: ★★★★★
on-arrival: foreign_minister = "Chicherin"; foreign_minister_party = "Bolshevik";
go-to: sovnarkom_composition

