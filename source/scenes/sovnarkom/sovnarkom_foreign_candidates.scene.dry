@foreign_martov
title: Iulius Martov
subtitle: {!
<span style="color: var(--m-color);">Menshevik Int.</span> — RSDLP founding member and reknown Menshevik leader. 
Overall skill: ★★★★★<br>
Suitability: ★★★★
!}
tags: foreign_candidates 
choose-if: foreign_minister != "Martov" and left_m_relation > 60 and m_in_gov = 1 and coalition_government = 1
unavailable-subtitle: <span style="color: var(--m-color);">Menshevik Int.</span> — RSDLP founding member and reknown Menshevik leader.<br>[?if m_in_gov != 1: We haven't assented to Menshevik participation in government. ?]<br>[?if left_m_relation <= 60: Martov would not accept this. ?]
on-arrival: foreign_minister = "Martov"; foreign_minister_party = "Menshevik"; left_m_relation += 10
go-to: sovnarkom_composition


@foreign_vacant
title: Let's leave the position vacant for now. 
tags: foreign_candidates
on-arrival: foreign_minister = "Vacant"; foreign_minister_party = "";
