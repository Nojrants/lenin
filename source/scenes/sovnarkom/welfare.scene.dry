@found_worker_insurance
title: Found a system of mandatory worker insurance.
subtitle: Sick pay and disability - financed through employer and state contributions. 
choose-if: worker_insurance_founded = 0 and efficacy_welfare > 0.3
view-if: worker_insurance_founded = 0
unavailable-subtitle: We lack the administrative capabilities. 
on-arrival: {!
  Q.worker_insurance_founded = 1;
  Q.worker_insurance_funding = 0.2; Q.welfare_expend += 0.2;
  Q.workers_unrest -= 10;
!}

@found_unemployment
title: Found an assistance program for the unemployed. 
subtitle: -0.5 resources - Cash assistance for the unemployed.
choose-if: unemployment_founded = 0 and resources >= 0.5 and efficacy_welfare > 0.5
view-if: unemployment_founded = 0
unavailable-subtitle: -0.5 resources – [?if resources < 0.5 : We lack the resources. ?][?if efficacy_welfare <= 0.5 : We lack the administrative capacities to implement this. ?]
on-arrival: {!
  Q.unemployment_founded = 1;
  Q.resources -= 0.5;
  Q.unemployment_funding = 0.5; Q.welfare_expend += 0.5;
  Q.workers_unrest -= 10; Q.underclass_unrest -= 10;
!}

@found_war_invalids
title: Found an assistance program for war invalids.   
subtitle: -0.5 resources - Cash assistance for those wounded or disabled from war. 
choose-if: invalids_founded = 0 and resources >= 0.5 and efficacy_welfare > 0.7
view-if: invalids_founded = 0
unavailable-subtitle: -0.5 resources – [?if resources < 0.5 : We lack the resources. ?][?if efficacy_welfare <= 0.7 : We lack the administrative capacities to implement this. ?]
on-arrival: {!
  Q.invalids_founded = 1;
  Q.resources -= 0.5;
  Q.invalids_funding = 0.5; Q.welfare_expend += 0.5;
  Q.workers_unrest -= 5; Q.underclass_unrest -= 5; Q.soldiers_unrest -= 15;
!}

@found_elderly
title: Found a system of pensions for the elderly 
subtitle: -0.5 resources - Focusing on retired workers, veterans, and dependents. 
choose-if: elderly_founded = 0 and resources >= 0.5 and efficacy_welfare > 0.7
view-if: elderly_founded = 0
unavailable-subtitle: -0.5 resources – [?if resources < 0.5 : We lack the resources. ?][?if efficacy_welfare <= 0.7 : We lack the administrative capacities to implement this. ?]
on-arrival: {!
  Q.elderly_founded = 1;
  Q.resources -= 0.5;
  Q.elderly_funding = 0.5; Q.welfare_expend += 0.5;
  Q.workers_unrest -= 5; Q.underclass_unrest -= 5; Q.soldiers_unrest -= 5; Q.middle_unrest -= 5; Q.intelligentsia_unrest -= 5;
!}

@found_maternity
title: Declare a series of new maternity benefits. 
subtitle: Paid maternity leave, job protection, and expanded medical support.
choose-if: maternity_founded = 0
view-if: maternity_founded = 0
on-arrival: {!
  Q.maternity_founded = 1;
  Q.maternity_funding = 0.2; Q.welfare_expend += 0.2;
  Q.workers_unrest -= 5; Q.underclass_unrest -= 5; Q.intelligentsia_unrest -= 5;
!}

@found_widows
title: Found an assistance program for widows and orphans. 
subtitle: -1 resources - Pensions and food assistance. 
choose-if: widows_founded = 0 and resources >= 0.5 and efficacy_welfare > 0.7 
view-if: widows_founded = 0
unavailable-subtitle: -0.5 resources – [?if resources < 0.5 : We lack the resources. ?][?if efficacy_welfare <= 0.7 : We lack the administrative capacities to implement this. ?]
on-arrival: {!
  Q.widows_founded = 1;
  Q.resources -= 0.5;
  Q.widows_funding = 0.5; Q.welfare_expend += 0.5;
  Q.workers_unrest -= 5; Q.underclass_unrest -= 5; Q.intelligentsia_unrest -= 5;
!}

@found_nurseries
title: Found a system of nurseries and childcare facilities. 
subtitle: -1 resources 
choose-if: nurseries_founded = 0 and resources >= 1 and efficacy_welfare > 0.9
view-if: nurseries_founded = 0
unavailable-subtitle: -1 resources – [?if resources < 1 : We lack the resources. ?][?if efficacy_welfare <= 0.9 : We lack the administrative capacities to implement this. ?]
on-arrival: {!
  Q.nurseries_founded = 1;
  Q.resources -= 1;
  Q.nurseries_funding = 0.5; Q.welfare_expend += 0.5;
  Q.workers_unrest -= 10; Q.underclass_unrest -= 5; Q.intelligentsia_unrest -= 5; Q.middle_unrest -= 5;
!}
