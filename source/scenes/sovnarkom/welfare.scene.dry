title: Welfare
new-page: true
is-card: true
view-if: social_policy_timer == 0 and welfare_minister_party = "Bolshevik"
tags: sovnarkom, government
card-image: img/women_poster.PNG
on-arrival: {!
  Q.social_policy_timer += 2; Q.week_actions += 1
  Q.welfare_founded = 1;
!}


= Welfare 

- @administration
- @funding
- @welfare_null
- @found_worker_insurance
- @found_unemployment
- @found_war_invalids
- @found_elderly
- @found_maternity
- @found_widows
- @found_nurseries 
- @root: Do not change welfare
- @easy_discard
- @cancel_advisor_action


@welfare_null
title: -------------------------------------------------------------------------------------------------
go-to: welfare

@welfare_return
title: Cancel action
go-to: welfare

  


@administration
title: ADMINISTRATION
new-page: true

= Administration

<table style="width:100%; border-collapse:collapse; margin:10px 0;">
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px; border-bottom:1px solid rgba(128,128,128,0.25);">
<span style="color: var(--bolshevik-color); font-weight:bold;">Spending</span>
</td>
<td style="text-align:center; padding:5px; border-bottom:1px solid rgba(128,128,128,0.25);">
[+ welfare_expend +]
</td>
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px; border-bottom:1px solid rgba(128,128,128,0.25);">
<span style="color: var(--bolshevik-color); font-weight:bold;">Efficacy</span>
</td>
<td style="text-align:center; padding:5px; border-bottom:1px solid rgba(128,128,128,0.25);">
[+ efficacy_welfare : efficacy +]
</td>
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px; border-bottom:1px solid rgba(128,128,128,0.25);">
<span style="color: var(--bolshevik-color); font-weight:bold;">Corruption</span>
</td>
<td style="text-align:center; padding:5px; border-bottom:1px solid rgba(128,128,128,0.25);">
[+ welfare_corruption : corruption +]
</td>
</table>


- @improve_admin
- @hire_staff
- @corruption
- @welfare_return

@improve_admin
title: Streamline the commissariat
subtitle: Cut waste and inefficiencies, increase labor intensity
choose-if: welfare_streamline_timer = 0
unavailable-subtitle: There's nothing more to cut at the moment. 
on-arrival: welfare_expend -= 0.25; efficacy_welfare += 0.1 if efficacy_welfare < 1; welfare_streamline_timer += 8; 

@hire_staff
title: Hire administrative personnel
subtitle: -0.25 resources
choose-if: resources >= 0.25
unavailable-subtitle: -0.25 resources – We lack the resources. 
on-arrival: efficacy_welfare += 0.2 if efficacy_welfare < 1; welfare_expend += 0.125; resources -= 0.25;

@corruption
title: Root-out departmental corruption. 
subtitle: -0.25 resources
choose-if: welfare_corruption_timer = 0 and resources >= 0.25
unavailable-subtitle: -0.25 resources – [?if resources < 0.25 : We lack the resources. ?][?if welfare_corruption_timer != 0 : We've already initiated an anti-corruption campaign. ?]
on-arrival: {!
  Q.resources -= 0.25; Q.welfare_corruption_timer = 8;
  Q.efficacy_welfare = Math.min(1, Q.efficacy_welfare + 0.1);
  Q.welfare_corruption = Math.max(0, Q.welfare_corruption - (0.2 * Q.efficacy_welfare)); 
!}



@funding
title: FUNDING
new-page: true
on-arrival: {!
  Q.worker_insurance_funding = Math.round(10*(Q.worker_insurance_funding || 0))/10;
  Q.unemployment_funding = Math.round(10*(Q.unemployment_funding || 0))/10;
  Q.invalids_funding = Math.round(10*(Q.invalids_funding || 0))/10;
  Q.elderly_funding = Math.round(10*(Q.elderly_funding || 0))/10;
  Q.maternity_funding = Math.round(10*(Q.maternity_funding || 0))/10;
  Q.widows_funding = Math.round(10*(Q.widows_funding || 0))/10;
  Q.nurseries_funding = Math.round(10*(Q.nurseries_funding || 0))/10;
  Q.welfare_expend = Math.round(100*Q.welfare_expend)/100;
!}

