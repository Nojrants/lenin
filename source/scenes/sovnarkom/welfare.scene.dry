- #welfare_funding
- @welfare_return


@increase_worker_insurance_funding
title: Increase funding for worker insurance.
tags: welfare_funding
go-to: funding
view-if: worker_insurance_founded = 1
choose-if: worker_insurance_funding < 2
unavailable-subtitle: Funding is already maxed. 
on-arrival: {!
  Q.worker_insurance_funding += 0.1;
  Q.welfare_expend += 0.1;
!}

@decrease_worker_insurance_funding
title: Decrease funding for worker insurance.
tags: welfare_funding
go-to: funding
view-if: worker_insurance_founded = 1
choose-if: worker_insurance_funding > 0
unavailable-subtitle: Funding is already non-existent. 
on-arrival: {!
  Q.worker_insurance_funding -= 0.1;
  Q.welfare_expend -= 0.1;
!}

