[? if business_tax_trend = 1 : <span style="color: var(--level1-color);">&#9650;</span> ?][? if business_tax_trend = -1 : <span style="color: var(--level7-color);">&#9660;</span> ?][? if business_tax_trend = 0 : <span style="color: #5aa9e6;">&#9644;</span> ?] [+ business_tax_efficacy_display +]%
</td>
</tr>
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px; border-bottom:1px solid rgba(128,128,128,0.25);">
<span style="color: var(--bolshevik-color); font-weight:bold;">Withholding at Source</span>
</td>
<td style="text-align:right; padding:5px; border-bottom:1px solid rgba(128,128,128,0.25);">
[? if tax_withholding = 1 : In force ?][? if tax_withholding != 1 : None ?]
</td>
</tr>
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px; border-bottom:1px solid rgba(128,128,128,0.25);">
