@income_tax_header
title: Income tax
go-to: taxation

@increase_bracket1
title: – Increase bracket one.
go-to: taxation
choose-if: income_tax_rate_1 < 5
unavailable-subtitle: The tax rate is already at the maximum.
on-arrival: income_tax_rate_1 += 0.25; capital_flight_progress += 0.25; elites_unrest += 2.5; middle_unrest += 2.5; monthly_inflation -= 0.05;

@decrease_bracket1
title: – Decrease bracket one.
go-to: taxation
choose-if: income_tax_rate_1 >= 0.25
unavailable-subtitle: The tax rate is already at zero.
on-arrival: income_tax_rate_1 -= 0.25; capital_flight_progress -= 0.25; elites_unrest -= 2.5; middle_unrest -= 2.5; monthly_inflation += 0.05;

@increase_bracket2
title: – Increase bracket two.
go-to: taxation
choose-if: income_tax_rate_2 < 5
unavailable-subtitle: The tax rate is already at the maximum.
on-arrival: income_tax_rate_2 += 0.25; capital_flight_progress += 0.25; elites_unrest += 2.5; middle_unrest += 2.5; monthly_inflation -= 0.05;

@decrease_bracket2
title: – Decrease bracket two.
go-to: taxation
choose-if: income_tax_rate_2 >= 0.25
unavailable-subtitle: The tax rate is already at zero.
on-arrival: income_tax_rate_2 -= 0.25; capital_flight_progress -= 0.25; elites_unrest -= 2.5; middle_unrest -= 2.5; monthly_inflation += 0.05;

@increase_bracket3
title: – Increase bracket three.
go-to: taxation
choose-if: income_tax_rate_3 < 5
unavailable-subtitle: The tax rate is already at the maximum.
on-arrival: income_tax_rate_3 += 0.25; capital_flight_progress += 0.25; middle_unrest += 2.5; kulaks_unrest += 1; monthly_inflation -= 0.05;

@decrease_bracket3
title: – Decrease bracket three.
go-to: taxation
choose-if: income_tax_rate_3 >= 0.25
unavailable-subtitle: The tax rate is already at zero.
on-arrival: income_tax_rate_3 -= 0.25; capital_flight_progress -= 0.25; middle_unrest -= 2.5; kulaks_unrest -= 1; monthly_inflation += 0.05;

@increase_bracket4
title: – Increase bracket four.
go-to: taxation
choose-if: income_tax_rate_4 < 5
unavailable-subtitle: The tax rate is already at the maximum.
on-arrival: income_tax_rate_4 += 0.25; middle_unrest += 2.5; workers_unrest += 10; monthly_inflation -= 0.05;

@decrease_bracket4
title: – Decrease bracket four.
go-to: taxation
choose-if: income_tax_rate_4 >= 0.25
unavailable-subtitle: The tax rate is already at zero.
on-arrival: income_tax_rate_4 -= 0.25; middle_unrest -= 2.5; workers_unrest -= 10; monthly_inflation += 0.05;

@increase_bracket5
title: – Increase bracket five.
go-to: taxation
choose-if: income_tax_rate_5 < 5
unavailable-subtitle: The tax rate is already at the maximum.
on-arrival: income_tax_rate_5 += 0.25; workers_unrest += 5; peasants_unrest += 5; monthly_inflation -= 0.05;

@decrease_bracket5
title: – Decrease bracket five.
go-to: taxation
choose-if: income_tax_rate_5 >= 0.25
unavailable-subtitle: The tax rate is already at zero.
on-arrival: income_tax_rate_5 -= 0.25; workers_unrest -= 5; peasants_unrest -= 5; monthly_inflation += 0.05;

@increase_property_tax
title: Increase the property tax.
go-to: taxation
on-arrival: wealth_tax_rate += 0.5; capital_flight_progress += 0.5; capital_flight_progress += 1 if wealth_tax_rate >= 2; elites_unrest += 10; middle_unrest += 5; workers_unrest -= 5; monthly_inflation -= 0.2;

@decrease_property_tax
title: Decrease the property tax.
go-to: taxation
choose-if: wealth_tax_rate >= 0.5
unavailable-subtitle: The tax rate is already at zero.
on-arrival: wealth_tax_rate -= 0.5; capital_flight_progress -= 0.5; elites_unrest -= 10; middle_unrest -= 5; workers_unrest += 5; monthly_inflation += 0.2;

@increase_business_tax
title: Increase the business tax.
go-to: taxation
on-arrival: business_tax_rate += 0.5; capital_flight_progress += 0.5; capital_flight_progress += 1 if business_tax_rate >= 2; elites_unrest += (10 * (trade_marketization/100)); middle_unrest += (10 * (trade_marketization/100)); workers_unrest -= 5; monthly_inflation -= 0.2;

@decrease_business_tax
title: Decrease the business tax.
go-to: taxation
choose-if: business_tax_rate >= 0.5
unavailable-subtitle: The tax rate is already at zero.
on-arrival: business_tax_rate -= 0.5; capital_flight_progress -= 0.5; elites_unrest -= (10 * (trade_marketization/100)); middle_unrest -= (10 * (trade_marketization/100)); workers_unrest += 5; monthly_inflation += 0.2;

@increase_syndicate_levy
title: Increase the levy on syndicalized enterprises.
go-to: taxation
choose-if: syndicate_levy_rate < 50
unavailable-subtitle: The levy is already at the maximum.
on-arrival: syndicate_levy_rate += 5; workers_unrest += (7.5 * (industries_syndicalized/100)); monthly_inflation -= 0.05;

@decrease_syndicate_levy
title: Decrease the levy on syndicalized enterprises.
go-to: taxation
choose-if: syndicate_levy_rate >= 5
unavailable-subtitle: The levy is already at zero.
on-arrival: syndicate_levy_rate -= 5; workers_unrest -= (7.5 * (industries_syndicalized/100)); monthly_inflation += 0.05;




@banking
title: BANKING

- @finance_issue_currency
- @finance_bank_advances
- @finance_issue_bonds
- @pay_off_loans
- @finance_return

@finance_issue_currency
title: Issue additional currency. 
choose-if: banks_seized = 1
unavailable-subtitle: We lack control over the banks. 
subtitle: +5 resources
on-arrival: {!
    Q.resources += 5;
    Q.monthly_inflation += (1.2 * (Q.instability/12.5));
    Q.instability += 1;
!}

@finance_bank_advances
title: Borrow from the State Bank.
choose-if: banks_seized = 1
unavailable-subtitle: We lack control over the banks. 
subtitle: +5 resources
on-arrival: {!
    Q.resources += 5;
    Q.bank_advances += 5; 
    Q.monthly_inflation += (1.2 * (Q.instability/25));
    Q.instability += 0.25;
!}

@finance_issue_bonds
title: Issue government bonds.
subtitle: +5 resources
on-arrival: bonds += 5; resources += 5; instability += 0.5; monthly_inflation += (1.1 * (instability/50)); bond_rate += 1 if bonds > 90; bond_rate += 0.5 if ((bonds < 90) and (bonds > 60)); bond_rate += 0.25 if bonds < 60; 

@pay_off_loans
title: Repay our outstanding loans.
choose-if: loans >= 1
unavailable-subtitle: We have no loans to repay.




@administration
title: ADMINISTRATION
new-page: true

= Administration

<table style="width:100%; border-collapse:collapse; margin:10px 0;">
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px; border-bottom:1px solid rgba(128,128,128,0.25);">
<span style="color: var(--bolshevik-color); font-weight:bold;">Spending</span>
</td>
<td style="text-align:center; padding:5px; border-bottom:1px solid rgba(128,128,128,0.25);">
[+ finance_expend +]
</td>
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px; border-bottom:1px solid rgba(128,128,128,0.25);">
<span style="color: var(--bolshevik-color); font-weight:bold;">Efficacy</span>
</td>
<td style="text-align:center; padding:5px; border-bottom:1px solid rgba(128,128,128,0.25);">
[+ efficacy_finance : efficacy +]
</td>
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px; border-bottom:1px solid rgba(128,128,128,0.25);">
<span style="color: var(--bolshevik-color); font-weight:bold;">Corruption</span>
</td>
<td style="text-align:center; padding:5px; border-bottom:1px solid rgba(128,128,128,0.25);">
[+ finance_corruption : corruption +]
</td>
</table>


- @improve_admin
- @hire_staff
- @corruption
- @finance_return

@improve_admin
title: Streamline the commissariat
subtitle: Cut waste and inefficiencies, increase labor intensity
choose-if: finance_streamline_timer = 0
unavailable-subtitle: There's nothing more to cut at the moment. 
on-arrival: finance_expend -= 0.25; efficacy_finance += 0.1 if efficacy_finance < 1; finance_streamline_timer += 8; 

@hire_staff
title: Hire administrative personnel
subtitle: -0.25 resources
choose-if: resources >= 0.25
unavailable-subtitle: -0.25 resources – We lack the resources. 
on-arrival: efficacy_finance += 0.2 if efficacy_finance < 1; finance_expend += 0.125; resources -= 0.25;

@corruption
title: Root-out departmental corruption. 
subtitle: -0.25 resources
choose-if: finance_corruption_timer = 0 and resources >= 0.25
unavailable-subtitle: -0.25 resources – [?if resources < 0.25 : We lack the resources. ?][?if finance_corruption_timer != 0 : We've already initiated an anti-corruption campaign. ?]
on-arrival: {!
  Q.resources -= 0.25; Q.finance_corruption_timer = 8;
  Q.efficacy_finance = Math.min(1, Q.efficacy_finance + 0.1);
  Q.finance_corruption = Math.max(0, Q.finance_corruption - (0.2 * Q.efficacy_finance)); 
!}
