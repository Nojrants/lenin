@income_tax_header
title: Income tax
go-to: taxation

@increase_bracket1
title: – <span style="color: var(--level1-color);">&#9650;</span> Increase bracket one.
go-to: taxation
choose-if: income_tax_rate_1 < 5
unavailable-subtitle: The tax rate is already at the maximum.
on-arrival: income_tax_rate_1 += 0.25; capital_flight_progress += 0.25; elites_unrest += 2.5; middle_unrest += 2.5; monthly_inflation -= 0.05;

@decrease_bracket1
title: – <span style="color: var(--level7-color);">&#9660;</span> Decrease bracket one.
go-to: taxation
choose-if: income_tax_rate_1 >= 0.25
unavailable-subtitle: The tax rate is already at zero.
on-arrival: income_tax_rate_1 -= 0.25; capital_flight_progress -= 0.25; elites_unrest -= 2.5; middle_unrest -= 2.5; monthly_inflation += 0.05;

@increase_bracket2
title: – <span style="color: var(--level1-color);">&#9650;</span> Increase bracket two.
go-to: taxation
choose-if: income_tax_rate_2 < 5
unavailable-subtitle: The tax rate is already at the maximum.
on-arrival: income_tax_rate_2 += 0.25; capital_flight_progress += 0.25; elites_unrest += 2.5; middle_unrest += 2.5; monthly_inflation -= 0.05;

@decrease_bracket2
title: – <span style="color: var(--level7-color);">&#9660;</span> Decrease bracket two.
go-to: taxation
choose-if: income_tax_rate_2 >= 0.25
unavailable-subtitle: The tax rate is already at zero.
on-arrival: income_tax_rate_2 -= 0.25; capital_flight_progress -= 0.25; elites_unrest -= 2.5; middle_unrest -= 2.5; monthly_inflation += 0.05;

@increase_bracket3
title: – <span style="color: var(--level1-color);">&#9650;</span> Increase bracket three.
go-to: taxation
choose-if: income_tax_rate_3 < 5
unavailable-subtitle: The tax rate is already at the maximum.
on-arrival: income_tax_rate_3 += 0.25; capital_flight_progress += 0.25; middle_unrest += 2.5; kulaks_unrest += 1; monthly_inflation -= 0.05;

@decrease_bracket3
title: – <span style="color: var(--level7-color);">&#9660;</span> Decrease bracket three.
go-to: taxation
choose-if: income_tax_rate_3 >= 0.25
unavailable-subtitle: The tax rate is already at zero.
on-arrival: income_tax_rate_3 -= 0.25; capital_flight_progress -= 0.25; middle_unrest -= 2.5; kulaks_unrest -= 1; monthly_inflation += 0.05;

@increase_bracket4
title: – <span style="color: var(--level1-color);">&#9650;</span> Increase bracket four.
go-to: taxation
choose-if: income_tax_rate_4 < 5
unavailable-subtitle: The tax rate is already at the maximum.
on-arrival: income_tax_rate_4 += 0.25; middle_unrest += 2.5; workers_unrest += 10; monthly_inflation -= 0.05;

@decrease_bracket4
title: – <span style="color: var(--level7-color);">&#9660;</span> Decrease bracket four.
go-to: taxation
choose-if: income_tax_rate_4 >= 0.25
unavailable-subtitle: The tax rate is already at zero.
on-arrival: income_tax_rate_4 -= 0.25; middle_unrest -= 2.5; workers_unrest -= 10; monthly_inflation += 0.05;

@increase_bracket5
title: – <span style="color: var(--level1-color);">&#9650;</span> Increase bracket five.
go-to: taxation
choose-if: income_tax_rate_5 < 5
unavailable-subtitle: The tax rate is already at the maximum.
on-arrival: income_tax_rate_5 += 0.25; workers_unrest += 5; peasants_unrest += 5; monthly_inflation -= 0.05;

@decrease_bracket5
title: – <span style="color: var(--level7-color);">&#9660;</span> Decrease bracket five.
go-to: taxation
choose-if: income_tax_rate_5 >= 0.25
unavailable-subtitle: The tax rate is already at zero.
on-arrival: income_tax_rate_5 -= 0.25; workers_unrest -= 5; peasants_unrest -= 5; monthly_inflation += 0.05;

@increase_property_tax
title: <span style="color: var(--level1-color);">&#9650;</span> Increase the property tax.
go-to: taxation
on-arrival: wealth_tax_rate += 0.5; capital_flight_progress += 0.5; capital_flight_progress += 1 if wealth_tax_rate >= 2; elites_unrest += 10; middle_unrest += 5; workers_unrest -= 5; monthly_inflation -= 0.2;

@decrease_property_tax
title: <span style="color: var(--level7-color);">&#9660;</span> Decrease the property tax.
go-to: taxation
choose-if: wealth_tax_rate >= 0.5
unavailable-subtitle: The tax rate is already at zero.
on-arrival: wealth_tax_rate -= 0.5; capital_flight_progress -= 0.5; elites_unrest -= 10; middle_unrest -= 5; workers_unrest += 5; monthly_inflation += 0.2;

@increase_business_tax
title: <span style="color: var(--level1-color);">&#9650;</span> Increase the business tax.
go-to: taxation
on-arrival: business_tax_rate += 0.5; capital_flight_progress += 0.5; capital_flight_progress += 1 if business_tax_rate >= 2; elites_unrest += (10 * (trade_marketization/100)); middle_unrest += (10 * (trade_marketization/100)); workers_unrest -= 5; monthly_inflation -= 0.2;

@decrease_business_tax
title: <span style="color: var(--level7-color);">&#9660;</span> Decrease the business tax.
go-to: taxation
choose-if: business_tax_rate >= 0.5
unavailable-subtitle: The tax rate is already at zero.
on-arrival: business_tax_rate -= 0.5; capital_flight_progress -= 0.5; elites_unrest -= (10 * (trade_marketization/100)); middle_unrest -= (10 * (trade_marketization/100)); workers_unrest += 5; monthly_inflation += 0.2;

@increase_syndicate_levy
title: <span style="color: var(--level1-color);">&#9650;</span> Increase the levy on syndicalized enterprises.
go-to: taxation
choose-if: syndicate_levy_rate < 50
unavailable-subtitle: The levy is already at the maximum.
on-arrival: syndicate_levy_rate += 5; workers_unrest += (7.5 * (industries_syndicalized/100)); monthly_inflation -= 0.05;

@decrease_syndicate_levy
title: <span style="color: var(--level7-color);">&#9660;</span> Decrease the levy on syndicalized enterprises.
go-to: taxation
choose-if: syndicate_levy_rate >= 5
unavailable-subtitle: The levy is already at zero.
on-arrival: syndicate_levy_rate -= 5; workers_unrest -= (7.5 * (industries_syndicalized/100)); monthly_inflation += 0.05;




@banking
title: BANKING
new-page: true
on-arrival: {!
  Q.bond_sale = Math.max(1, Math.round((5 - (Q.bonds / 30)) * (Q.repudiation == 1 ? 0.4 : 1)));
  Q.advance_yield = Math.max(1, Math.round(50 / (1 + Q.monthly_inflation / 30)) / 10);
  Q.redeem_amount = Math.round(10 * Math.min(5, Q.bonds))/10;
  Q.redeem_price = Math.min(1, Math.max(0.3, Math.pow(5 / Math.max(1, Q.bond_rate), 0.75)));
  Q.redeem_cost = Math.round(10 * Q.redeem_amount * Q.redeem_price)/10;
  var diminishing = 1 / (1 + 0.1 * (Q.contributions_levied || 0));
  var waste = Math.min(0.9, 0.15 + 0.5 * Q.finance_corruption);
  var elites_rate = 0.12 * Math.pow(Math.min(1, Math.max(0, Q.elites_wealth) / 50), 1.25);
  var middle_rate = 0.06 * Math.pow(Math.min(1, Math.max(0, Q.middle_wealth) / 30), 1.25);
  var cheka_bonus = 0;
  if (Q.cheka_founded == 1) {
      cheka_bonus = Math.min(0.25, Math.max(0, Q.cheka * Q.cheka_militancy) / 50);
      cheka_bonus *= 0.75 + 0.25 * Math.min(1, Math.max(0, Q.cheka_loyalty));
  }
  Q.contribution_elites = Math.round(100 * Q.elites_wealth * elites_rate * diminishing * (1 + cheka_bonus))/100;
  Q.contribution_middle = Math.round(100 * Q.middle_wealth * middle_rate * diminishing * (1 + cheka_bonus))/100;
  Q.contribution_yield = Math.round(10 * (Q.contribution_elites + Q.contribution_middle) * (1 - waste))/10;

  var foreign_loans = 0;
  var foreign_interest = 0;
  var domestic_loans = 0;
  var domestic_interest = 0;
  for (var loan of Q.loans) {
      if (loan.lender == "Russia") { domestic_loans += loan.principal; domestic_interest += loan.principal * loan.rate; }
      else { foreign_loans += loan.principal; foreign_interest += loan.principal * loan.rate; }
  }
  Q.loans_exist = Q.loans.length > 0;

  var bond_interest = Q.bonds * (Q.bond_rate / 100);
  var advance_interest = Q.bank_advances * 0.02;
  var debt_total = Q.bank_advances + Q.bonds + foreign_loans + domestic_loans;
  Q.interest = foreign_interest + domestic_interest + bond_interest + advance_interest;

  Q.debt_advances_amount = Math.round(10 * Q.bank_advances)/10;
  Q.debt_advances_rate = 2;
  Q.debt_bonds_amount = Math.round(10 * Q.bonds)/10;
  Q.debt_bonds_rate = Math.round(100 * Q.bond_rate)/100;
  Q.debt_foreign_amount = Math.round(10 * foreign_loans)/10;
  Q.debt_foreign_rate = foreign_loans > 0 ? Math.round(1000 * foreign_interest / foreign_loans)/10 : 0;
  Q.debt_domestic_amount = Math.round(10 * domestic_loans)/10;
  Q.debt_domestic_rate = domestic_loans > 0 ? Math.round(1000 * domestic_interest / domestic_loans)/10 : 0;
  Q.debt_total_amount = Math.round(10 * debt_total)/10;
  Q.debt_total_rate = debt_total > 0 ? Math.round(1000 * Q.interest / debt_total)/10 : 0;
  Q.interest_display = Math.round(100 * Q.interest)/100;
!}

