choose-if: resources >= loan_10_cost
unavailable-subtitle: -[+ loan_10_cost +] resources – We lack the resources. 
tags: repay_loan
go-to: pay_off_loans
on-arrival: {!
  var loan = Q.loans[9];
  Q.resources -= loan.principal;
  Q.loans.splice(9, 1);
  var creditors = { Britain: 'uk', France: 'france', USA: 'usa', Japan: 'japan', Italy: 'italy' };
  if (creditors[loan.lender]) Q[creditors[loan.lender] + '_relation'] += 2;
  Q.instability = Math.max(0, Q.instability - 0.5);
  Q.capital_flight_progress -= loan.lender == "Russia" ? 0.25 : 0.1;
  Q.investor_confidence = Math.min(1, Q.investor_confidence + (loan.lender == "Russia" ? 0.03 : 0.015));
!}

