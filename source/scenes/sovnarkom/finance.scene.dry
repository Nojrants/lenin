title: Finance
new-page: true
is-card: true
view-if: fiscal_policy_timer == 0 and finance_minister_party = "Bolshevik"
tags: sovnarkom, government
card-image: img/finance.PNG
on-arrival: {!
  Q.fiscal_policy_timer += 2; Q.week_actions += 1
  Q.income_tax_display = Math.round(100 * Q.income_tax)/100;
  Q.property_tax_display = Math.round(100 * Q.property_tax)/100;
  Q.business_tax_display = Math.round(100 * Q.business_tax)/100;
  Q.monopolies_display = Math.round(100 * Q.monopolies)/100;
  Q.customs_display = Math.round(100 * Q.customs)/100;
  Q.railway_revenue_display = Math.round(100 * Q.railway_revenue)/100;
  Q.enterprises_revenue_display = Math.round(100 * Q.enterprises_revenue)/100;
  Q.syndicate_levy_display = Math.round(100 * Q.syndicate_levy)/100;
  Q.taxation_display = Q.income_tax_display + Q.property_tax_display + Q.business_tax_display + Q.monopolies_display + Q.customs_display;
  Q.income_display = Math.round(100 * Q.income)/100;
  Q.government_functions_display = Math.round(100 * Q.government_functions)/100;
  Q.interest = 0;
  for (var loans of Q.loans) {
      Q.interest += loans.principal * loans.rate;
  }
  Q.interest += (
      (Q.bonds * (Q.bond_rate / 100)) +
      (Q.bank_advances * 0.02)
  );
  Q.interest_display = Math.round(100 * Q.interest)/100;
  Q.indemnities_display = Math.round(100 * Q.indemnities)/100;
  Q.enterprises_expenditure_display = Math.round(100 * Q.enterprises_expenditure)/100;
  Q.enterprises_wages_display = Math.round(100 * Q.enterprises_wages)/100;
  Q.enterprises_inputs_display = Math.round(100 * Q.enterprises_inputs)/100;
  Q.enterprises_investment_display = Math.round(100 * Q.enterprises_investment)/100;
  Q.enterprises_admin_display = Math.round(100 * Q.enterprises_admin)/100;
  Q.enterprises_funding_display = Math.round(100 * Q.enterprises_funding)/100;
  Q.enterprises_net_display = Math.round(100 * Q.enterprises_net)/100;
  Q.ind_subsidies_display = Math.round(100 * Q.ind_subsidies)/100;
  Q.expenditure_display = Math.round(100 * Q.expenditure)/100;
  Q.budget_balance_display = Math.round(100 * Q.budget_balance)/100;

  Q.gdp_growth_display = Math.round(10 * Q.gdp_growth)/10;
  Q.monthly_inflation_disp = Math.round(10 * Q.monthly_inflation)/10;
  Q.inflation_disp = Math.round(10 * Q.inflation)/10;
  Q.unemployment_display = Math.round(10 * Q.unemployed)/10;
  Q.national_debt_display = Q.publicdebt;
  Q.industrial_output_display = Math.round(10 * Q.industrial_output)/10;
  Q.extraction_display = Math.round(10 * Q.extraction)/10;
  Q.agricultural_output_display = Math.round(10 * Q.ag_gdp)/10;
  Q.factory_utilization_display = Math.round(Q.factory_utilization);
  Q.rail_capacity_display = Math.round(Q.civilian_transport);
  Q.industries_nationalized_display = Math.round(Q.industries_nationalized);
  Q.industries_syndicalized_display = Math.round(Q.industries_syndicalized);
  Q.ind_exports_display = Math.round(100 * Q.ind_exports)/100;
  Q.ind_imports_display = Math.round(100 * Q.ind_imports)/100;
  Q.trade_balance_display = Math.round(100 * Q.ind_trade_balance)/100;

  Q.loans_exist = Q.loans.length > 0;

!}

= Fiscal Policy

<table style="width:100%; table-layout:fixed; border-collapse:collapse;">
<tr>
<td style="width:50%; vertical-align:top; padding:0 5px 5px 5px;">
  <div style="border:3px solid #666; border-radius:6px; padding:0; margin-bottom:10px; font-size:0.85em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:5px 6px; margin-bottom:6px; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Macroeconomy
    </div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Economic Growth</b><span style="float:right;">[? if gdp_growth_display >= 0 : <span style="color: var(--level1-color);">+[+ gdp_growth_display +]%</span> ?][? if gdp_growth_display < 0 : <span style="color: var(--level7-color);">[+ gdp_growth_display +]%</span> ?]</span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Inflation</b><span style="float:right;">[+ monthly_inflation_disp +]% ([+ inflation_disp +]% p.a.)</span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Unemployment</b><span style="float:right;">[+ unemployment_display +]%</span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>National Debt</b><span style="float:right;">[+ national_debt_display +]</span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Budget Balance</b><span style="float:right;">[? if budget_balance_display >= 0 : <span style="color: var(--level1-color);">+[+ budget_balance_display +]</span> ?][? if budget_balance_display < 0 : <span style="color: var(--level7-color);">[+ budget_balance_display +]</span> ?]</span></div>
  </div>
  <div style="border:3px solid #666; border-radius:6px; padding:0; margin-bottom:10px; font-size:0.85em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:5px 6px; margin-bottom:6px; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Production
    </div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Industrial Output</b><span style="float:right;">[+ industrial_output_display +]%</span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Mining Output</b><span style="float:right;">[+ extraction_display +]%</span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Agricultural Output</b><span style="float:right;">[+ agricultural_output_display +]%</span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Factory Utilization</b><span style="float:right;">[+ factory_utilization_display +]%</span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Rail Capacity</b><span style="float:right;">[+ rail_capacity_display +]%</span></div>
  </div>
  <div style="border:3px solid #666; border-radius:6px; padding:0; margin-bottom:10px; font-size:0.85em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:5px 6px; margin-bottom:6px; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      State Enterprises
    </div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Revenue</b><span style="float:right;"><span style="color: var(--level1-color);">+[+ enterprises_revenue_display +]</span></span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Expenditure</b><span style="float:right;"><span style="color: var(--level7-color);">-[+ enterprises_expenditure_display +]</span></span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Net Result</b><span style="float:right;">[? if enterprises_net_display >= 0 : <span style="color: var(--level1-color);">+[+ enterprises_net_display +]</span> ?][? if enterprises_net_display < 0 : <span style="color: var(--level7-color);">[+ enterprises_net_display +]</span> ?]</span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Syndicate Levy</b><span style="float:right;"><span style="color: var(--level1-color);">+[+ syndicate_levy_display +]</span></span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Industry Nationalized</b><span style="float:right;">[+ industries_nationalized_display +]%</span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Industry Syndicalized</b><span style="float:right;">[+ industries_syndicalized_display +]%</span></div>
  </div>
  <div style="border:3px solid #666; border-radius:6px; padding:0; font-size:0.85em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:5px 6px; margin-bottom:6px; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Balance of Payments
    </div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Exports</b><span style="float:right;"><span style="color: var(--level1-color);">+[+ ind_exports_display +]</span></span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Imports</b><span style="float:right;"><span style="color: var(--level7-color);">-[+ ind_imports_display +]</span></span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Trade Balance</b><span style="float:right;">[? if trade_balance_display >= 0 : <span style="color: var(--level1-color);">+[+ trade_balance_display +]</span> ?][? if trade_balance_display < 0 : <span style="color: var(--level7-color);">[+ trade_balance_display +]</span> ?]</span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Customs Revenue</b><span style="float:right;"><span style="color: var(--level1-color);">+[+ customs_display +]</span></span></div>
  </div>
</td>
<td style="width:50%; vertical-align:top; padding:0 5px 5px 5px;">
  <div style="border:3px solid #666; border-radius:6px; padding:0; margin-bottom:10px; font-size:0.80em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:5px 6px; margin:0 0 6px 0; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Budget
    </div>
    <div style="font-size:0.9em; margin:0; padding:0 8px;">
      <div style="display:flex; gap:8px; margin:0; padding:0; border-bottom:1px solid #666;">
        <div style="flex:1; min-width:0; padding:3px 0; line-height:1.2; text-align:center; font-weight:bold; white-space:nowrap;">
          Revenue
        </div>
        <div style="flex:1; min-width:0; padding:3px 0; line-height:1.2; text-align:center; font-weight:bold; white-space:nowrap;">
          Expenditure
        </div>
      </div>
      <div style="display:flex; align-items:flex-start; gap:8px; margin:0; padding:0;">
        <div style="flex:1; min-width:0; margin:0; padding:0;">
          <div style="padding:3px 0; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Income Tax<span style="float:right;"><span style="color: var(--level1-color);">+[+ income_tax_display +]</span></span></div>
          <div style="padding:3px 0; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Property Tax<span style="float:right;"><span style="color: var(--level1-color);">+[+ property_tax_display +]</span></span></div>
          <div style="padding:3px 0; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Business Tax<span style="float:right;"><span style="color: var(--level1-color);">+[+ business_tax_display +]</span></span></div>
          <div style="padding:3px 0; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Monopolies<span style="float:right;"><span style="color: var(--level1-color);">+[+ monopolies_display +]</span></span></div>
          <div style="padding:3px 0; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Customs<span style="float:right;"><span style="color: var(--level1-color);">+[+ customs_display +]</span></span></div>
          <div style="padding:3px 0; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Railways<span style="float:right;"><span style="color: var(--level1-color);">+[+ railway_revenue_display +]</span></span></div>
          <div style="padding:3px 0; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Enterprises<span style="float:right;"><span style="color: var(--level1-color);">+[+ enterprises_revenue_display +]</span></span></div>
          <div style="padding:3px 0; line-height:1.2; white-space:nowrap;">Syndicate Levy<span style="float:right;"><span style="color: var(--level1-color);">+[+ syndicate_levy_display +]</span></span></div>
        </div>
        <div style="flex:1; min-width:0; margin:0; padding:0;">
          <div style="padding:3px 0; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Government<span style="float:right;"><span style="color: var(--level7-color);">-[+ government_functions_display +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Sovnarkom<span style="float:right;"><span style="color: var(--level7-color);">-[+ sovnarkom_expend +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Foreign Affairs<span style="float:right;"><span style="color: var(--level7-color);">-[+ foreignaffairs_expend +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Military<span style="float:right;"><span style="color: var(--level7-color);">-[+ military_expend +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Enlightenment<span style="float:right;"><span style="color: var(--level7-color);">-[+ enlightenment_expend +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Internal Affairs<span style="float:right;"><span style="color: var(--level7-color);">-[+ internal_expend +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Railways<span style="float:right;"><span style="color: var(--level7-color);">-[+ railways_expend +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Trade<span style="float:right;"><span style="color: var(--level7-color);">-[+ trade_expend +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Finance<span style="float:right;"><span style="color: var(--level7-color);">-[+ finance_expend +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Justice<span style="float:right;"><span style="color: var(--level7-color);">-[+ justice_expend +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Labor<span style="float:right;"><span style="color: var(--level7-color);">-[+ labor_expend +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Agriculture<span style="float:right;"><span style="color: var(--level7-color);">-[+ agriculture_expend +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Food Supply<span style="float:right;"><span style="color: var(--level7-color);">-[+ foodsupply_expend +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Nationalities<span style="float:right;"><span style="color: var(--level7-color);">-[+ nationalities_expend +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Welfare<span style="float:right;"><span style="color: var(--level7-color);">-[+ welfare_expend +]</span></span></div>
          <div style="padding:3px 0; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Enterprises<span style="float:right;"><span style="color: var(--level7-color);">-[+ enterprises_expenditure_display +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Wages<span style="float:right;"><span style="color: var(--level7-color);">-[+ enterprises_wages_display +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Inputs<span style="float:right;"><span style="color: var(--level7-color);">-[+ enterprises_inputs_display +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Investment<span style="float:right;"><span style="color: var(--level7-color);">-[+ enterprises_investment_display +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Administration<span style="float:right;"><span style="color: var(--level7-color);">-[+ enterprises_admin_display +]</span></span></div>
          <div style="padding:3px 0 3px 9px; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Direct Funding<span style="float:right;"><span style="color: var(--level7-color);">-[+ enterprises_funding_display +]</span></span></div>
          <div style="padding:3px 0; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Industry Subsidies<span style="float:right;"><span style="color: var(--level7-color);">-[+ ind_subsidies_display +]</span></span></div>
          <div style="padding:3px 0; line-height:1.2; white-space:nowrap; border-bottom:1px dotted #aaa;">Interest<span style="float:right;"><span style="color: var(--level7-color);">-[+ interest_display +]</span></span></div>
          <div style="padding:3px 0; line-height:1.2; white-space:nowrap;">Indemnities<span style="float:right;"><span style="color: var(--level7-color);">-[+ indemnities_display +]</span></span></div>
        </div>
      </div>
      <div style="display:flex; gap:8px; margin:0; padding:0; border-top:2px solid #666;">
        <div style="flex:1; min-width:0; padding:3px 0; line-height:1.2; white-space:nowrap;">
          <b>Total</b><span style="float:right;"><span style="color: var(--level1-color);">+[+ income_display +]</span></span>
        </div>
        <div style="flex:1; min-width:0; padding:3px 0; line-height:1.2; white-space:nowrap;">
          <b> </b><span style="float:right;"><span style="color: var(--level7-color);">-[+ expenditure_display +]</span></span>
        </div>
      </div>
      <div style="padding:3px 0; line-height:1.2; white-space:nowrap; border-top:1px solid #666;"><b>Balance</b><span style="float:right;">[? if budget_balance_display >= 0 : <span style="color: var(--level1-color);">+[+ budget_balance_display +]</span> ?][? if budget_balance_display < 0 : <span style="color: var(--level7-color);">[+ budget_balance_display +]</span> ?]</span></div>
    </div>
  </div>
</td>
</tr>
</table>





- @administration
- @policy
- @taxation
- @banking
- @finance_null
- @seize_banks
- @repudiate_loans
- @root: Do not change finance
- @easy_discard
- @cancel_advisor_action


@finance_null
title: -------------------------------------------------------------------------------------------------
go-to: finance


@seize_banks
title: Seize the banks!
subtitle: Nationalize banks to allow us full control over fiscal policy. 
view-if: banks_seized = 0
on-arrival: banks_seized = 1; resources += 4; elites_unrest += 5; middle_unrest += 5; instability += 5; capital_flight_progress += 0.5;

@repudiate_loans
title: Repudiate all outstanding loans.
subtitle: This will free-up resources but substantially impact our foreign relations. 
view-if: repudiation = 0
choose-if: loans_exist
unavailable-subtitle: We have no outstanding loans. 
on-arrival: {!
  Q.repudiation = 1; 
  Q.loans = Q.loans.filter(function(loan) { return loan.lender == "Russia"; });
  Q.bonds *= 0.65;
  Q.uk_relation -= 35; Q.france_relation -= 40; Q.usa_relation -= 35; Q.italy_relation -= 30;
  Q.japan_relation -= 30; Q.germany_relation -= 5; Q.austria_relation -= 5; Q.ottoman_relation -= 5;
  Q.instability += 10; Q.monthly_inflation += 0.5; Q.capital_flight_progress += 1; 
!}

@finance_return
title: Cancel action
go-to: finance

  

@policy
title: POLICY
new-page: true

= Government Policy

- @discipline
- @raise_salaries
- @finance_return

@discipline
title: Practice budget discipline
subtitle: Cut salaries and benefits across the government. 
unavailable-subtitle: There is nothing left to cut.
choose-if: efficacy_finance > 0.25
on-arrival: efficacy_finance -= 0.1; efficacy_foreign -= 0.1; efficacy_military -= 0.1; efficacy_enlightenment -= 0.1; efficacy_internal -= 0.1; efficacy_railways -= 0.1; efficacy_trade -= 0.1; efficacy_justice -= 0.1; efficacy_agriculture -= 0.1; efficacy_foodsupply -= 0.1; efficacy_nationalities -= 0.1; efficacy_welfare -= 0.1; foreignaffairs_expend -= 0.25; military_expend -= 0.25; enlightenment_expend -= 0.25; railways_expend -= 0.25; trade_expend -= 0.25; finance_expend -= 0.25; justice_expend -= 0.25; labor_expend -= 0.25; agriculture_expend -= 0.25; foodsupply_expend -= 0.25; nationalities_expend -= 0.25; welfare_expend -= 0.25; monthly_inflation -= 0.1; 

Cutting the budget hurts the workers and middle class, and also reduces the morale of the soldiers and railroad workers, two of the largest groups of government employees. This makes them less effective at their jobs.

@raise_salaries
title: Raise salary rates
subtitle: Raise salaries for government employees.
on-arrival: efficacy_finance += 0.15 if efficacy_finance < 1; efficacy_foreign += 0.15 if efficacy_foreign < 1; efficacy_military += 0.15 if efficacy_military < 1; efficacy_enlightenment += 0.15 if efficacy_enlightenment < 1; efficacy_internal += 0.15 if efficacy_internal < 1; efficacy_railways += 0.15 if efficacy_railways < 1; efficacy_trade += 0.15 if efficacy_trade < 1; efficacy_justice += 0.15 if efficacy_justice < 1; efficacy_agriculture += 0.15 if efficacy_agriculture < 1; efficacy_foodsupply += 0.15 if efficacy_foodsupply < 1; efficacy_nationalities += 0.15 if efficacy_nationalities < 1; efficacy_welfare += 0.15 if efficacy_welfare < 1; foreignaffairs_expend += 0.25; military_expend += 0.25; enlightenment_expend += 0.25; railways_expend += 0.25; trade_expend += 0.25; finance_expend += 0.25; justice_expend += 0.25; labor_expend += 0.25; agriculture_expend += 0.25; foodsupply_expend += 0.25; nationalities_expend += 0.25; welfare_expend += 0.25; monthly_inflation += 0.05; capital_flight_progress -= 0.5;




@taxation
title: TAXATION
new-page: true
on-arrival: {!
  var income_efficacy = (Q.income_tax_efficacy / 4 * 3) + (Q.finalefficacy_finance / 4);
  Q.income_tax_estimate = 0;
  for (var bracket = 1; bracket <= 5; bracket++) {
      var estimate = (Q['income_tax_yield_' + bracket] || 0) * Q['income_tax_rate_' + bracket] * income_efficacy;
      Q['income_tax_' + bracket + '_display'] = Math.round(100 * estimate)/100;
      Q.income_tax_estimate += estimate;
  }
  Q.income_tax_estimate = Math.round(100 * Q.income_tax_estimate)/100;
  Q.property_tax_estimate = Math.round(100 * (Q.property_tax_yield || 0) * Q.wealth_tax_rate)/100;
  Q.business_tax_estimate = Math.round(100 * (Q.business_tax_yield || 0) * Q.business_tax_rate)/100;
  Q.syndicate_levy_estimate = Math.round(100 * (Q.syndicate_levy_yield || 0) * Q.syndicate_levy_rate)/100;
  Q.taxation_estimate = Math.round(100 * (Q.income_tax_estimate + Q.property_tax_estimate + Q.business_tax_estimate + Q.syndicate_levy_estimate))/100;
!}

