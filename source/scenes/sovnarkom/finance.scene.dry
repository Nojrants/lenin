[? if income_tax_trend = 1 : <span style="color: var(--level1-color);">&#9650;</span> ?][? if income_tax_trend = -1 : <span style="color: var(--level7-color);">&#9660;</span> ?][? if income_tax_trend = 0 : <span style="color: #5aa9e6;">&#9644;</span> ?] [+ income_tax_efficacy_display +]%
</td>
</tr>
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px; border-bottom:1px solid rgba(128,128,128,0.25);">
