- @repudiate_loans
- @root: Do not change finance
- @easy_discard
- @cancel_advisor_action


@finance_null
title: -------------------------------------------------------------------------------------------------
go-to: finance


@seize_banks
title: Seize the banks!
subtitle: Nationalize banks to allow us full control over fiscal policy. 
view-if: banks_seized = 0
on-arrival: {!
  Q.banks_seized = 1;
  Q.resources += 4;
  Q.elites_unrest += 5; Q.middle_unrest += 5;
  Q.instability += 5; Q.capital_flight_progress += 0.5;
  Q.efficacy_finance = Math.max(0, Q.efficacy_finance - 0.1);
  Q.bourgeois_specialists *= 0.98;
  Q.uk_relation -= 5; Q.france_relation -= 5;
  Q.investor_confidence = Math.min(1, Math.max(0, Q.investor_confidence - 0.1));
!}

@repudiate_loans
title: Repudiate all outstanding debt and financial obligations. 
subtitle: This will end our interest payments but ruin our credit at home and abroad. 
view-if: repudiation = 0
choose-if: loans_exist or bonds > 0
unavailable-subtitle: We have no outstanding debts. 
on-arrival: {!
  Q.repudiation = 1;

  var owed = { Britain: 0, France: 0, USA: 0, Japan: 0, Italy: 0, Russia: 0 };
  for (var loan of Q.loans) { owed[loan.lender] = (owed[loan.lender] || 0) + loan.principal; }
  Q.loans = [];
  Q.loans_exist = false;

  var bonds_annulled = Q.bonds * 0.85;
  Q.bonds = Math.round(100 * (Q.bonds - bonds_annulled))/100;
  Q.bond_rate = 3;

  Q.uk_relation -= 20 + 3 * owed.Britain;
  Q.france_relation -= 20 + 3 * owed.France;
  Q.usa_relation -= 20 + 3 * owed.USA;
  Q.italy_relation -= 20 + 3 * owed.Italy;
  Q.japan_relation -= 20 + 3 * owed.Japan;
  Q.germany_relation -= 5; Q.austria_relation -= 5; Q.ottoman_relation -= 5;

  var domestic_loss = bonds_annulled + owed.Russia;
  Q.elites_wealth -= domestic_loss * 0.15;
  Q.middle_wealth -= domestic_loss * 0.10;
  Q.elites_unrest += 10; Q.middle_unrest += 10; Q.kulaks_unrest += 2;
  Q.workers_unrest -= 2; Q.soldiers_unrest -= 2;

  Q.instability += 4; Q.monthly_inflation += 0.5; Q.capital_flight_progress += 1;
  Q.bourgeois_specialists *= 0.97;
  Q.investor_confidence = Math.min(1, Math.max(0, Q.investor_confidence - 0.15));
!}

@finance_return
title: Cancel action
go-to: finance

  

@policy
title: POLICY
new-page: true
on-arrival: {!
  Q.tax_administration_display = Math.round(100 * Q.tax_administration);
  for (var tax of ['income_tax', 'wealth_tax', 'business_tax']) {
      Q[tax + '_efficacy_display'] = Math.round(100 * Q[tax + '_efficacy']);
      var gap = (Q[tax + '_target'] !== undefined ? Q[tax + '_target'] : Q[tax + '_efficacy']) - Q[tax + '_efficacy'];
      Q[tax + '_trend'] = gap > 0.005 ? 1 : (gap < -0.005 ? -1 : 0);
  }
  Q.black_market_level = Math.min(1, Math.max(0, Q.black_market / 100));
  Q.cheka_collection_bonus = Q.cheka_founded == 1 ? Math.min(0.1, Math.max(0, Q.cheka * Q.cheka_militancy) / 100) : 0;
  Q.census_cost = Math.round(100 * (1 - Math.min(0.25, 0.125 * Q.tax_inspectors)))/100;
  Q.amnesty_yield = Math.round(10 * 0.5 * (Q.income_tax + Q.property_tax + Q.business_tax) / (1 + Q.tax_amnesties))/10;
!}

= Fiscal Policy

<table style="width:100%; border-collapse:collapse; margin:10px 0;">
<tr>
<td style="text-align:left; padding:5px 5px 5px 15px; border-bottom:1px solid rgba(128,128,128,0.25);">
