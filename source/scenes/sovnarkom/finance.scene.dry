@finance_issue_currency
title: Issue additional currency. 
choose-if: banks_seized = 1
unavailable-subtitle: We lack control over the banks. 
subtitle: +[+ advance_yield +] resources – Rising prices erode what each issue buys. 
on-arrival: {!
    Q.resources += Q.advance_yield;
    Q.currency_issued = (Q.currency_issued || 0) + 5;

    var pressure = 1.2 * (Q.instability / 12.5);
    pressure *= 1 + ((Q.bank_advances + Q.currency_issued) / 50);
    pressure *= Math.max(1, 65 / Q.gdp_index);
    if (Q.repudiation == 1) pressure *= 1.25;
    Q.monthly_inflation += pressure;

    Q.food_sold *= 0.98;
    Q.middle_wealth *= 0.98; Q.middle_unrest += 2;
    Q.instability += 1;
  Q.investor_confidence = Math.min(1, Math.max(0, Q.investor_confidence - 0.03));
!}

@finance_bank_advances
title: Borrow from the State Bank.
choose-if: banks_seized = 1
unavailable-subtitle: We lack control over the banks. 
subtitle: +[+ advance_yield +] resources – Rising prices erode what each advance buys. 
on-arrival: {!
    Q.resources += Q.advance_yield;
    Q.bank_advances += 5;

    var pressure = 1.2 * (Q.instability / 25);
    pressure *= 1 + ((Q.bank_advances + (Q.currency_issued || 0)) / 50);
    pressure *= Math.max(1, 65 / Q.gdp_index);
    if (Q.repudiation == 1) pressure *= 1.25;
    Q.monthly_inflation += pressure;

    Q.food_sold *= 0.99;
    Q.middle_wealth *= 0.99; Q.middle_unrest += 1;
    Q.instability += 0.25;
  Q.investor_confidence = Math.min(1, Math.max(0, Q.investor_confidence - 0.015));
!}

@finance_issue_bonds
title: [? if repudiation = 0 : Issue government bonds. ?][? if repudiation = 1 : Impose a compulsory loan. ?]
subtitle: +[+ bond_sale +] resources – [? if repudiation = 0 : Existing debt lowers bond sales. ?][? if repudiation = 1 : No one will lend to us willingly. ?]
on-arrival: {!
  Q.bonds += Q.bond_sale; Q.resources += Q.bond_sale;
  Q.instability += 0.5;
  Q.monthly_inflation += 1.1 * (Q.instability / 50);
  if (Q.bonds > 90) Q.bond_rate += 1;
  else if (Q.bonds > 60) Q.bond_rate += 0.5;
  else Q.bond_rate += 0.25;
  if (Q.repudiation == 1) {
    Q.bond_rate += 1;
    Q.elites_unrest += 3; Q.middle_unrest += 3; Q.kulaks_unrest += 1;
  }
  Q.investor_confidence = Math.min(1, Math.max(0, Q.investor_confidence - (Q.repudiation == 1 ? 0.03 : 0.005)));
!}

@redeem_bonds
title: Redeem government bonds.
subtitle: -[+ redeem_cost +] resources – Retires [+ redeem_amount +] bonds.<br>Poor credit makes our own debt cheap to buy back. 
choose-if: bonds > 0 and resources >= redeem_cost
unavailable-subtitle: [? if bonds <= 0 : We have no bonds outstanding. ?][? if bonds > 0 : -[+ redeem_cost +] resources – We lack the resources. ?]
on-arrival: {!
  Q.resources -= Q.redeem_cost;
  Q.bonds = Math.max(0, Q.bonds - Q.redeem_amount);
  Q.bond_rate = Math.max(3, Q.bond_rate - 0.25);
  Q.monthly_inflation = Math.max(0, Q.monthly_inflation - 0.1);
  Q.elites_unrest -= 1; Q.middle_unrest -= 1;
  Q.investor_confidence = Math.min(1, Math.max(0, Q.investor_confidence + 0.02));
!}

@pay_off_loans
title: Pay off outstanding loans...
choose-if: loans_exist
unavailable-subtitle: We have no loans to repay. 
new-page: true
on-arrival: {!
  Q.loans.sort(function(a, b) { return b.rate - a.rate; });
  for (var slot = 1; slot <= 16; slot++) {
      var loan = Q.loans[slot - 1];
      Q['loan_' + slot + '_exists'] = loan ? 1 : 0;
      Q['loan_' + slot + '_lender'] = loan ? loan.lender : "";
      Q['loan_' + slot + '_rate'] = loan ? Math.round(1000 * loan.rate)/10 : 0;
      Q['loan_' + slot + '_cost'] = loan ? Math.round(100 * loan.principal)/100 : 0;
  }
  Q.loans_exist = Q.loans.length > 0;
  Q.resources_display = Math.round(100 * Q.resources)/100;
!}

= Outstanding Loans

[? if loans_exist : We have [+ resources_display +] resources on hand. ?][? if not loans_exist : We have no loans outstanding. ?]

- #repay_loan
- @banking: Cancel

@repay_loan_1
title: Owed to [+ loan_1_lender +] at [+ loan_1_rate +]% interest.
subtitle: -[+ loan_1_cost +] resources
view-if: loan_1_exists = 1
choose-if: resources >= loan_1_cost
unavailable-subtitle: -[+ loan_1_cost +] resources – We lack the resources. 
tags: repay_loan
go-to: pay_off_loans
on-arrival: {!
  var loan = Q.loans[0];
  Q.resources -= loan.principal;
  Q.loans.splice(0, 1);
  var creditors = { Britain: 'uk', France: 'france', USA: 'usa', Japan: 'japan', Italy: 'italy' };
  if (creditors[loan.lender]) Q[creditors[loan.lender] + '_relation'] += 2;
  Q.instability = Math.max(0, Q.instability - 0.5);
  Q.capital_flight_progress -= loan.lender == "Russia" ? 0.25 : 0.1;
  Q.investor_confidence = Math.min(1, Q.investor_confidence + (loan.lender == "Russia" ? 0.03 : 0.015));
!}

