[? if wealth_tax_trend = 1 : <span style="color: var(--level1-color);">&#9650;</span> ?][? if wealth_tax_trend = -1 : <span style="color: var(--level7-color);">&#9660;</span> ?][? if wealth_tax_trend = 0 : <span style="color: #5aa9e6;">&#9644;</span> ?] [+ wealth_tax_efficacy_display +]%
</td>
</tr>
