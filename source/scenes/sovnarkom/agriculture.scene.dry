title: Agriculture
new-page: true
is-card: true
view-if: agricultural_policy_timer == 0 and agriculture_minister_party = "Bolshevik"
card-image: img/agriculture.PNG
tags: sovnarkom, government
on-arrival: {!
  Q.agricultural_policy_timer += 2; Q.week_actions += 1
  Q.area_cultivated = Math.round(Q.ag_land/100*102,327,000); 
  Q.ag_labor_rounded = Math.round(100*Q.ag_labor)/100; 
  Q.ag_labor_number = Math.round((Q.ag_labor/100) * 46.23); 
  Q.ag_capital_number = Math.round((Q.ag_capital/100) * 60.5); 
  Q.ag_capital_rounded = Math.round(100*Q.ag_capital)/100; 
  Q.ag_inputs_number = Math.round((Q.ag_inputs/100) * 15.2); 
  Q.ag_inputs_rounded = Math.round(100*Q.ag_inputs)/100; 
  Q.ag_productivity_rounded = Math.round(100*Q.ag_productivity)/100; 
  Q.ag_capacity_rounded = Math.round(10000*Q.ag_capacity)/100;
  Q.ag_output_rounded = Math.round(10000*Q.ag_output)/100;
  Q.land_reform_progress_percentage = Q.land_reform_progress * 10;

  Q.state_land_rounded = Math.round(100*Q.state_land)/100;
  Q.collective_land_rounded = Math.round(100*Q.collective_land)/100;
  Q.peasant_land_rounded = Math.round(100*Q.peasant_land)/100;
  Q.cooperative_land_rounded = Math.round(100*Q.cooperative_land)/100;
  Q.commune_land_rounded = Math.round(100*Q.commune_land)/100;
  Q.cossack_land_rounded = Math.round(100*Q.cossack_land)/100;
  Q.gentry_land_rounded = Math.round(100*Q.gentry_land)/100;
  Q.church_land_rounded = Math.round(100*Q.church_land)/100;
  
!}

= Agricultural Policy

<table style="width:100%; table-layout:fixed; border-collapse:collapse;">
<tr>
<td style="width:50%; vertical-align:top; padding:0 5px 5px 5px;">
  <div style="border:3px solid #666; border-radius:6px; padding:0; margin-bottom:10px; font-size:0.85em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:5px 6px; margin-bottom:6px; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Food Supply
    </div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Urban supply</b><span style="float:right;">[+ food_supply_urban +] million kg/year</span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Urban demand</b><span style="float:right;">[+ food_demand_urban +] million kg/year</span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Food shortage</b><span style="float:right;">[+ hunger +]%</span></div>
  </div>
  <div style="border:3px solid #666; border-radius:6px; padding:0; margin-bottom:10px; font-size:0.80em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:5px 6px; margin:0 0 6px 0; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Production (relative to 1913)
    </div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Area cultivated</b><span style="float:right;">[+ area_cultivated +] dessiatines ([+ ag_land +]%)</span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Labor</b><span style="float:right;">[+ ag_labor_number +] million people ([+ ag_labor_rounded +]%)</span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Capital</b><span style="float:right;">[+ ag_capital_number +] million rubles ([+ ag_capital_rounded +]%)</span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Inputs</b><span style="float:right;">[+ ag_inputs_number +] million rubles ([+ ag_inputs_rounded +]%)</span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Productivity</b><span style="float:right;">[+ ag_productivity_rounded +]%</span></div>
  <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Rural instability</b><span style="float:right;">[+ ag_stability : instability +]</span></div>
  <div style="display:flex; gap:8px; margin:0; padding:0; border-top:2px solid #666;">
        <div style="flex:1; min-width:0; padding:3px 0; line-height:1.2; white-space:nowrap;">
  <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Total capacity</b><span style="float:right;">[+ ag_capacity_rounded +]%</span></div>
  <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Total output</b><span style="float:right;">[+ ag_output_rounded +]%</span></div>
</div></div></div>
</td>
<td style="width:50%; vertical-align:top; padding:0 5px 5px 5px;">
  <div style="border:3px solid #666; border-radius:6px; padding:0; margin-bottom:10px; font-size:0.80em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:5px 6px; margin:0 0 6px 0; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Funding & Investment
    </div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Expenditure</b><span style="float:right;"><span style="color: var(--level7-color);">-[+ agriculture_expend +]</span></span></div>
  <div style="display:flex; gap:8px; margin:0; padding:0; border-top:2px solid #666;">
        <div style="flex:1; min-width:0; padding:3px 0; line-height:1.2; white-space:nowrap;">
  <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Land Reform</b><span style="float:right;">[+ land_reform_progress_percentage +]% completed</span></div>
</div></div>
</div>
  <div style="border:3px solid #666; border-radius:6px; padding:0; margin-bottom:10px; font-size:0.80em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:5px 6px; margin:0 0 6px 0; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
