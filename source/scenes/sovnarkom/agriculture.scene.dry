choose-if: lower_school_funding > 0
unavailable-subtitle: Funding is already non-existent. 
tags: agriculture_funding
go-to: funding
on-arrival: {!
  Q.state_farm_funding -= 0.1;
  Q.agriculture_expend -= 0.1;
!}

