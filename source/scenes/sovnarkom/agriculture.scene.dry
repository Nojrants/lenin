    <tr style="background:rgba(215,205,180,0.12);"><td style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Labor</b></td><td style="padding:3px 4px 3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ag_labor_number +] million people</td><td style="padding:3px 4px; line-height:1.2; white-space:nowrap;">&ndash;</td><td style="padding:3px 8px 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ag_labor_rounded +]%</td></tr>
    <tr><td style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Capital</b></td><td style="padding:3px 4px 3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ag_capital_number +] million rubles</td><td style="padding:3px 4px; line-height:1.2; white-space:nowrap;">&ndash;</td><td style="padding:3px 8px 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ag_capital_rounded +]%</td></tr>
    <tr style="background:rgba(215,205,180,0.12);"><td style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Inputs</b></td><td style="padding:3px 4px 3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ag_inputs_number +] million rubles</td><td style="padding:3px 4px; line-height:1.2; white-space:nowrap;">&ndash;</td><td style="padding:3px 8px 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ag_inputs_rounded +]%</td></tr>
    <tr><td style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Productivity</b></td><td colspan="2"></td><td style="padding:3px 8px 3px 4px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ag_productivity_rounded +]%</td></tr>
    <tr><td style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Rural stability</b></td><td colspan="3" style="padding:3px 8px; line-height:1.2; white-space:nowrap; text-align:right;">[+ ag_stability : instability +]</td></tr>
    </table>
  <div style="display:flex; gap:8px; margin:0; padding:0; border-top:2px solid #666;">
