@increase_statefarm_funding
title: Increase funding for state farms and collectives. 
tags: agriculture_funding
go-to: funding
choose-if: state_farm_funding < 2
unavailable-subtitle: Funding is already maxed. 
on-arrival: {!
  Q.state_farm_funding += 0.1;
  Q.agriculture_expend += 0.1;
!}

@decrease_statefarm_funding
