- @improve_admin
- @hire_staff
- @corruption
- @agriculture_return

@improve_admin
title: Streamline the commissariat
subtitle: Cut waste and inefficiencies, increase labor intensity
choose-if: agriculture_streamline_timer = 0
unavailable-subtitle: There's nothing more to cut at the moment. 
on-arrival: agriculture_expend -= 0.25; efficacy_agriculture += 0.1 if efficacy_agriculture < 1; agriculture_streamline_timer += 8; 

@hire_staff
title: Hire administrative personnel
subtitle: -0.5 resources
choose-if: resources >= 0.5
unavailable-subtitle: -0.5 resources – We lack the resources. 
on-arrival: efficacy_agriculture += 0.2 if efficacy_agriculture < 1; agriculture_expend += 0.25; resources -= 0.5;

@corruption
title: Root-out departmental corruption. 
subtitle: -0.5 resources
choose-if: agriculture_corruption_timer = 0 and resources >= 0.5
unavailable-subtitle: -0.5 resources – [?if resources < 0.5 : We lack the resources. ?][?if agriculture_corruption_timer != 0 : We've already initiated an anti-corruption campaign. ?]
on-arrival: {!
  Q.resources -= 0.5; Q.agriculture_corruption_timer = 8;
  Q.efficacy_agriculture = Math.min(1, Q.efficacy_agriculture + 0.1);
  Q.agriculture_corruption = Math.max(0, Q.agriculture_corruption - (0.2 * Q.efficacy_agriculture)); 
!}

@agriculture_null
title: -------------------------------------------------------------------------------------------------
go-to: agriculture

@agriculture_return
title: Cancel action
go-to: agriculture

