    - Math.max(0, (Q.leninist_strength / Q.moderate_strength))
    + Math.max(0, (Q.moderate_strength / Q.leninist_strength))
);
Q.left_m_strength += 3;
Q.centre_m_relation += 3 + Math.max(
    0,
    (6 * (1 - Q.b_dissent))
    - Math.max(0, (Q.leninist_strength / Q.moderate_strength))
    + Math.max(0, (Q.moderate_strength / Q.leninist_strength))
);
Q.right_m_relation += 3 + Math.max(
    0,
    (6 * (1 - Q.b_dissent))
    - Math.max(0, (Q.leninist_strength / Q.moderate_strength))
    + Math.max(0, (Q.moderate_strength / Q.leninist_strength))
);
Q.right_m_strength -= 3;
Q.lsr_relation += 3 + Math.max(
    0,
    (6 * (1 - Q.b_dissent))
    - Math.max(0, (Q.leninist_strength / Q.moderate_strength))
    + Math.max(0, (Q.moderate_strength / Q.leninist_strength))
);
Q.centre_sr_relation += 3 + Math.max(
    0,
    (6 * (1 - Q.b_dissent))
    - Math.max(0, (Q.leninist_strength / Q.moderate_strength))
    + Math.max(0, (Q.moderate_strength / Q.leninist_strength))
);
Q.right_sr_relation += 3 + Math.max(
    0,
    (6 * (1 - Q.b_dissent))
    - Math.max(0, (Q.leninist_strength / Q.moderate_strength))
    + Math.max(0, (Q.moderate_strength / Q.leninist_strength))
);
Q.right_sr_strength -= 3;
Q.ns_relation += 3 + Math.max(
    0,
    (6 * (1 - Q.b_dissent))
    - Math.max(0, (Q.leninist_strength / Q.moderate_strength))
    + Math.max(0, (Q.moderate_strength / Q.leninist_strength))
);
Q.right_sr_strength -= 3;
!}

Our overtures to the other socialists parties are unexpected, by welcome by moderates on either side. [? if leninist_strength >= moderate_strength : The influence of Lenin however makes it difficult for us to make further in-roads. ?]


 
