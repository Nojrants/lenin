title: Game Over.
new-page: true
go-to: eg_menu
audio: music/TchaikovskyQuartet2.ogg
on-arrival: {!
// Achievements:
this.achieve('game_completed');

if (Q.dreamteam == 1) {
    this.achieve('golden_age_of_the_peoples_commissars');
}

if (Q.revolutionary_victory && Q.player_party != 'b' && !Q.join_bolshevik) {
    this.achieve('dustbin');
}

if (Q.revolutionary_victory && Q.player_party != 'b' && Q.join_bolshevik) {
    this.achieve('junior_partner');
}

if (Q.revolutionary_victory && Q.player_party == 'b') {
    this.achieve('red_october');
}

if (Q.ca_held) {
    if (Q.player_party == "m") {
        this.achieve('historical_materialism');
    } else if (Q.player_party == "sr") {
        this.achieve('land_and_liberty');
    } else if (Q.player_party == "k") {
        this.achieve('constitutional_democracy');
    }
    if ((Q.player_party == "m" || Q.player_party == "sr" || Q.player_party == "k")) {
        if (Q.difficulty >= 0) {
            this.achieve('constituent_assembly');
        }
        if (Q.difficulty >= 1) {
            this.achieve('free_russia');
        }
    }
    if (Q.player_party == "m" && Q.m_leadership == 1 && Q.in_socialist_coalition && (Q.is_armistice || Q.is_peace)) {
        this.achieve('martovs_dream');
    }
    if (Q.player_party == "b" && Q.b_assembly_votes_dec >= 30) {
        this.achieve('kamenevs_dream');
    }
}

if (Q.hunger < 11) {
    this.achieve('end_famine');
}

if ((Q.is_armistice || Q.is_peace) && Q.hunger < 20 && Q.land_reform_progress >= 3) {
    this.achieve('peace_land_bread');
}

if (Q.monthly_inflation < 3) {
    this.achieve('low_inflation');
}
!}

= End

@eg_menu

- #endings
- @end_game: End game.

@dreamteam
title: Golden Age of the People's Commissars
view-if: dreamteam = 1
tags: endings
go-to: eg_menu

We assembled an all-star composition in the Council of People's Commissars. 







@achievements
title: Achievements
tags: endings
new-page: true
go-to: eg_menu if started == 1; root.start_menu_2 if started == 0
on-arrival: {!
const toolsWrapper = document.getElementById('tools_wrapper');
if (toolsWrapper) {
  toolsWrapper.style.display = 'none';
}
const elements = document.querySelectorAll('header, #content, footer');
elements.forEach(el => {
  el.style.maxWidth = '800px';
});

const achievements = [
  "achievement_golden_age_of_the_peoples_commissars"
];

Q.unlockedCount = achievements.filter(key => Q[key] === 1).length;
Q.totalAchievements = achievements.length;
Q.percentComplete = Math.round((Q.unlockedCount / Q.totalAchievements) * 100);

on-display: {! 

  var content = document.querySelector('#page #mid_panel #content');

  var progressWrapper = document.createElement('div');

  var unlockedCount = Q.unlockedCount || 0;
  var totalAchievements = Q.totalAchievements || 0;
  var percentComplete = Q.percentComplete || 0;

  var heading1 = document.createElement('h2');
  heading1.id = 'achievementStatus';
  heading1.style.textAlign = 'center';
  heading1.textContent = `${unlockedCount} / ${totalAchievements} Achievements Unlocked`;
  progressWrapper.appendChild(heading1);

  var heading2 = document.createElement('h2');
  heading2.id = 'percentStatus';
  heading2.style.textAlign = 'center';
  heading2.textContent = `${percentComplete}% Unlocked`;
  progressWrapper.appendChild(heading2);

  var container = document.createElement('div');
  container.className = 'progress-container';
  container.id = 'progressContainer';
  progressWrapper.appendChild(container);

  ['black', 'red', 'gold'].forEach(color => {
    var block = document.createElement('div');
    block.className = `flag-block ${color}`;
    container.appendChild(block);
  });

  var fill = document.createElement('div');
  fill.id = 'progressFill';
  fill.className = 'progress-fill';
  fill.style.width = (100 - percentComplete) + '%';
  container.appendChild(fill);

  content.appendChild(progressWrapper);

  var mode = document.createElement('h2');
  mode.id = 'germanFlagText';
  mode.style.textAlign = 'center';
  mode.style.display = 'flex';
  mode.style.justifyContent = 'space-around'; 
  mode.style.alignItems = 'center';
  mode.style.gap = '10px';
  mode.style.fontSize = 'clamp(24px, 10vw, 60px)';
  mode.style.flexWrap = 'wrap';

  var style = document.createElement('style');
  style.textContent = `
    #germanFlagText {
      margin-left: -30px;
    }
  
    @media (max-width: 600px) {
      #germanFlagText {
        margin-left: -20px;
      }
    }
  `;
  document.head.appendChild(style);

  function getColor(threshold, progress, color) {
    return progress >= threshold ? color : '#431';
  }

  var schwarz = document.createElement('span');
  schwarz.textContent = 'Schwarz';
  schwarz.style.color = getColor(33, percentComplete, '#000000');

  var rot = document.createElement('span');
  rot.textContent = 'Rot';
  rot.style.color = getColor(66, percentComplete, '#DD0000');

  var gold = document.createElement('span');
  gold.textContent = 'Gold';
  gold.style.color = getColor(100, percentComplete, '#FFCC00');

  mode.appendChild(schwarz);
  mode.appendChild(rot);
  mode.appendChild(gold);

  progressWrapper.appendChild(mode);
  
!}
tags: endings
go-to: fun_zone

