@party_b
title: Party Affairs
card-image: img/pravda.jpg
is-deck: true
view-if: player_party = "b"

- #b_party

@government
title: Government
view-if: player_party = "k" or (player_party = "m" and m_in_gov) or (player_party = "sr" and sr_in_gov) or (player_party = "b" and b_in_gov)
card-image: img/prov_gov_1.jpg
is-deck: true

- #government
