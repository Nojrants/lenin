######################################### MENSHEVIK PARTY ELECTION
@menshevik_party_election
title: Menshevik Party Election
on-arrival: {!

Q.menshevik_factions = ["left_m", "m", "right_m", "m_nonfactional"];
Q.m_nonfactional_strength = Q.m_dissent * 10; 
Q.left_m_strength += Q.m_modifier; 
Q.right_m_strength -= Q.m_modifier; 


var total_strength = 0;
for (var faction of Q.menshevik_factions) {
    if (!Q[faction + '_strength'] || Q[faction + '_strength'] <= 4) {
        Q[faction + '_strength'] = 4;
    }
    total_strength += Q[faction + '_strength'];
}
if (total_strength <= 0) { total_strength = 1; }

for (var faction of Q.menshevik_factions) {
    Q[faction + '_normalized'] =
        Q[faction + '_strength'] / total_strength;
    Q[faction + '_percentage'] =
        Math.round(Q[faction + '_normalized'] * 1000) / 10;
}

var total_delegates = 30 + (60 - Q.instability) + (Q.m_strength + Q.left_m_strength + Q.right_m_strength);
for (var faction of Q.menshevik_factions) {
    Q[faction + '_delegates'] =
        Math.round(
            Q[faction + '_normalized'] *
            total_delegates
        );
}
Q.left_m_strength -= Q.m_modifier; 
Q.right_m_strength += Q.m_modifier; 
!}
go-to: jumpScene



