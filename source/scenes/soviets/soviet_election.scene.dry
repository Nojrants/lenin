title: Soviet Leadership Election
view-if: year = 1917 and month = 11 and week = 1
go-to: election_algorithm.all_russian_soviet
set-jump: soviet_election.post_election
new-page: true
tags: event

@post_election
on-arrival: {!
Q.soviet_efficacy -= 0.05;
Q.m_in_exco = 0;
Q.sr_in_exco = 0;
Q.b_in_exco = 0;

Q.anarchist_soviet = Q.anarchist_soviet_votes_dec;
Q.maximalist_soviet = Q.maximalist_soviet_votes_dec;
Q.b_soviet = Q.b_soviet_votes_dec;
Q.sdi_soviet = Q.sdi_soviet_votes_dec;
Q.left_m_soviet = Q.left_m_soviet_votes_dec;
Q.m_soviet = Q.m_soviet_votes_dec;
Q.right_m_soviet = Q.right_m_soviet_votes_dec;
Q.lsr_soviet = Q.lsr_soviet_votes_dec;
Q.sr_soviet = Q.sr_soviet_votes_dec;
Q.right_sr_soviet = Q.right_sr_soviet_votes_dec;
Q.popular_socialist_soviet = Q.popular_socialist_soviet_votes_dec;
Q.other_soviet = Math.round(10*(Q.other_soviet_votes_dec + Q.k_soviet_votes_dec + Q.conservative_soviet_votes_dec))/10;

Q.socialist_bloc = Q.anarchist_soviet + Q.maximalist_soviet + Q.b_soviet + Q.sdi_soviet + Q.left_m_soviet + Q.m_soviet + Q.right_m_soviet + Q.lsr_soviet + Q.sr_soviet + Q.right_sr_soviet + Q.popular_socialist_soviet + Q.other_soviet;
Q.october_bloc = Q.anarchist_soviet + Q.maximalist_soviet + Q.b_soviet;
Q.defensist_bloc = Q.m_soviet + Q.right_m_soviet + Q.lsr_soviet + Q.right_sr_soviet;
Q.internationalist_bloc = Q.anarchist_soviet + Q.maximalist_soviet + Q.b_soviet + Q.sdi_soviet + Q.left_m_soviet + Q.m_soviet + Q.lsr_soviet + Q.sr_soviet; 
Q.anti_bolshevik_bloc = Q.sdi_soviet + Q.left_m_soviet + Q.m_soviet + Q.right_m_soviet + Q.lsr_soviet + Q.sr_soviet + Q.right_sr_soviet + Q.popular_socialist_soviet + Q.other_soviet;

console.log("popular socialist raw workers:", Q.workers_popular_socialist);
console.log("popular socialist raw soldiers:", Q.soldiers_popular_socialist);
console.log("popular socialist normalized workers:", Q.workers_popular_socialist_normalized);
console.log("popular socialist normalized soldiers:", Q.soldiers_popular_socialist_normalized);
console.log("popular socialist support:", Q.popular_socialist_support);
console.log("popular socialist vote:", Q.popular_socialist_soviet_votes_dec);

console.log("Q.anarchist_soviet", Q.anarchist_soviet);
console.log("Q.maximalist_soviet", Q.maximalist_soviet);
console.log("Q.b_soviet", Q.b_soviet);
console.log("Q.sdi_soviet", Q.sdi_soviet);
console.log("Q.left_m_soviet", Q.left_m_soviet);
console.log("Q.m_soviet", Q.m_soviet);
console.log("Q.right_m_soviet", Q.right_m_soviet);
console.log("Q.lsr_soviet", Q.lsr_soviet);
console.log("Q.sr_soviet", Q.sr_soviet);
console.log("Q.right_sr_soviet", Q.right_sr_soviet);
console.log("Q.popular_socialist_soviet", Q.popular_socialist_soviet);
console.log("Q.other_soviet", other_soviet);


!}
on-display: {!
// do the graphs
var data = [
{"id": "anarchist",
 "legend": "Anarchist",
 "name": "Anarchist",
 "seats": Math.round(Q.anarchist_soviet*10)},

];
if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("soviet").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#soviet").datum(data).call(parliament);
}
!}


