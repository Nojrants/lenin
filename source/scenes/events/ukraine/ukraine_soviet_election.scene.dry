@ukraine_soviet_results
title: Ukrainian Soviet Congress Elections
new-page: true
view-if: year = 1917 and month = 11
tags: event

= Ukrainian Soviet Elections

- @proceed_election : Await the results...

@proceed_election
on-arrival: {! Q.election_provinces = 'ukraine'; !}
go-to: election_algorithm.soviet
set-jump: election_results

@election_results
new-page: true
on-arrival: {!
if (typeof Q.election_seat_total != 'number' || Q.election_seat_total <= 0) {
    Q.election_seat_total = 500;
}
for (var party of Q.election_parties) {
    Q[party + '_election_r'] = Math.round(Q.election_seat_total * (Q[party + '_election_votes_dec'] || 0) / 100);
}
!}
on-display: {!
var names = {
    anarchist: "Anarchist", maximalist: "Maximalist", b: "Bolshevik", sdi: "SD-Internationalist",
    left_m: "Left Menshevik", m: "Menshevik", right_m: "Right Menshevik", lsr: "Left SR",
    sr: "SR", right_sr: "Right SR", popular_socialist: "Popular Socialist", k: "Kadet",
    rightist: "Rightist", other: "Others", ukrainian_sr: "Ukrainian SR", zionist: "Zionist",
    polish: "Polish", ukrainian_sd: "Ukrainian SD", agrarian: "Agrarian", bundist: "Bundist"
};
var data = [];
var rows = '<tr><th>Party</th><th>Vote Share</th></tr>';
for (var party of Q.election_parties) {
    data.push({"id": party, "legend": names[party], "name": names[party], "seats": Q[party + '_election_r']});
    rows += '<tr><td><div class="party-box box ' + party + '"></div>' + names[party] + '</td><td>' + (Q[party + '_election_votes_dec'] || 0) + '%</td></tr>';
}
data.forEach(function(d) {
    if (!Number.isFinite(d.seats)) {
        console.error("BAD SEAT VALUE", d.id, d.seats);
    }
});
document.getElementById("election_table").innerHTML = rows;
if (window && d3) {
    var width = 625;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("election_chart").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#election_chart").datum(data).call(parliament);
}
!}

= Election Results

{!<svg id="election_chart" viewBox="0 0 625 310"> </svg>!}

{!<table id="election_table" class="soviet-table"></table>!}

- @root: Continue

