{!<tr><td><div class="party-box box ukrainian_sr"></div>Ukrainian SRs</td><td>!}[+ ukrainian_sr_ua_r_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box popular_socialist"></div>Popular Socialists</td><td>!}[+ popular_socialist_ua_r_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box agrarian"></div>Agrarian Parties</td><td>!}[+ agrarian_ua_r_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box polish"></div>Polish Parties</td><td>!}[+ polish_ua_r_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box bundist"></div>Bundists</td><td>!}[+ bundist_ua_r_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box zionist"></div>Zionists</td><td>!}[+ zionist_ua_r_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box rightist"></div>Rightists</td><td>!}[+ rightist_ua_r_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box other"></div>Others</td><td>!}[+ other_ua_r_dec +]%{!</td></tr>!}

{!</table>!}

- @root: Continue
