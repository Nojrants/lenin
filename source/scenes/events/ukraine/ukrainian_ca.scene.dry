= Ukrainian Constituent Assembly

- @proceed_election : Brace ourselves for the results...

@proceed_election
go-to: election_algorithm 
set-jump: election_results


@election_results
go-to: post_election_menu
new-page: true
on-arrival: {!

Q.b_ua_r = Math.round(800*Q.b_ua_assembly_votes_dec/100);
Q.b_ua_r_dec = Q.b_ua_assembly_votes_dec;
Q.m_ua_r = Math.round(800*Q.m_ua_assembly_votes_dec/100);
Q.m_ua_r_dec = Q.m_ua_assembly_votes_dec;
Q.ukrainian_sd_ua_r = Math.round(800*Q.ukrainian_sd_ua_assembly_votes_dec/100);
Q.ukrainian_sd_ua_r_dec = Q.ukrainian_sd_ua_assembly_votes_dec;
Q.lsr_ua_r = Math.round(800*Q.lsr_ua_assembly_votes_dec/100);
Q.lsr_ua_r_dec = Q.lsr_ua_assembly_votes_dec;
Q.sr_ua_r = Math.round(800*Q.sr_ua_assembly_votes_dec/100);
Q.sr_ua_r_dec = Q.sr_ua_assembly_votes_dec;
Q.ukrainian_sr_ua_r = Math.round(800*Q.ukrainian_sr_ua_assembly_votes_dec/100);
Q.ukrainian_sr_ua_r_dec = Q.ukrainian_sr_ua_assembly_votes_dec;
Q.popular_socialist_ua_r = Math.round(800*Q.popular_socialist_ua_assembly_votes_dec/100);
Q.popular_socialist_ua_r_dec = Q.popular_socialist_ua_assembly_votes_dec;
Q.agrarian_ua_r = Math.round(800*Q.agrarian_ua_assembly_votes_dec/100);
Q.agrarian_ua_r_dec = Q.agrarian_ua_assembly_votes_dec;
Q.polish_ua_r = Math.round(800*Q.polish_ua_assembly_votes_dec/100);
Q.polish_ua_r_dec = Q.polish_ua_assembly_votes_dec;
Q.bundist_ua_r = Math.round(800*Q.bundist_ua_assembly_votes_dec/100);
Q.bundist_ua_r_dec = Q.bundist_ua_assembly_votes_dec;
Q.zionist_ua_r = Math.round(800*Q.zionist_ua_assembly_votes_dec/100);
Q.zionist_ua_r_dec = Q.zionist_ua_assembly_votes_dec;
Q.rightist_ua_r = Math.round(800*Q.rightist_ua_assembly_votes_dec/100);
Q.rightist_ua_r_dec = Q.rightist_ua_assembly_votes_dec;
Q.other_ua_r = Math.round(800*Q.other_ua_assembly_votes_dec/100);
Q.other_ua_r_dec = Q.other_ua_assembly_votes_dec;
!}
on-display: {!
var data = [
{"id": "b", "legend": "Bolshevik", "name": "Bolshevik", "seats": Q.b_ua_r},
{"id": "m", "legend": "Menshevik", "name": "Menshevik", "seats": Q.m_ua_r},
{"id": "ukrainian_sd", "legend": "Ukrainian SD", "name": "Ukrainian SD", "seats": Q.ukrainian_sd_ua_r},
{"id": "lsr", "legend": "Left SR", "name": "Left SR", "seats": Q.lsr_ua_r},
{"id": "sr", "legend": "SR", "name": "SR", "seats": Q.sr_ua_r},
{"id": "ukrainian_sr", "legend": "Ukrainian SR", "name": "Ukrainian SR", "seats": Q.ukrainian_sr_ua_r},
{"id": "popular_socialist", "legend": "Popular Socialist", "name": "Popular Socialist", "seats": Q.popular_socialist_ua_r},
{"id": "agrarian", "legend": "Agrarian", "name": "Agrarian", "seats": Q.agrarian_ua_r},
{"id": "polish", "legend": "Polish", "name": "Polish", "seats": Q.polish_ua_r},
{"id": "bundist", "legend": "Bundist", "name": "Bundist", "seats": Q.bundist_ua_r},
{"id": "zionist", "legend": "Zionist", "name": "Zionist", "seats": Q.zionist_ua_r},
{"id": "rightist", "legend": "Rightist", "name": "Rightist", "seats": Q.rightist_ua_r},
{"id": "other", "legend": "Others", "name": "Others", "seats": Q.other_ua_r},
];
if (window && d3) {
    var width = 625;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("ua_assembly_chart").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#ua_assembly_chart").datum(data).call(parliament);
}
!}

