title: All-Russian Congress of Soviets
subtitle: The election results are in...
view-if: soviet_congress_timer = 0 and ca_held = 1
go-to: election_algorithm.all_russian_soviet
set-jump: soviet_election.post_election
new-page: true
tags: event

@post_election
go-to: post_election_menu
on-arrival: {!
  Q.soviet_congress_timer = 24;
  Q.soviet_elections += 1;

  Q.anarchist_soviet = Q.anarchist_soviet_votes_dec;
  Q.maximalist_soviet = Q.maximalist_soviet_votes_dec;
  Q.b_soviet = Q.b_soviet_votes_dec;
  Q.sdi_soviet = Q.sdi_soviet_votes_dec;
  Q.left_m_soviet = Q.left_m_soviet_votes_dec;
  Q.m_soviet = Q.m_soviet_votes_dec;
  Q.right_m_soviet = Q.right_m_soviet_votes_dec;
  Q.lsr_soviet = Q.lsr_soviet_votes_dec;
  Q.sr_soviet = Q.sr_soviet_votes_dec;
  Q.right_sr_soviet = Q.right_sr_soviet_votes_dec;
  Q.popular_socialist_soviet = Q.popular_socialist_soviet_votes_dec;
  Q.other_soviet = Math.round(10*(Q.other_soviet_votes_dec + Q.k_soviet_votes_dec + Q.rightist_soviet_votes_dec))/10;

  Q.b_soviet_display = Math.round(Q.b_soviet*10)/10; 
  Q.m_soviet_display = Math.round((Q.left_m_soviet + Q.m_soviet + Q.right_m_soviet)*10)/10; 
  Q.lsr_soviet_display = Math.round(Q.lsr_soviet*10)/10; 
  Q.sr_soviet_display = Math.round((Q.sr_soviet + Q.right_sr_soviet)*10)/10; 
  Q.other_soviet_display = Math.round((Q.anarchist_soviet + Q.maximalist_soviet + Q.sdi_soviet + Q.popular_socialist_soviet + Q.other_soviet)*10)/10; 
  Q.soviet_chair = "Kamenev"; Q.soviet_chair_party="Bolshevik";

  console.log("other_soviet_votes_dec: ", Q.other_soviet_votes_dec);
  console.log("k_soviet_votes_dec: ", Q.k_soviet_votes_dec);
  console.log("rightist_soviet_votes_dec: ", Q.rightist_soviet_votes_dec);
  console.log("other_soviet: ", Q.other_soviet);
!}
on-display: {!
// do the graphs
var data = [
{"id": "anarchist",
 "legend": "Anarchist",
 "name": "Anarchist",
 "seats": Math.round(Q.anarchist_soviet*10)},
{"id": "maximalist",
 "legend": "SR-Maximalist",
 "name": "SR-Maximalist",
 "seats": Math.round(Q.maximalist_soviet*10)},
{"id": "b",
 "legend": "Bolshevik",
 "name": "Bolshevik",
 "seats": Math.round(Q.b_soviet*10)},
{"id": "sdi",
 "legend": "SD-Internationalist",
 "name": "SD-Internationalist",
 "seats": Math.round(Q.sdi_soviet_votes_dec*10)},
{"id": "left_m",
 "legend": "Menshevik-Internationalist",
 "name": "Menshevik-Internationalist",
 "seats": Math.round(Q.left_m_soviet_votes_dec*10)},
{"id": "m",
 "legend": "Menshevik-Centre",
 "name": "Menshevik-Centre",
 "seats": Math.round(Q.m_soviet_votes_dec*10)},
{"id": "right_m",
 "legend": "Menshevik-Defencist",
 "name": "Menshevik-Defencist",
 "seats": Math.round(Q.right_m_soviet_votes_dec*10)},
{"id": "lsr",
 "legend": "Left-SR",
 "name": "Left-SR",
 "seats": Math.round(Q.lsr_soviet_votes_dec*10)},
{"id": "sr",
 "legend": "SR",
 "name": "SR",
 "seats": Math.round(Q.sr_soviet_votes_dec*10)},
{"id": "right_sr",
 "legend": "Right SR",
 "name": "Right SR",
 "seats": Math.round(Q.right_sr_soviet_votes_dec*10)},
{"id": "popular_socialist",
 "legend": "Popular Socialist",
 "name": "Popular Socialist",
 "seats": Math.round(Q.popular_socialist_soviet_votes_dec*10)},
{"id": "other",
 "legend": "Other",
 "name": "Other",
 "seats": Math.round(Q.other_soviet_votes_dec*10)},
];
if (window && d3) {
    var width = 625;
    var height = 625;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("soviet").style.height = width + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#soviet").datum(data).call(parliament);
}
!}

= Congress of Soviets

