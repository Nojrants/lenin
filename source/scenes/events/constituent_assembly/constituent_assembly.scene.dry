title: The Constituent Assembly
subtitle: Finally, the new Russian government can begin to form...
new-page: true
view-if: ca_election_held = 1 and constituent_assembly_timer = 0 and ca_held = 0
max-visits: 1
tags: event
on-arrival: {!
 Q.ca_held = 1;
 if (Q.stopped_count != 1) Q.delegate_total = 665; else Q.delegate_total = 640;
 Q.ca_seats_bolshevik = Math.round(Q.b_r_dec / 100 * Q.delegate_total * Math.min(1, Q.train_capacity / 150000) * Math.min(1, 50 / Q.instability));
 Q.ca_seats_menshevik = Math.round(Q.m_r_dec / 100 * Q.delegate_total * Math.min(0.75, Q.train_capacity / 150000) * Math.min(1, 50 / Q.instability));
 Q.ca_seats_sr = Math.round(Q.sr_r_dec / 100 * Q.delegate_total * Math.min(1, Q.train_capacity / 150000) * Math.min(1, 50 / Q.instability));
 Q.ca_seats_lsr = Math.round(Q.ca_seats_sr * 0.2); Q.ca_seats_sr = Math.round(Q.ca_seats_sr *= 0.8); 
 Q.ca_seats_ukr = Math.round(Q.ukrainian_sr_r_dec / 100 * Q.delegate_total * Math.min(0.9, Q.train_capacity / 150000) * Math.min(1, 50 / Q.instability));
 Q.ca_seats_ns = Math.round(Q.popular_socialist_r_dec / 100 * Q.delegate_total * Math.min(1, Q.train_capacity / 150000) * Math.min(1, 50 / Q.instability));
 Q.ca_seats_muslim_socialist = Math.round(Q.muslim_socialists_r_dec / 100 * Q.delegate_total * Math.min(0.75, Q.train_capacity / 150000) * Math.min(1, 50 / Q.instability));
 Q.ca_seats_dashnak = Math.round(Q.dashnak_r_dec / 100 * Q.delegate_total * Math.min(0.5, Q.train_capacity / 150000) * Math.min(1, 50 / Q.instability));
 Q.ca_seats_jewish = Math.round(Q.jewish_national_r_dec / 100 * Q.delegate_total * Math.min(0.75, Q.train_capacity / 150000) * Math.min(1, 50 / Q.instability));
 Q.ca_seats_muslim_national = Math.round(Q.muslim_national_r_dec / 100 * Q.delegate_total * Math.min(0.5, Q.train_capacity / 150000) * Math.min(1, 50 / Q.instability));
 Q.ca_seats_kadet = Math.round(Q.k_r_dec / 100 * Q.delegate_total * Math.min(1, Q.train_capacity / 150000) * Math.min(1, 50 / Q.instability));
 Q.ca_seats_cossack = Math.round(Q.cossacks_r_dec / 100 * Q.delegate_total * Math.min(0.5, Q.train_capacity / 150000) * Math.min(1, 50 / Q.instability));
 Q.ca_seats_rightist = Math.round(Q.rightist_r_dec / 100 * Q.delegate_total * Math.min(1, Q.train_capacity / 150000) * Math.min(1, 50 / Q.instability));
 Q.ca_seats_other = Math.round(Q.other_r_dec / 100 * Q.delegate_total * Math.min(1, Q.train_capacity / 150000) * Math.min(1, 50 / Q.instability));

 if (Q.ca_stance == 1) {
   Q.ca_seats_menshevik = Math.round(Q.ca_seats_menshevik * 0.9);
   Q.ca_seats_sr = Math.round(Q.ca_seats_sr * 0.9);
   Q.ca_seats_ukr = Math.round(Q.ca_seats_ukr * 0.95);
   Q.ca_seats_ns = Math.round(Q.ca_seats_ns * 0.9); 
   Q.ca_seats_muslim_socialist = Math.round(Q.ca_seats_muslim_socialist * 0.8); 
   Q.ca_seats_dashnak = Math.round(Q.ca_seats_dashnak * 0.9); 
   Q.ca_seats_jewish = Math.round(Q.ca_seats_jewish * 0.9); 
   Q.ca_seats_muslim_national = Math.round(Q.ca_seats_muslim_national * 0.7); 
   Q.ca_seats_kadet = Math.round(Q.ca_seats_kadet * 0); 
   Q.ca_seats_cossack = Math.round(Q.ca_seats_cossack * 0.5); 
   Q.ca_seats_rightist = Math.round(Q.ca_seats_rightist * 0.2);
   Q.ca_seats_other = Math.round(Q.ca_seats_other * 0.9); 
 }
 if (Q.cheka_founded == 1) {
   Q.ca_seats_menshevik = Math.round(Q.ca_seats_menshevik * 0.9);
   Q.ca_seats_sr = Math.round(Q.ca_seats_sr * 0.9);
   Q.ca_seats_ukr = Math.round(Q.ca_seats_ukr * 0.9);
   Q.ca_seats_ns = Math.round(Q.ca_seats_ns * 0.9); 
   Q.ca_seats_muslim_socialist = Math.round(Q.ca_seats_muslim_socialist * 0.9); 
   Q.ca_seats_dashnak = Math.round(Q.ca_seats_dashnak * 0.9); 
   Q.ca_seats_jewish = Math.round(Q.ca_seats_jewish * 0.9); 
   Q.ca_seats_muslim_national = Math.round(Q.ca_seats_muslim_national * 0.9); 
   Q.ca_seats_kadet = Math.round(Q.ca_seats_kadet * 0.1); 
   Q.ca_seats_cossack = Math.round(Q.ca_seats_cossack * 0.5); 
   Q.ca_seats_rightist = Math.round(Q.ca_seats_rightist * 0.2);
   Q.ca_seats_other = Math.round(Q.ca_seats_other * 0.95); 
 }
Q.ca_empty = 765 - Q.ca_seats_bolshevik - Q.ca_seats_menshevik - Q.ca_seats_lsr - Q.ca_seats_sr - Q.ca_seats_ukr - Q.ca_seats_ns - Q.ca_seats_muslim_socialist - Q.ca_seats_dashnak - Q.ca_seats_jewish - Q.ca_seats_muslim_national - Q.ca_seats_kadet - Q.ca_seats_cossack - Q.ca_seats_rightist - Q.ca_seats_other;  

!}
on-display: {!
// do the graphs
var data = [
{"id": "b",
 "legend": "Bolshevik",
 "name": "Bolshevik",
 "seats": Q.ca_seats_bolshevik},
];
data.push({
    "id": "m",
    "legend": "Menshevik",
    "name": "Menshevik",
    "seats": Q.ca_seats_menshevik
});
data.push({
    "id": "lsr",
    "legend": "Left-SR",
    "name": "Left-SR",
    "seats": Q.ca_seats_lsr
});
data.push({
    "id": "sr",
    "legend": "SR",
    "name": "SR",
    "seats": Q.ca_seats_sr
});
data.push({
  "id": "ukrainian_sr",
  "legend": "Ukrainian SR",
  "name": "Ukrainian SR",
  "seats": Q.ca_seats_ukr
});
data.push({
  "id": "popular_socialist",
  "legend": "Popular Socialist",
  "name": "Popular Socialist",
  "seats": Q.ca_seats_ns
});
data.push({
  "id": "muslim_socialist",
  "legend": "Muslim Socialist",
  "name": "Muslim Socialist",
  "seats": Q.ca_seats_muslim_socialist
});
data.push({
  "id": "dashnak",
  "legend": "Dashnak",
  "name": "Dashnak",
  "seats": Q.ca_seats_dashnak
});
data.push({
  "id": "jewish_national",
  "legend": "Jewish National",
  "name": "Jewish National",
  "seats": Q.ca_seats_jewish
});
data.push({
  "id": "muslim_national",
  "legend": "Muslim National",
  "name": "Muslim National",
  "seats": Q.ca_seats_muslim_national
});
data.push({
  "id": "k",
  "legend": "Kadet",
  "name": "Kadet",
  "seats": Q.ca_seats_kadet
});
data.push({
  "id": "cossack",
  "legend": "Cossack",
  "name": "Cossack",
  "seats": Q.ca_seats_cossack
});
data.push({
  "id": "rightist",
  "legend": "Rightist",
  "name": "Rightist",
  "seats": Q.ca_seats_rightist
});
data.push({
  "id": "other",
  "legend": "Others",
  "name": "Others",
  "seats": Q.ca_seats_other
});
data.push({
  "id": "none",
  "legend": "Vacant",
  "name": "Vacant",
  "seats": Q.ca_empty
});
if (window && d3) {
    console.log(data);
    var width = 625;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("constituent_assembly").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
data.forEach(d => {
    if (!Number.isFinite(d.seats)) {
        console.error("BAD SEAT VALUE", d.id, d.seats);
    }
});
    d3.select("#constituent_assembly").datum(data).call(parliament);
}
!}

= The Constituent Assembly

{!<svg id="constituent_assembly" style="width: 625px; height: 350px;"> </svg>!}
{!<table class="soviet-table">!}
{!<tr><th>Party</th><th>Seats</th></tr>!}

{!<tr><td><div class="party-box box b"></div>Bolsheviks</td><td>!}[+ ca_seats_bolshevik +]{!</td></tr>!}

{!<tr><td><div class="party-box box m"></div>Mensheviks</td><td>!}[+ ca_seats_menshevik +]{!</td></tr>!}

{!<tr><td><div class="party-box box lsr"></div>Left-SRs</td><td>!}[+ ca_seats_lsr +]{!</td></tr>!}

{!<tr><td><div class="party-box box sr"></div>SRs</td><td>!}[+ ca_seats_sr +]{!</td></tr>!}

{!<tr><td><div class="party-box box ukrainian_sr"></div>Ukrainian SRs</td><td>!}[+ ca_seats_ukr +]{!</td></tr>!}

{!<tr><td><div class="party-box box popular_socialist"></div>Popular Socialists</td><td>!}[+ ca_seats_ns +]{!</td></tr>!}

{!<tr><td><div class="party-box box muslim_socialist"></div>Muslim Socialists</td><td>!}[+ ca_seats_muslim_socialist +]{!</td></tr>!}

{!<tr><td><div class="party-box box dashnak"></div>Dashnaks</td><td>!}[+ ca_seats_dashnak +]{!</td></tr>!}

{!<tr><td><div class="party-box box jewish_national"></div>Jewish National List</td><td>!}[+ ca_seats_jewish +]{!</td></tr>!}

{!<tr><td><div class="party-box box muslim_national"></div>Muslim national parties</td><td>!}[+ ca_seats_muslim_national +]{!</td></tr>!}

{!<tr><td><div class="party-box box k"></div>Kadets</td><td>!}[+ ca_seats_kadet +]{!</td></tr>!}

{!<tr><td><div class="party-box box cossack"></div>Cossacks</td><td>!}[+ ca_seats_cossack +]{!</td></tr>!}

{!<tr><td><div class="party-box box rightist"></div>Rightists</td><td>!}[+ ca_seats_rightist +]{!</td></tr>!}

{!<tr><td><div class="party-box box other"></div>Others</td><td>!}[+ ca_seats_other +]{!</td></tr>!}

{!<tr><td><div class="party-box box none"></div>Vacant</td><td>!}[+ ca_empty +]{!</td></tr>!}

{!</table>!}



A great number of the seats are empty. In some constituencies, the elections never completed, and so no one was elected at all. Others completed their elections, but their delegates are still in transit to the capital. And a great many delegates have simply not shown up, either because they have little regard for the Assembly's prospects, or because they fear they will be arrested should they appear. Indeed, several delegates would have shown, but are currently sitting in our jails. [?if ca_stance == 1: Our efforts to delegitimize the Assembly have surely increased the number of absentee seats. ?] But despite all of that, the Bolsheviks still lack a majority, meaning we will have to tread carefully. 

The first order of business is electing a chairperson. The SRs have nominated Viktor Chernov, and he has received the backing of most other party delegations. Anticipating that a Bolshevik candidate will be the least likely to succeed, the Party considers it wise to instead back the Left-SR candidate, Maria Spiridonova. Not only does this have the chance of attracting some outside support, it will show solidarity with the Left-SRs, whose alliance here will likely be crucial. Though the Bolshevik Moderates would have liked to see Kamenev as chair, they are on board with backing with Spiridonova.  

- @spiridonova
- @kamenev
- @sverdlov

@spiridonova
title: Back the Left-SR candidate, Maria Spiridonova.
on-arrival: {!
 Q.lsr_relation += 5;
 Q.vote_chernov = Math.round(Q.ca_seats_sr + Q.ca_seats_menshevik + (Q.ca_seats_ukr * 0.95) + Q.ca_seats_ns + ((Q.ca_seats_muslim_socialist + Q.ca_seats_dashnak + Q.ca_seats_jewish + Q.ca_seats_muslim_national) * 0.9) + Q.ca_seats_kadet + Q.ca_seats_cossack + Q.ca_seats_rightist + (Q.ca_seats_other * 0.8));
 Q.vote_spiridonova = Math.round(Q.ca_seats_bolshevik + Q.ca_seats_lsr + (Q.ca_seats_ukr * 0.05) + ((Q.ca_seats_muslim_socialist + Q.ca_seats_dashnak + Q.ca_seats_jewish + Q.ca_seats_muslim_national) * 0.1) + (Q.ca_seats_other * 0.2));
!}
go-to: chairperson_result

@kamenev
title: Nominate the Moderate Bolshevik, Lev Kamenev. 
choose-if: kamenev_available != 0
unavailable-subtitle: Kamenev is absent from the proceedings. 
on-arrival: {!
 Q.moderate_strength += 5; Q.moderate_unrest -= 5; 
 Q.vote_chernov = Math.round(Q.ca_seats_sr + Q.ca_seats_menshevik + (Q.ca_seats_ukr * 0.95) + Q.ca_seats_ns + ((Q.ca_seats_muslim_socialist + Q.ca_seats_dashnak + Q.ca_seats_jewish + Q.ca_seats_muslim_national) * 0.9) + Q.ca_seats_kadet + Q.ca_seats_cossack + Q.ca_seats_rightist + (Q.ca_seats_other * 0.8));
 Q.vote_spiridonova = Math.round(Q.ca_seats_lsr + (Q.ca_seats_ukr * 0.025) + ((Q.ca_seats_muslim_socialist + Q.ca_seats_dashnak + Q.ca_seats_jewish + Q.ca_seats_muslim_national) * 0.075) + (Q.ca_seats_other * 0.1));
 Q.vote_kamenev = Math.round(Q.ca_seats_bolshevik + (Q.ca_seats_ukr * 0.025) + ((Q.ca_seats_muslim_socialist + Q.ca_seats_dashnak + Q.ca_seats_jewish + Q.ca_seats_muslim_national) * 0.025) + (Q.ca_seats_other * 0.1));
!}
go-to: chairperson_result

@sverdlov
title: Nominate the Leninist, Yakov Sverdlov. 
on-arrival: {!
 Q.moderate_unrest += 5; 
 Q.vote_chernov = Math.round(Q.ca_seats_sr + Q.ca_seats_menshevik + (Q.ca_seats_ukr * 0.95) + Q.ca_seats_ns + ((Q.ca_seats_muslim_socialist + Q.ca_seats_dashnak + Q.ca_seats_jewish + Q.ca_seats_muslim_national) * 0.9) + Q.ca_seats_kadet + Q.ca_seats_cossack + Q.ca_seats_rightist + (Q.ca_seats_other * 0.8));
 Q.vote_spiridonova = Math.round(Q.ca_seats_lsr + (Q.ca_seats_ukr * 0.05) + ((Q.ca_seats_muslim_socialist + Q.ca_seats_dashnak + Q.ca_seats_jewish + Q.ca_seats_muslim_national) * 0.1) + (Q.ca_seats_other * 0.15));
 Q.vote_sverdlov = Math.round(Q.ca_seats_bolshevik + (Q.ca_seats_other * 0.05));
!}
go-to: chairperson_result



@chairperson_result
title: Chairperson Result
on-display: {!
// Create bar graph data
var data = [
    {
        "id": "sr",
        "legend": "Chernov",
        "name": "Chernov",
        "votes": Q.vote_chernov
    }
];

if (Q.vote_spiridonova != undefined) {
    data.push({
        "id": "lsr",
        "legend": "Spiridonova",
        "name": "Spiridonova",
        "votes": Q.vote_spiridonova
    });
}

if (Q.vote_kamenev != undefined) {
    data.push({
        "id": "b",
        "legend": "Kamenev",
        "name": "Kamenev",
        "votes": Q.vote_kamenev
    });
}

if (Q.vote_sverdlov != undefined) {
    data.push({
        "id": "b",
        "legend": "Sverdlov",
        "name": "Sverdlov",
        "votes": Q.vote_sverdlov
    });
}

var width = 625;
var height = 400;

var svg = d3.select("#vote_chart");

svg.attr("width", width)
   .attr("height", height);

var margin = {
    top: 30,
    right: 30,
    bottom: 60,
    left: 60
};

var chartWidth = width - margin.left - margin.right;
var chartHeight = height - margin.top - margin.bottom;

var x = d3.scaleBand()
    .domain(data.map(function(d) { return d.name; }))
    .range([0, chartWidth])
    .padding(0.3);

var y = d3.scaleLinear()
    .domain([0, d3.max(data, function(d) { return d.votes; })])
    .nice()
    .range([chartHeight, 0]);

var g = svg.append("g")
    .attr("transform", "translate(" + margin.left + "," + margin.top + ")");

g.append("g")
    .attr("transform", "translate(0," + chartHeight + ")")
    .call(d3.axisBottom(x))
    .selectAll("text")
    .style("font-size", "16px");

g.append("g")
    .call(d3.axisLeft(y));

g.selectAll(".bar")
    .data(data)
    .enter()
    .append("rect")
    .attr("class", function(d) { return "bar " + d.id; })
    .attr("x", function(d) { return x(d.name); })
    .attr("y", function(d) { return y(d.votes); })
    .attr("width", x.bandwidth())
    .attr("height", function(d) { return chartHeight - y(d.votes); });

g.selectAll(".label")
    .data(data)
    .enter()
    .append("text")
    .attr("class", "label")
    .attr("x", function(d) { return x(d.name) + x.bandwidth() / 2; })
    .attr("y", function(d) { return y(d.votes) - 10; })
    .attr("text-anchor", "middle")
    .text(function(d) { return d.votes; });
!}

= Chairperson Election

{!<svg id="vote_chart" style="width: 625px; height: 400px;"></svg>!}

[?if vote_chernov > vote_spiridonova : Chernov is elected chairman, giving the SRs control over proceedings. In his keynote address, he describes an ambitious socialist program – including full socialization of the land, immediate peace negotiations, and worker democracy in industry – that is to be put into place by the Constituent Assembly. ?]

- @program_vote

@program_vote
title: Proceed...
new-page: true
on-arrival: {!
 Q.vote_sr = Math.round(Q.ca_seats_sr + Q.ca_seats_menshevik + (Q.ca_seats_ukr * 0.8) + Q.ca_seats_ns + ((Q.ca_seats_muslim_socialist + Q.ca_seats_dashnak + Q.ca_seats_jewish + Q.ca_seats_muslim_national) * 0.9) + Q.ca_seats_kadet + Q.ca_seats_cossack + Q.ca_seats_rightist + (Q.ca_seats_other * 0.75));
 Q.vote_bolshevik = Math.round(Q.ca_seats_bolshevik + (Q.ca_seats_lsr * 0.7) + (Q.ca_seats_ukr * 0.15) + ((Q.ca_seats_muslim_socialist + Q.ca_seats_dashnak + Q.ca_seats_jewish + Q.ca_seats_muslim_national) * 0.05) + (Q.ca_seats_other * 0.15));
 Q.vote_other = Math.round((Q.ca_seats_lsr * 0.3) + (Q.ca_seats_ukr * 0.05) + ((Q.ca_seats_muslim_socialist + Q.ca_seats_dashnak + Q.ca_seats_jewish + Q.ca_seats_muslim_national) * 0.05) + (Q.ca_seats_other * 0.1));
!}

= Vote on the Programs

Lenin has prepared a document, known as the "Declaration of the Rights of Toiling and Exploited People", which he intends to give to the Assembly for an immediate vote, without taking any comments or amendments. In addition to affirming the goals of the Bolshevik program, this declaration explicitly recognizes the supremacy of the soviet government, and calls for the Constituent Assembly to be dissolved. In effect, Lenin is forcing the Constituent Assembly to either immediately back his government, or discredit itself by having to vote no to the rest of the declaration. 

Meanwhile the SRs have prepared a full first-day agenda, which calls for discussion and review of legislation on peace, land and state power in ordered sequence. 

These two items are now being directly juxtaposed: either a vote for the Declaration, or a vote to proceed with the SR agenda. 


- @vote_yes

@vote_yes
title: The Bolsheviks vote for the Declaration. 
go-to: program_result


