title: Financial Report
subtitle: Monthly accounting
new-page: true
view-if: report_timer = 0
tags: event
on-arrival: {!
  Q.report_timer = 4;
  Q.income_tax_display = Math.round(100 * Q.income_tax)/100;
  Q.property_tax_display = Math.round(100 * Q.property_tax)/100;
  Q.business_tax_display = Math.round(100 * Q.business_tax)/100;
  Q.monopolies_display = Math.round(100 * Q.monopolies)/100;
  Q.customs_display = Math.round(100 * Q.customs)/100;
  Q.taxation_display = Math.round(100 * Q.income_tax_display + Q.property_tax_display + Q.business_tax_display + Q.monopolies_display + Q.customs_display)/100;
  Q.government_functions_display = Math.round(100 * Q.government_functions)/100;

  Q.interest = 0;
  for (var loans of Q.loans) {
      Q.interest += loans.principal * loans.rate;
  }
  Q.interest += (
      (Q.bonds * (Q.bond_rate / 100)) +
      (Q.bank_advances * 0.02)
  );
  Q.interest_display = Math.round(100 * Q.interest)/100;

  Q.indemnities_display = Math.round(100 * Q.indemnities)/100;
  Q.surplus_display = Math.round(100 * Q.resources + Q.income - Q.expenditure)/100;
  Q.bond_sale = Math.round(5 - (Q.bonds / 30)); 
!}

= Financial Report

<div style="display:flex; flex-wrap:wrap; gap:20px; align-items:stretch;">
  <div style="flex:1; min-width:300px; border:2px solid #666; border-radius:6px; padding:12px;">
<div style="font-size:1.2em; font-weight:bold; text-align:center; margin-bottom:8px;">
  Revenue
</div>
<hr>
<b>Total Revenue</b> — <span style="color: var(--level1-color);">[+ income +]</span>
<hr>
<b>Taxation</b> — <span style="color: var(--level1-color);">[+ taxation_display +]</span>
<ul style="margin-top:6px; margin-bottom:0; padding-left:20px;">
  <li style="margin-bottom:4px;">Income Tax: <span style="color: var(--level1-color);">[+ income_tax_display +]</span></li>
  <li style="margin-bottom:4px;">Property Tax: <span style="color: var(--level1-color);">[+ property_tax_display +]</span></li>
  <li style="margin-bottom:4px;">Business Tax: <span style="color: var(--level1-color);">[+ business_tax_display +]</span></li>
  <li style="margin-bottom:4px;">Monopolies: <span style="color: var(--level1-color);">[+ monopolies_display +]</span></li>
  <li style="margin-bottom:0;">Customs Duties: <span style="color: var(--level1-color);">[+ customs_display +]</span></li>
</ul>
<br>
<b>State Enterprises</b> — <span style="color: var(--level1-color);">[+ (railway_revenue + enterprises_revenue) +]</span>
<ul style="margin-top:6px; margin-bottom:0; padding-left:20px;">
  <li style="margin-bottom:8px;">Railways: <span style="color: var(--level1-color);">[+ railway_revenue +]</span></li>
  <li style="margin-bottom:0;">Other Enterprises: <span style="color: var(--level1-color);">[+ enterprises_revenue +]</span></li>
</ul>
  </div>
  <div style="flex:1; min-width:300px; border:2px solid #666; border-radius:6px; padding:12px;">
<div style="font-size:1.2em; font-weight:bold; text-align:center; margin-bottom:8px;">
  Expenditure
</div>
<hr>
<b>Total Expenditure</b> — <span style="color: var(--level7-color);">[+ expenditure +]</span>
<hr>
<b>Government Functions</b> — <span style="color: var(--level7-color);">[+ government_functions_display +]</span>
<ul style="margin-top:6px; margin-bottom:0; padding-left:20px;">
  <li style="margin-bottom:4px;">Sovnarkom: <span style="color: var(--level7-color);">[+ sovnarkom_expend +]</span></li>
  <li style="margin-bottom:4px;">Foreign Affairs: <span style="color: var(--level7-color);">[+ foreignaffairs_expend +]</span></li>
  <li style="margin-bottom:4px;">Military: <span style="color: var(--level7-color);">[+ military_expend +]</span></li>
  <li style="margin-bottom:4px;">Enlightenment: <span style="color: var(--level7-color);">[+ enlightenment_expend +]</span></li>
  <li style="margin-bottom:4px;">Internal Affairs: <span style="color: var(--level7-color);">[+ internal_expend +]</span></li>
  <li style="margin-bottom:4px;">Railways: <span style="color: var(--level7-color);">[+ railways_expend +]</span></li>
  <li style="margin-bottom:4px;">Trade: <span style="color: var(--level7-color);">[+ trade_expend +]</span></li>
  <li style="margin-bottom:4px;">Finance: <span style="color: var(--level7-color);">[+ finance_expend +]</span></li>
  <li style="margin-bottom:4px;">Justice: <span style="color: var(--level7-color);">[+ justice_expend +]</span></li>
  <li style="margin-bottom:4px;">Labor: <span style="color: var(--level7-color);">[+ labor_expend +]</span></li>
  <li style="margin-bottom:4px;">Agriculture: <span style="color: var(--level7-color);">[+ agriculture_expend +]</span></li>
  <li style="margin-bottom:4px;">Food Supply: <span style="color: var(--level7-color);">[+ foodsupply_expend +]</span></li>
  <li style="margin-bottom:4px;">Nationalities: <span style="color: var(--level7-color);">[+ nationalities_expend +]</span></li>
  <li style="margin-bottom:0;">Welfare: <span style="color: var(--level7-color);">[+ welfare_expend +]</span></li>
</ul>
<hr>
<b>Other Obligations</b> — <span style="color: var(--level7-color);">[+ (interest_display + indemnities_display) +]</span>
<ul style="margin-top:6px; margin-bottom:0; padding-left:20px;">
  <li style="margin-bottom:8px;">Interest Payments: <span style="color: var(--level7-color);">[+ interest_display +]</span></li>
  <li style="margin-bottom:0;">Indemnities: <span style="color: var(--level7-color);">[+ indemnities_display +]</span></li>
</ul>
  </div>
  <div style="flex-basis:100%; border:2px solid #666; border-radius:6px; padding:12px;">
<div style="display:flex; justify-content:space-between; margin:8px 20px;">
  <b>Treasury</b>
  [+ resources +]
</div>
<div style="display:flex; justify-content:space-between; margin:8px 20px;">
  <b>Total Revenue</b>
  <span style="color: var(--level1-color);">+ [+ income +]</span>
</div>
<div style="display:flex; justify-content:space-between; margin:8px 20px;">
  <b>Total Expenditure</b>
  <span style="color: var(--level7-color);">- [+ expenditure +]</span>
</div>
<hr>
<div style="display:flex; justify-content:space-between; margin:8px 20px; font-size:1.1em;">
  <b>Surplus / Deficit</b>
  <span>[?if surplus_display > 0 : <span style="color: var(--level1-color);">+ [+ surplus_display +]</span>?][?if surplus_display < 0 : <span style="color: var(--level7-color);">- [+ surplus_display +]</span>?][?if surplus_display == 0 : [+ surplus_display +] ?]</span>
</div>
  </div>
</div>



- @budget_balancing
- @report_accept

@budget_balancing
title: Balance the budget
subtitle: We will have to make up the difference somehow. 
view-if: expenditure > (income + resources)
go-to: budget_balancing_menu


@budget_balancing_menu

- #budget_balancing


@issue_currency
title: Issue additional currency. 
choose-if: banks_seized = 1
unavailable-subtitle: We lack control over the banks. 
subtitle: +5 resources
tags: budget_balancing
on-arrival: resources += 5; monthly_inflation += (1.2 * (instability/12.5)); instability += 1;
go-to: finance_report

@bank_advances
title: Borrow from the State Bank.
choose-if: banks_seized = 1
unavailable-subtitle: We lack control over the banks. 
subtitle: +5 resources
tags: budget_balancing
on-arrival: resources += 5; bank_advances += 5; monthly_inflation += (1.2 * (instability/25)); instability += 0.25;
go-to: finance_report

@emergency_bonds
title: Issue emergency bonds
subtitle: +[+ bond_sale +] resources – Existing debt lowers bond sales. 
tags: budget_balancing
go-to: finance_report
on-arrival: {!
  Q.bonds += Q.bond_sale; Q.resources += Q.bond_sale;
  Q.bond_sale = Math.max(1, Math.round(5 - (Q.bonds / 30))); 
  Q.instability += 0.5; Q.monthly_inflation += (1.2 * (Q.instability/50));
  if (Q.bonds > 90) Q.bond_rate += 1;
  if ((Q.bonds < 90) && (Q.bonds > 60)) Q.bond_rate += 0.5;
  if (bonds < 60) bond_rate += 0.25; 
!}

@emergency_loans
title: Seek-out foreign loans
go-to: emergency_loans_menu
tags: budget_balancing

@emergency_loans_menu
on-arrival: {!
  Q.uk_offer = Math.max(0, Math.round((Q.uk_relation / 10) - ((Q.loans_high + Q.loans_med + Q.loans_l0) / 10)));
  Q.uk_rate = Math.max(3, Math.round(((Q.loans_high + Q.loans_med + Q.loans_l0) / 1.5) - (Q.uk_relation / 25) + (Q.instability /40)));
!}

- #emergency_loans
- @cancel_loans

@emergency_loan_uk
title: United Kingdom
subtitle: +[+ uk_offer +] at [+ uk_rate +]% interest rate. 
unavailable-subtitle: They are unwilling to loan to us right now. 
choose-if: uk_relation > 50 and uk_offer > 0
tags: emergency_loans
go-to: emergency_loans_menu
on-arrival: {!
  Q.uk_relation -= 5; 
  Q.resources += uk_offer;
  Q.debt.push({
    principal: Q.uk_offer,
    rate: Q.uk_rate,
    lender: "Britain"
  });
!}



@cancel_loans
title: Cancel action
go-to: budget_balancing_menu


@organize_expropriations
title: Conduct emergency expropriations from the elites. 
choose-if: elites_wealth > 5
unavailable-subtitle: There is nothing left to expropriate. 
tags: budget_balancing
go-to: finance_report
on-arrival: {!
  if (Q.elites_wealth >= 30) {
    Q.elites_wealth -= 2;
    Q.resources += 1;
  }
  if (Q.elites_wealth >= 20) {
    Q.elites_wealth -= 2;
    Q.resources += 1;
  }
  if (Q.elites_wealth >= 10) {
    Q.elites_wealth -= 1;
    Q.resources += 1;
  }
  if (Q.middle_wealth >= 20) {
    Q.middle_wealth -= 2;
    Q.resources += 1;
  }
  Q.elites_wealth -= 1; Q.resources += 1;
  Q.capital_flight_progress += 0.5; Q.monthly_inflation *= 0.95; Q.instability += 2;
  Q.elites_unrest += 5; Q.middle_unrest += 2.5; Q.workers_unrest -= 5; Q.peasants_unrest -= 5; Q.kulaks_unrest -= 5; Q.intelligentsia_unrest += 2; 
!}

@raise_taxes 
title: Raise current taxation rates across the board. 
choose-if: finance_minister_party = "Bolshevik"
unavailable-subtitle: We don't control financial policy. 
tags: budget_balancing
go-to: finance_report
on-arrival: {!
  Q.wealth_tax_rate += 0.5; Q.business_tax_rate += 0.5; 
  Q.income_tax_rate_1 += 0.5; Q.income_tax_rate_2 += 0.5; Q.income_tax_rate_3 += 0.5; Q.income_tax_rate_4 += 0.5; Q.income_tax_rate_5 += 0.5;
  Q.capital_flight_progress += 0.5; Q.monthly_inflation *= 0.85;
  if (Q.income_tax_rate_1 >= 2.5) Q.capital_flight_progress += 1;
  Q.elites_unrest += 2.5; Q.middle_unrest += 2.5; Q.workers_unrest += 5; Q.peasants_unrest += 5; Q.kulaks_unrest += 5;
!}

@slash_welfare
title: Cut funding for welfare programs.  
choose-if: welfare_minister_party = "Bolshevik" and welfare_expend > 0.25
unavailable-subtitle: [?if welfare_minister_party != "Bolshevik" : We don't control welfare policy. ?][?if welfare_expend <= 0.25 : Welfare is already negligable. ?]
tags: budget_balancing
go-to: finance_report
on-arrival: {!
  Q.welfare_expend *= 0.5; 
  Q.workers_unrest += 5; Q.underclass_unrest += 10;
  Q.monthly_inflation *= 0.9;
!}

@austerity
title: Impose a program of full austerity.
subtitle: Raise taxes, cut government spending.
view-if: prime_minister_party = "Bolshevik" or finance_minister_party = "Bolshevik"
tags: budget_balancing
go-to: finance_report
on-arrival: {!
  Q.wealth_tax_rate += 0.25; Q.business_tax_rate += 0.25; 
  Q.income_tax_rate_1 += 0.25; Q.income_tax_rate_2 += 0.25; Q.income_tax_rate_3 += 0.25; Q.income_tax_rate_4 += 0.25; Q.income_tax_rate_5 += 0.25;
  Q.capital_flight_progress += 0.25; Q.train_capacity *= 0.999; 
  Q.elites_unrest += 2.5; Q.middle_unrest += 2.5; Q.workers_unrest += 5; Q.peasants_unrest += 5; Q.kulaks_unrest += 5;
  Q.efficacy_finance -= 0.1; Q.efficacy_foreign -= 0.1; Q.efficacy_military -= 0.1; Q.efficacy_enlightenment -= 0.1; Q.efficacy_internal -= 0.1; Q.efficacy_railways -= 0.1; Q.efficacy_trade -= 0.1; Q.efficacy_justice -= 0.1; Q.efficacy_agriculture -= 0.1; Q.efficacy_foodsupply -= 0.1; Q.efficacy_nationalities -= 0.1; Q.efficacy_welfare -= 0.1;
  Q.foreignaffairs_expend -= 0.25; Q.military_expend -= 0.25; Q.enlightmenet_expend -= 0.25; Q.railways_expend -= 0.25; Q.trade_expend -= 0.25; Q.finance_expend -= 0.25; Q.justice_expend -= 0.25; Q.agriculture_expend -= 0.25; Q.foodsupply_expend -= 0.25; Q.nationalities_expend -= 0.25;
  Q.welfare_expend *= 0.5;
  Q.monthly_inflation *= 0.8; 
!}






  

@report_accept
title: Accept the report. 
choose-if: expenditure <= (income + resources)
unavailable-subtitle: We haven't balanced the budget. 
on-arrival: {!
    Q.resources += (Q.income - Q.expenditure);
!}
go-to: root

  



  
