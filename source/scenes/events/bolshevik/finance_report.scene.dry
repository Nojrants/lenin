title: Financial Report
subtitle: Monthly accounting
new-page: true
view-if: report_timer = 0
tags: event
on-arrival: {!
  Q.report_timer = 4;
  Q.income_tax_display = Math.round(100 * Q.income_tax)/100;
  Q.property_tax_display = Math.round(100 * Q.property_tax)/100;
  Q.business_tax_display = Math.round(100 * Q.business_tax)/100;
  Q.monopolies_display = Math.round(100 * Q.monopolies)/100;
  Q.customs_display = Math.round(100 * Q.customs)/100;
  Q.taxation_display = Q.income_tax_display + Q.property_tax_display + Q.business_tax_display + Q.monopolies_display + Q.customs_display;
  Q.government_functions_display = Math.round(100 * Q.government_functions)/100;
  Q.interest_display = Math.round(100 * Q.interest)/100;
  Q.indemnities_display = Math.round(100 * Q.indemnities)/100;
  Q.surplus_display = Math.round(100 * Q.resources + Q.income - Q.expenditure)/100;
!}

= Financial Report

<table style="width:100%; table-layout:fixed; border-collapse:collapse;">
<tr>

<td style="width:50%; vertical-align:top; padding:5px;">

  <div style="border:2px solid #666; border-radius:6px; padding:0; margin-bottom:10px; font-size:0.85em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:4px 6px; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Macroeconomy
    </div>

    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Economic Growth</b><span style="float:right;">[+ gdp_growth_display +]</span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Inflation</b><span style="float:right;">[+ monthly_inflation_disp +]% ([+ inflation_disp +]% p.a.)</span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Unemployment</b><span style="float:right;">[+ unemployment_display +]</span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>National Debt</b><span style="float:right;">[+ national_debt_display +]</span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Budget Balance</b><span style="float:right;">[+ budget_balance_display +]</span></div>
  </div>

  <div style="border:2px solid #666; border-radius:6px; padding:0; margin-bottom:10px; font-size:0.85em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:4px 6px; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Production
    </div>

    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Industrial Output</b><span style="float:right;">[+ industrial_output_display +]</span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Agricultural Output</b><span style="float:right;">[+ agricultural_output_display +]</span></div>
    <div style="padding:3px 8px; line-height:1.2; white-space:nowrap;"><b>Factory Utilization</b><span style="float:right;">[+ factory_utilization_display +]</span></div>
    <div style="padding:3px 8px; line-height:1.2; background:rgba(215,205,180,0.12); white-space:nowrap;"><b>Rail Capacity</b><span style="float:right;">[+ rail_capacity_display +]</span></div>
  </div>

  <div style="border:2px solid #666; border-radius:6px; padding:0; font-size:0.85em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:4px 6px; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Balance of Payments
    </div>

    <div style="display:flex; gap:4px; padding:0 3px; border-bottom:1px solid #666;">
      <div style="flex:1; min-width:0; padding:3px 0; text-align:center; font-weight:bold; white-space:nowrap;">
        Current Account
      </div>
      <div style="flex:1; min-width:0; padding:3px 0; text-align:center; font-weight:bold; white-space:nowrap;">
        Capital Account
      </div>
    </div>

    <div style="display:flex; align-items:flex-start; gap:4px; padding:0 3px 4px 3px;">

      <div style="flex:1; min-width:0;">
        <div style="padding:3px 0; white-space:nowrap; border-bottom:1px dotted #aaa;">Merchandise Exports<span style="float:right;">[+ exports_display +]</span></div>
        <div style="padding:3px 0; white-space:nowrap; background:rgba(215,205,180,0.12); border-bottom:1px dotted #aaa;">Merchandise Imports<span style="float:right;">[+ imports_display +]</span></div>
        <div style="padding:3px 0; white-space:nowrap; border-bottom:1px dotted #aaa;">Trade Balance<span style="float:right;">[+ trade_balance_display +]</span></div>
        <div style="padding:3px 0; white-space:nowrap; background:rgba(215,205,180,0.12); border-bottom:1px dotted #aaa;">Services &amp; Income, Net<span style="float:right;">[+ services_income_display +]</span></div>
        <div style="padding:4px 0; white-space:nowrap; border-top:2px solid #666;"><b>Current Account</b><span style="float:right;">[+ current_account_display +]</span></div>
      </div>

      <div style="flex:1; min-width:0;">
        <div style="padding:3px 0; white-space:nowrap; border-bottom:1px dotted #aaa;">Long-Term Capital, Net<span style="float:right;">[+ long_term_capital_display +]</span></div>
        <div style="padding:3px 0; white-space:nowrap; background:rgba(215,205,180,0.12); border-bottom:1px dotted #aaa;">Short-Term Capital, Net<span style="float:right;">[+ short_term_capital_display +]</span></div>
        <div style="padding:4px 0; white-space:nowrap; border-top:2px solid #666;"><b>Capital Account</b><span style="float:right;">[+ capital_account_display +]</span></div>
        <div style="padding:3px 0; white-space:nowrap; background:rgba(215,205,180,0.12); border-bottom:1px dotted #aaa;">Errors &amp; Omissions<span style="float:right;">[+ errors_omissions_display +]</span></div>
        <div style="padding:4px 0; white-space:nowrap;"><b>Change in Reserves</b><span style="float:right;">[+ reserve_change_display +]</span></div>
      </div>

    </div>
  </div>

</td>

<td style="width:50%; vertical-align:top; padding:5px;">

  <div style="border:2px solid #666; border-radius:6px; padding:0; margin-bottom:10px; font-size:0.85em; overflow:hidden;">

    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:4px 6px; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Budget
    </div>

    <div style="display:flex; gap:4px; padding:0 3px; border-bottom:1px solid #666;">
      <div style="flex:1; min-width:0; padding:3px 0; text-align:center; font-weight:bold; white-space:nowrap;">
        Revenue
      </div>
      <div style="flex:1; min-width:0; padding:3px 0; text-align:center; font-weight:bold; white-space:nowrap;">
        Expenditure
      </div>
    </div>

    <div style="display:flex; align-items:flex-start; gap:4px; padding:0 3px;">

      <div style="flex:1; min-width:0;">
        <div style="padding:3px 0; white-space:nowrap; border-bottom:1px dotted #aaa;">Income Tax<span style="float:right;">[+ income_tax_display +]</span></div>
        <div style="padding:3px 0; white-space:nowrap; border-bottom:1px dotted #aaa;">Property Tax<span style="float:right;">[+ property_tax_display +]</span></div>
        <div style="padding:3px 0; white-space:nowrap; border-bottom:1px dotted #aaa;">Business Tax<span style="float:right;">[+ business_tax_display +]</span></div>
        <div style="padding:3px 0; white-space:nowrap; border-bottom:1px dotted #aaa;">Monopolies<span style="float:right;">[+ monopolies_display +]</span></div>
        <div style="padding:3px 0; white-space:nowrap; border-bottom:1px dotted #aaa;">Customs<span style="float:right;">[+ customs_display +]</span></div>
        <div style="padding:3px 0; white-space:nowrap; border-bottom:1px dotted #aaa;">Railways<span style="float:right;">[+ railway_revenue +]</span></div>
        <div style="padding:3px 0; white-space:nowrap;">Enterprises<span style="float:right;">[+ enterprises_revenue +]</span></div>
      </div>

      <div style="flex:1; min-width:0;">
        <div style="padding:3px 0; white-space:nowrap; border-bottom:1px dotted #aaa;">Government<span style="float:right;">[+ government_functions_display +]</span></div>

        <div style="padding:2px 0 2px 8px; white-space:nowrap; border-bottom:1px dotted #aaa;">Sovnarkom<span style="float:right;">[+ sovnarkom_expend +]</span></div>
        <div style="padding:2px 0 2px 8px; white-space:nowrap; border-bottom:1px dotted #aaa;">Foreign Affairs<span style="float:right;">[+ foreignaffairs_expend +]</span></div>
        <div style="padding:2px 0 2px 8px; white-space:nowrap; border-bottom:1px dotted #aaa;">Military<span style="float:right;">[+ military_expend +]</span></div>
        <div style="padding:2px 0 2px 8px; white-space:nowrap; border-bottom:1px dotted #aaa;">Enlightenment<span style="float:right;">[+ enlightenment_expend +]</span></div>
        <div style="padding:2px 0 2px 8px; white-space:nowrap; border-bottom:1px dotted #aaa;">Internal Affairs<span style="float:right;">[+ internal_expend +]</span></div>
        <div style="padding:2px 0 2px 8px; white-space:nowrap; border-bottom:1px dotted #aaa;">Railways<span style="float:right;">[+ railways_expend +]</span></div>
        <div style="padding:2px 0 2px 8px; white-space:nowrap; border-bottom:1px dotted #aaa;">Trade<span style="float:right;">[+ trade_expend +]</span></div>
        <div style="padding:2px 0 2px 8px; white-space:nowrap; border-bottom:1px dotted #aaa;">Finance<span style="float:right;">[+ finance_expend +]</span></div>
        <div style="padding:2px 0 2px 8px; white-space:nowrap; border-bottom:1px dotted #aaa;">Justice<span style="float:right;">[+ justice_expend +]</span></div>
        <div style="padding:2px 0 2px 8px; white-space:nowrap; border-bottom:1px dotted #aaa;">Labor<span style="float:right;">[+ labor_expend +]</span></div>
        <div style="padding:2px 0 2px 8px; white-space:nowrap; border-bottom:1px dotted #aaa;">Agriculture<span style="float:right;">[+ agriculture_expend +]</span></div>
        <div style="padding:2px 0 2px 8px; white-space:nowrap; border-bottom:1px dotted #aaa;">Food Supply<span style="float:right;">[+ foodsupply_expend +]</span></div>
        <div style="padding:2px 0 2px 8px; white-space:nowrap; border-bottom:1px dotted #aaa;">Nationalities<span style="float:right;">[+ nationalities_expend +]</span></div>
        <div style="padding:2px 0 2px 8px; white-space:nowrap; border-bottom:1px dotted #aaa;">Welfare<span style="float:right;">[+ welfare_expend +]</span></div>

        <div style="padding:3px 0; white-space:nowrap; border-bottom:1px dotted #aaa;">Interest<span style="float:right;">[+ interest_display +]</span></div>
        <div style="padding:3px 0; white-space:nowrap;">Indemnities<span style="float:right;">[+ indemnities_display +]</span></div>
      </div>

    </div>

    <div style="display:flex; gap:4px; padding:0 3px 4px 3px; border-top:2px solid #666;">

      <div style="flex:1; min-width:0; padding:4px 0; white-space:nowrap;">
        <b>Total Revenue</b><span style="float:right;">[+ income +]</span>
      </div>

      <div style="flex:1; min-width:0; padding:4px 0; white-space:nowrap;">
        <b>Total Expenditure</b><span style="float:right;">[+ expenditure +]</span>
      </div>

    </div>

  </div>

  <div style="border:2px solid #666; border-radius:6px; padding:0; margin-bottom:10px; font-size:0.85em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:4px 6px; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Labour
    </div>
    <!-- Labour metrics go here -->
  </div>

  <div style="border:2px solid #666; border-radius:6px; padding:0; font-size:0.85em; overflow:hidden;">
    <div style="background:#e8e8e8; border-bottom:1px solid #ccc; padding:4px 6px; font-size:1.2em; line-height:1.2; font-weight:bold; text-align:center; white-space:nowrap;">
      Economic Conditions
    </div>
    <!-- Economic Conditions metrics go here -->
  </div>

</td>
</tr>
</table>



- @budget_balancing
- @report_accept

@budget_balancing
title: Balance the budget
subtitle: We will have to make up the difference somehow. 
view-if: expenditure > (income + resources)
go-to: budget_balancing_menu


@budget_balancing_menu

- #budget_balancing


@issue_currency
title: Issue additional currency. 
choose-if: banks_seized = 1
unavailable-subtitle: We lack control over the banks. 
subtitle: +5 resources
tags: budget_balancing
on-arrival: resources += 5; monthly_inflation += (1.2 * (instability/12.5)); instability += 1;
go-to: finance_report

@bank_advances
title: Borrow from the State Bank.
choose-if: banks_seized = 1
unavailable-subtitle: We lack control over the banks. 
subtitle: +5 resources
tags: budget_balancing
on-arrival: resources += 5; bank_advances += 5; monthly_inflation += (1.2 * (instability/25)); instability += 0.25;
go-to: finance_report


@emergency_bonds
title: Issue emergency bonds
subtitle: +5 resources
tags: budget_balancing
on-arrival: bonds += 5; resources += 5; instability += 0.5; monthly_inflation += (1.2 * (instability/50)); bond_rate += 1 if bonds > 90; bond_rate += 0.5 if ((bonds < 90) and (bonds > 60)); bond_rate += 0.25 if bonds < 60; 
go-to: finance_report

@emergency_loans
title: Seek-out foreign loans
go-to: emergency_loans_menu
tags: budget_balancing

@emergency_loans_menu

- @cancel_loans

@cancel_loans
title: Cancel action
go-to: budget_balancing_menu





  

@report_accept
title: Accept the report. 
choose-if: expenditure <= (income + resources)
unavailable-subtitle: We haven't balanced the budget. 
on-arrival: {!
    Q.resources += (Q.income - Q.expenditure);
!}
go-to: root

  



  
