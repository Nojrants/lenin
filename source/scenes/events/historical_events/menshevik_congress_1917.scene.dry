title: Menshevik Party Congress
new-page: true
view-if: year = 1917 and month = 12 and week = 1
max-visits: 1
tags: event
go-to: election_algorithm.menshevik_party_election
set-jump: menshevik_congress_1917.post_election
on-arrival: {!
    Q.m_modifier = 10;
    // Q.m_strength -= 20;
!}


@post_election
go-to: post_election_menu
on-arrival: {!
    Q.centre_left_coalition = Q.left_m_percentage + Q.m_percentage + (Q.m_nonfactional_percentage * Q.m_dissent);
    Q.centre_right_coalition = Q.right_m_percentage + Q.m_percentage + (Q.m_nonfactional_percentage * Q.m_dissent);
!}
on-display: {!
// do the graphs
var data = [
    {"id": "left_m2",
     "legend": "Menshevik-Internationalist",
     "name": "Menshevik-Internationalist",
     "seats": Q.left_m_delegates},

    {"id": "m",
     "legend": "Menshevik-Centre",
     "name": "Menshevik-Centre",
     "seats": Q.m_delegates},

    {"id": "right_m2",
     "legend": "Menshevik-Defencist",
     "name": "Menshevik-Defencist",
     "seats": Q.right_m_delegates},

    {"id": "other",
     "legend": "Non-Factional",
     "name": "Non-Factional",
     "seats": Q.m_nonfactional_delegates}
];
if (window && d3) {
    var width = 625;
    var height = 625;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("soviet").style.height = width + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#soviet").datum(data).call(parliament);
}
!}

= Menshevik Party Congress

{!<svg id="soviet" style="width: 625px; height: 350px;"> </svg>!}

{!<table class="soviet-table">!}

{!<tr>
<th>Faction</th>
<th style="text-align: center;">Delegates</th>
<th style="text-align: center;">Percent</th>
</tr>!}

{!<tr>
<td><div class="party-box box left_m2"></div>Internationalists</td>
<td>!}[+ left_m_delegates +]{!</td>
<td>!}[+ left_m_percentage +]%{!</td>
</tr>!}

{!<tr>
<td><div class="party-box box m"></div>Centre</td>
<td>!}[+ m_delegates +]{!</td>
<td>!}[+ m_percentage +]%{!</td>

</tr>!}

{!<tr>
<td><div class="party-box box right_m2"></div>Defencists</td>
<td>!}[+ right_m_delegates +]{!</td>
<td>!}[+ right_m_percentage +]%{!</td>
</tr>!}

{!<tr>
<td><div class="party-box box other"></div>Non-Factional</td>
<td>!}[+ m_nonfactional_delegates +]{!</td>
<td>!}[+ m_nonfactional_percentage +]%{!</td>
</tr>!}

{!</table>!}



The <span style="color: var(--m-color); font-weight: bold;">Mensheviks</span> have called for an extraordinary party congress in Petrograd, hoping to ease the growing factional tensions within their ranks and decide on a course of action regarding the <span style="color: var(--b-color);">Bolshevik</span> government.

According to the Defencists, the Bolsheviks could no longer be considered a party of democracy or socialism, making cooperation with them completely untenable. It was their duty now to resist the Bolshevik dictatorship by all means necessary, even taking up arms where opportune. They likewise call for the Mensheviks to refuse to sit in the CEC – so as to not legitimize the Bolshevik seizure of power – while putting all their efforts into defending the Constituent Assembly. 

On the other side of the spectrum, Martov's internationalist wing argues for cautious participation in government and resistance to Bolshevik policy only through peaceful means, in order to prevent at all costs a debilitating civil war.

@post_election_menu

- @left
- @left_centre
- @centre
- @right_centre
- @right

@left
title: The <span style="color: var(--left_m2); font-weight: bold;">Internationalists</span> take full control of the party. 
choose-if: left_m_percentage > 50
unavailable-subtitle: [+ left_m_percentage +]% – The Internationalists lack the votes for this.  

@left_centre
title: The <span style="color: var(--m); font-weight: bold;">Centre</span> votes with the <span style="color: var(--left_m2); font-weight: bold;">Internationalists</span>.
choose-if: centre_left_coalition > 50
unavailable-subtitle: [+ centre_left_coalition +]% – The Centre-Left lack the votes for this.  

@centre
title: The <span style="color: var(--m); font-weight: bold;">Centre</span> forces a compromise that leaves neither extreme satisfied. 
choose-if: m_percentage > 50
unavailable-subtitle: [+ m_percentage +]% – The Centre lacks the votes for this.  

@right_centre
title: The <span style="color: var(--m); font-weight: bold;">Centre</span> votes with the <span style="color: var(--right_m2); font-weight: bold;">Defencists</span>.
choose-if: centre_right_coalition > 50
unavailable-subtitle: [+ centre_right_coalition +]% – The Centre-Right lacks the votes for this.  

@right
title: The <span style="color: var(--right_m2); font-weight: bold;">Defencists</span> take full control of the party. 
choose-if: right_m_percentage > 50
unavailable-subtitle: [+ right_m_percentage +]% – The Defencists lack the votes for this.  



