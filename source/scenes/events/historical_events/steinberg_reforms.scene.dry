  if (Q.prime_minister_party != "Bolshevik" && Q.prime_minister_party != "Vacant" && Q.prime_minister_party != "None") Q.opposition_vote += 1;
  if (Q.foreign_minister_party != "Bolshevik" && Q.foreign_minister_party != "Vacant" && Q.foreign_minister_party != "None") Q.opposition_vote += 1;
