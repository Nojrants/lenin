  if (Q.property_minister_party == "NS") { Q.ns_represented -= 1; Q.commissariats_held += 1; }
  if (Q.property_minister_party == "SD-Int") { Q.sdi_represented -= 1; Q.commissariats_held += 1; }
  Q.property_minister = "None"; Q.property_minister_party = ""; 
!}
go-to: cabinet_negotiations

