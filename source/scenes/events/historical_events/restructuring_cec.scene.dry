@add_peasants
title: Add 25 seats for peasant delegates.
tags: cec_restructure_offers
choose-if: add_peasants < 4
go-to: restructure_menu
on-arrival: {!
	Q.add_peasants += 1;
	Q.new_peasant_seats += 25;

	Q.cec_seats += 25;
	
	if (coalition_government == 1) {
		Q.anarchist_cec += 2;
		Q.maximalist_cec += 1;	
		Q.b_cec += 3;
		Q.sdi_cec += 0;
		Q.left_m_cec += 0;
		Q.m_cec += 0;
		Q.right_m_cec += 0;
		Q.lsr_cec += 13;
		Q.sr_cec += 10;
		Q.popular_socialist_cec += 0;
		Q.other_cec += 2;
	}
	
	if (coalition_government != 1) {
		Q.anarchist_cec += 2;
		Q.maximalist_cec += 1;	
		Q.b_cec += 5;
		Q.sdi_cec += 0;
		Q.left_m_cec += 0;
		Q.m_cec += 0;
		Q.right_m_cec += 0;
		Q.lsr_cec += 13;
		Q.sr_cec += 2;
		Q.popular_socialist_cec += 0;
		Q.other_cec += 2;
	}
	
	Q.b_cec_display = Math.round((Q.b_cec/Q.cec_seats)*1000)/10;
	Q.m_cec_display = Math.round(((Q.left_m_cec + Q.m_cec + Q.right_m_cec)/Q.cec_seats)*1000)/10;
	Q.lsr_cec_display = Math.round((Q.lsr_cec/Q.cec_seats)*1000)/10;
	Q.sr_cec_display = Math.round((Q.sr_cec/Q.cec_seats)*1000)/10;
	Q.other_cec_display = Math.round(((Q.anarchist_cec + Q.maximalist_cec + Q.popular_socialist_cec + Q.other_cec)/Q.cec_seats)*1000)/10;
	
	Q.lsr_strength += 2; Q.sr_strength += 1; Q.b_strength += 1;
	Q.lsr_relation += 2; Q.sr_relation += 1; 
!}

@remove_peasants
title: Remove 25 seats for peasant delegates.
