@peasants_compromise
title: Add 108 seats from the peasant congress (mostly Bolshevik and Left-SR) to match our existing 108 seats.
subtitle: The Left-SRs consider this a fair compromise.
tags: cec_restructure_offers
view-if: coalition_government != 1 and peasants_compromise != 1
go-to: restructure_menu
on-arrival: {!
	Q.peasants_compromise = 1;
 	 Q.new_peasant_seats += 108;
	
	Q.cec_seats += 108;
	Q.anarchist_cec += 1;
	Q.maximalist_cec += 4;	
	Q.b_cec += 18;
	Q.sdi_cec += 7;
	Q.left_m_cec += 0;
	Q.m_cec += 0;
	Q.right_m_cec += 0;
	Q.lsr_cec += 76;
	Q.sr_cec += 0;
	Q.popular_socialist_cec += 0;
	Q.other_cec += 2;
	
	Q.b_cec_display = Math.round((Q.b_cec/Q.cec_seats)*1000)/10;
	Q.m_cec_display = Math.round(((Q.left_m_cec + Q.m_cec + Q.right_m_cec)/Q.cec_seats)*1000)/10;
	Q.lsr_cec_display = Math.round((Q.lsr_cec/Q.cec_seats)*1000)/10;
	Q.sr_cec_display = Math.round((Q.sr_cec/Q.cec_seats)*1000)/10;
	Q.other_cec_display = Math.round(((Q.anarchist_cec + Q.maximalist_cec + Q.popular_socialist_cec + Q.other_cec)/Q.cec_seats)*1000)/10;
	
	Q.lsr_strength += 15; Q.b_strength += 5;
	Q.lsr_relation += 5; 
!}

@peasants_compromise_cancel
title: Cancel the 108 seats from the peasant soviets. 
tags: cec_restructure_offers
view-if: peasants_compromise = 1
go-to: restructure_menu
on-arrival: {!
	Q.peasants_compromise = 0;
  	Q.new_peasant_seats -= 108;
	
	Q.cec_seats -= 108;
	Q.anarchist_cec -= 1;
	Q.maximalist_cec -= 4;	
	Q.b_cec -= 18;
	Q.sdi_cec -= 7;
	Q.left_m_cec -= 0;
	Q.m_cec -= 0;
	Q.right_m_cec -= 0;
	Q.lsr_cec -= 76;
	Q.sr_cec -= 0;
	Q.popular_socialist_cec -= 0;
	Q.other_cec -= 2;
	
	Q.b_cec_display = Math.round((Q.b_cec/Q.cec_seats)*1000)/10;
	Q.m_cec_display = Math.round(((Q.left_m_cec + Q.m_cec + Q.right_m_cec)/Q.cec_seats)*1000)/10;
	Q.lsr_cec_display = Math.round((Q.lsr_cec/Q.cec_seats)*1000)/10;
	Q.sr_cec_display = Math.round((Q.sr_cec/Q.cec_seats)*1000)/10;
	Q.other_cec_display = Math.round(((Q.anarchist_cec + Q.maximalist_cec + Q.popular_socialist_cec + Q.other_cec)/Q.cec_seats)*1000)/10;
	
	Q.lsr_strength -= 15; Q.b_strength -= 5;
	Q.lsr_relation -= 5; 
!}

