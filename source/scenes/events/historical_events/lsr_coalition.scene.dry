!}


@finalize_deal
title: Finalize the agreement. 
choose-if: commissariats_held <= commissariats_promised
unavailable-subtitle: The Left-SRs will not accept. 
on-arrival: {!
  Q.coalition_government = 1; Q.lsr_in_gov = 1; 
  Q.lsr_relation += 10; Q.lsr_strength += 10;   
  Q.democraticity += 1; Q.instability -= 1; Q.vikzhel_unrest -= 20;
  Q.moderate_dissent -= 5; Q.moderate_strength += 5;
!}

