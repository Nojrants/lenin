subtitle: [?if nationalities_minister != "Vacant" : Currently held by [+ nationalities_minister +] ?][?if nationalities_minister != "Vacant" and nationalities_minister_party=="Bolshevik": (<span class="tooltip-text" title="Russian Communist Party (Bolsheviks)" style="color: var(--bolshevik-color);">RCP(b)</span>)?][?if nationalities_minister_party=="Menshevik": (<span class="tooltip-text" title="Menshevik" style="color: var(--m-color);">RSDLP(u)</span>)?][?if nationalities_minister_party=="Left-SR": (<span class="tooltip-text" title="Left-SR" style="color: var(--lsr-color);">Left-SR</span>)?][?if nationalities_minister_party=="SR": (<span class="tooltip-text" title="Socialist Revolutionary" style="color: var(--sr-color);">SR</span>)?][?if nationalities_minister_party=="SD-Int": (<span class="tooltip-text" title="Social-Democratic Internationalist" style="color: var(--sdi-color);">SD-Int</span>)?][?if nationalities_minister_party=="NS": (<span class="tooltip-text" title="Popular Socialist" style="color: var(--ns-color);">NS</span>)?]
view-if: drop_nationalities = 1
tags: commissariat_assign2
go-to: nationalities_menu

@nationalities_menu

- #nationalities_candidates3

@nationalities_stalin
title: Iosif Stalin
subtitle: {!
Bolshevik — Party administrator and nationalities specialist.<br>
Overall skill: ★★★★★<br>
Suitability: ★★★
!}
unavailable-subtitle: {!
Bolshevik — Party administrator and nationalities specialist.<br>
Overall skill: ★★★★★<br>
Suitability: ★★★
!}
tags: nationalities_candidates3
choose-if: nationalities_minister != "Stalin"  
on-arrival: {!
  if (Q.nationalities_minister_party == "Left-SR") { Q.commissariats_held += 1; }
  Q.nationalities_minister = "Stalin"; Q.nationalities_minister_party = "Bolshevik";
!}
go-to: cabinet_negotiations2


@nationalities_vacant
title: Let's leave the position vacant for now. 
tags: nationalities_candidates3
on-arrival: {!
  if (Q.nationalities_minister_party == "Left-SR") Q.commissariats_held += 1;
  Q.nationalities_minister = "Vacant"; Q.nationalities_minister_party = "";
!}
go-to: cabinet_negotiations2

@nationalities_cancel
title: Cancel reassignment.
subtitle: [?if nationalities_minister != "Vacant": Keep [+ nationalities_minister +] in place. ?]
tags: nationalities_candidates3
go-to: cabinet_negotiations2
  


                       
@property_assign
title: Appoint the Properties Commissar 
subtitle: [?if property_minister != "None" and property_minister != "Vacant": Currently held by [+ property_minister +] ?][?if property_minister_party=="Bolshevik": (<span class="tooltip-text" title="Russian Communist Party (Bolsheviks)" style="color: var(--bolshevik-color);">RCP(b)</span>)?][?if property_minister_party=="Menshevik": (<span class="tooltip-text" title="Menshevik" style="color: var(--m-color);">RSDLP(u)</span>)?][?if property_minister_party=="Left-SR": (<span class="tooltip-text" title="Left-SR" style="color: var(--lsr-color);">Left-SR</span>)?][?if property_minister_party=="SR": (<span class="tooltip-text" title="Socialist Revolutionary" style="color: var(--sr-color);">SR</span>)?][?if property_minister_party=="SD-Int": (<span class="tooltip-text" title="Social-Democratic Internationalist" style="color: var(--sdi-color);">SD-Int</span>)?][?if property_minister_party=="NS": (<span class="tooltip-text" title="Popular Socialist" style="color: var(--ns-color);">NS</span>)?]
view-if: drop_property = 1
tags: commissariat_assign2
go-to: property_menu

@property_menu

- #property_candidates3

@property_karelin
title: Vladimir Karelin
subtitle: {!
Left-SR — Leading SR organizer and former law student.<br>
Overall skill: ★★★☆<br>
Suitability: ★★
!}
unavailable-subtitle: {!
Left-SR — Leading SR organizer and former law student.<br>
Overall skill: ★★★☆<br>
Suitability: ★★
!}
tags: property_candidates3
choose-if: property_minister != "Karelin" 
on-arrival: {!
  if (Q.posts_minister_party != "Left-SR") Q.commissariats_held -= 1;
  Q.property_minister = "Karelin"; Q.property_minister_party = "Left-SR";
!}
go-to: cabinet_negotiations2

@property_vacant
title: Cancel the proposed commissariat.
tags: property_candidates3
on-arrival: {!
  if (Q.property_minister_party == "Left-SR") { Q.commissariats_held += 1; }
  Q.property_minister = "None"; Q.property_minister_party = ""; 
!}
go-to: cabinet_negotiations2

@property_cancel
title: Cancel reassignment.
subtitle: [?if property_minister != "None": Keep [+ property_minister +] in place. ?]
view-if: property_minister != "None"
tags: property_candidates3
go-to: cabinet_negotiations2




