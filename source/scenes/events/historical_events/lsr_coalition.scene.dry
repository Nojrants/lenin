    Q.justice_minister_party = "Bolshevik";
  }
  if (Q.labor_minister_party != "Bolshevik") {
    Q.labor_minister = "Vacant";
    Q.labor_minister_party = "Bolshevik";
  }
  if (Q.agriculture_minister_party != "Bolshevik") {
    Q.agriculture_minister = "Vacant";
    Q.agriculture_minister_party = "Bolshevik";
