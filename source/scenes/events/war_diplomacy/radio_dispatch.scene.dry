title: Dispatch to the Germans
new-page: true
view-if: german_negotiations = 5
max-visits: 1
tags: event
go-to: dispatch_menu
on-arrival: {!
  Q.morale *= 0.8; Q.discipline *= 0.6; Q.war_weariness += 10; 
