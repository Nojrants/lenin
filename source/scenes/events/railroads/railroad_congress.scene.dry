title: Railways Congress
subtitle: The election results are in...
view-if: railway_congress_timer = 0 
go-to: election_algorithm.railways
set-jump: railroad_congress.post_election
new-page: true
tags: event

@post_election
go-to: post_election_menu
on-arrival: {!
  Q.railway_congress_timer = 24;
             
  Q.anarchist_rail = Q.anarchist_rail_votes_dec;
  Q.maximalist_rail = Q.maximalist_rail_votes_dec;
  Q.b_rail = Q.b_rail_votes_dec;
  Q.sdi_rail = Q.sdi_rail_votes_dec;
  Q.left_m_rail = Q.left_m_rail_votes_dec;
  Q.m_rail = Q.m_rail_votes_dec;
  Q.right_m_rail = Q.right_m_rail_votes_dec;
  Q.lsr_rail = Q.lsr_rail_votes_dec;
  Q.sr_rail = Q.sr_rail_votes_dec;
  Q.right_sr_rail = Q.right_sr_rail_votes_dec;
  Q.popular_socialist_rail = Q.popular_socialist_rail_votes_dec;
  Q.other_rail = Math.round(10*(Q.other_rail_votes_dec + Q.k_rail_votes_dec + Q.rightist_rail_votes_dec))/10;

  Q.b_rail_display = Math.round(Q.b_rail*10)/10; 
  Q.m_rail_display = Math.round((Q.left_m_rail + Q.m_rail + Q.right_m_rail)*10)/10; 
  Q.lsr_rail_display = Math.round(Q.lsr_rail*10)/10; 
  Q.sr_rail_display = Math.round((Q.sr_rail + Q.right_sr_rail)*10)/10; 
  Q.other_rail_display = Math.round((Q.anarchist_rail + Q.maximalist_rail + Q.sdi_rail + Q.popular_socialist_rail + Q.other_rail)*10)/10; 
!}
on-display: {!
// do the graphs
var data = [
{"id": "anarchist",
 "legend": "Anarchist",
 "name": "Anarchist",
 "seats": Math.round(Q.anarchist_rail*10)},
{"id": "maximalist",
 "legend": "SR-Maximalist",
 "name": "SR-Maximalist",
 "seats": Math.round(Q.maximalist_rail*10)},
{"id": "b",
 "legend": "Bolshevik",
 "name": "Bolshevik",
 "seats": Math.round(Q.b_rail*10)},
{"id": "sdi",
 "legend": "SD-Internationalist",
 "name": "SD-Internationalist",
 "seats": Math.round(Q.sdi_rail_votes_dec*10)},
{"id": "left_m",
 "legend": "Menshevik-Internationalist",
 "name": "Menshevik-Internationalist",
 "seats": Math.round(Q.left_m_rail_votes_dec*10)},
{"id": "m",
 "legend": "Menshevik-Centre",
 "name": "Menshevik-Centre",
 "seats": Math.round(Q.m_rail_votes_dec*10)},
{"id": "right_m",
 "legend": "Menshevik-Defencist",
 "name": "Menshevik-Defencist",
 "seats": Math.round(Q.right_m_rail_votes_dec*10)},
{"id": "lsr",
 "legend": "Left-SR",
 "name": "Left-SR",
 "seats": Math.round(Q.lsr_rail_votes_dec*10)},
{"id": "sr",
 "legend": "SR",
 "name": "SR",
 "seats": Math.round(Q.sr_rail_votes_dec*10)},
{"id": "right_sr",
 "legend": "Right SR",
 "name": "Right SR",
 "seats": Math.round(Q.right_sr_rail_votes_dec*10)},
{"id": "popular_socialist",
 "legend": "Popular Socialist",
 "name": "Popular Socialist",
 "seats": Math.round(Q.popular_socialist_rail_votes_dec*10)},
{"id": "other",
 "legend": "Other",
 "name": "Other",
 "seats": Math.round(Q.other_rail_votes_dec*10)},
];
if (window && d3) {
    var width = 625;
    var height = 625;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("soviet").style.height = width + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#soviet").datum(data).call(parliament);
}
!}

= Congress of Soviets

{!<svg id="soviet" viewBox="0 0 625 310"> </svg>!}

{!<table class="soviet-table">!}

{!<tr><th>Party</th><th>Vote Share</th></tr>!}

{!<tr><td><div class="party-box box a"></div>Anarchists</td><td>!}[+ anarchist_rail +]%{!</td></tr>!}

{!<tr><td><div class="party-box box maximalist"></div>Maximalists</td><td>!}[+ maximalist_rail +]%{!</td></tr>!}

{!<tr><td><div class="party-box box b"></div>Bolsheviks</td><td>!}[+ b_rail +]%{!</td></tr>!}

{!<tr><td><div class="party-box box sdi"></div>SD-Internationalists</td><td>!}[+ sdi_rail +]%{!</td></tr>!}

{!<tr><td><div class="party-box box left_m"></div>Menshevik Internationalists</td><td>!}[+ left_m_rail +]%{!</td></tr>!}

{!<tr><td><div class="party-box box m"></div>Mensheviks (Centre)</td><td>!}[+ m_rail +]%{!</td></tr>!}

{!<tr><td><div class="party-box box right_m"></div>Menshevik Defencists</td><td>!}[+ right_m_rail +]%{!</td></tr>!}

{!<tr><td><div class="party-box box lsr"></div>Left-SRs</td><td>!}[+ lsr_rail +]%{!</td></tr>!}

{!<tr><td><div class="party-box box sr"></div>SRs</td><td>!}[+ sr_rail +]%{!</td></tr>!}

{!<tr><td><div class="party-box box right_sr"></div>Right SRs</td><td>!}[+ right_sr_rail +]%{!</td></tr>!}

{!<tr><td><div class="party-box box popular_socialist"></div>Popular Socialists</td><td>!}[+ popular_socialist_rail +]%{!</td></tr>!}

{!<tr><td><div class="party-box box other"></div>Others</td><td>!}[+ other_rail +]%{!</td></tr>!}

{!</table>!}

@post_election_menu
title: Begin the congress...
 
