title: Railways Congress
subtitle: The election results are in...
view-if: railway_congress_timer = 0 
go-to: election_algorithm.railways
set-jump: railroad_congress.post_election
new-page: true
tags: event

@post_election
go-to: post_election_menu
on-arrival: {!
  Q.railway_congress_timer = 24;
console.log("Railway chart variables:", {
    anarchist: Q.anarchist_rail_votes_dec,
    maximalist: Q.maximalist_rail_votes_dec,
    b: Q.b_rail_votes_dec,
    sdi: Q.sdi_rail_votes_dec,
    left_m: Q.left_m_rail_votes_dec,
    m: Q.m_rail_votes_dec,
    right_m: Q.right_m_rail_votes_dec,
    lsr: Q.lsr_rail_votes_dec,
    sr: Q.sr_rail_votes_dec,
    right_sr: Q.right_sr_rail_votes_dec,
    popular_socialist: Q.popular_socialist_rail_votes_dec,
    other: Q.other_rail_votes_dec
});
!}
on-display: {!
// do the graphs
var data = [
{"id": "anarchist",
 "legend": "Anarchist",
 "name": "Anarchist",
 "seats": Math.round(Q.anarchist_rail_votes_dec*10)},
{"id": "maximalist",
 "legend": "SR-Maximalist",
 "name": "SR-Maximalist",
 "seats": Math.round(Q.maximalist_rail_votes_dec*10)},
{"id": "b",
 "legend": "Bolshevik",
 "name": "Bolshevik",
 "seats": Math.round(Q.b_rail_votes_dec*10)},
{"id": "sdi",
 "legend": "SD-Internationalist",
 "name": "SD-Internationalist",
 "seats": Math.round(Q.sdi_rail_votes_dec*10)},
{"id": "left_m",
 "legend": "Menshevik-Internationalist",
 "name": "Menshevik-Internationalist",
 "seats": Math.round(Q.left_m_rail_votes_dec*10)},
{"id": "m",
 "legend": "Menshevik-Centre",
 "name": "Menshevik-Centre",
 "seats": Math.round(Q.m_rail_votes_dec*10)},
{"id": "right_m",
 "legend": "Menshevik-Defencist",
 "name": "Menshevik-Defencist",
 "seats": Math.round(Q.right_m_rail_votes_dec*10)},
{"id": "lsr",
 "legend": "Left-SR",
 "name": "Left-SR",
 "seats": Math.round(Q.lsr_rail_votes_dec*10)},
{"id": "sr",
 "legend": "SR",
 "name": "SR",
 "seats": Math.round(Q.sr_rail_votes_dec*10)},
{"id": "right_sr",
 "legend": "Right SR",
 "name": "Right SR",
 "seats": Math.round(Q.right_sr_rail_votes_dec*10)},
{"id": "popular_socialist",
 "legend": "Popular Socialist",
 "name": "Popular Socialist",
 "seats": Math.round(Q.popular_socialist_rail_votes_dec*10)},
{"id": "other",
 "legend": "Other",
 "name": "Other",
 "seats": Math.round(Q.other_rail_votes_dec*10)},
];
if (window && d3) {
    var width = 625;
    var height = 625;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("soviet").style.height = width + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#soviet").datum(data).call(parliament);
}
!}

= Congress of Soviets

{!<svg id="soviet" viewBox="0 0 625 310"> </svg>!}

{!<table class="soviet-table">!}

{!<tr><th>Party</th><th>Vote Share</th></tr>!}

{!<tr><td><div class="party-box box a"></div>Anarchists</td><td>!}[+ anarchist_rail_votes_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box maximalist"></div>Maximalists</td><td>!}[+ maximalist_rail_votes_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box b"></div>Bolsheviks</td><td>!}[+ b_rail_votes_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box sdi"></div>SD-Internationalists</td><td>!}[+ sdi_rail_votes_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box left_m"></div>Menshevik Internationalists</td><td>!}[+ left_m_rail_votes_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box m"></div>Mensheviks (Centre)</td><td>!}[+ m_rail_votes_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box right_m"></div>Menshevik Defencists</td><td>!}[+ right_m_rail_votes_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box lsr"></div>Left-SRs</td><td>!}[+ lsr_rail_votes_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box sr"></div>SRs</td><td>!}[+ sr_rail_votes_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box right_sr"></div>Right SRs</td><td>!}[+ right_sr_rail_votes_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box popular_socialist"></div>Popular Socialists</td><td>!}[+ popular_socialist_rail_votes_dec +]%{!</td></tr>!}

{!<tr><td><div class="party-box box other"></div>Others</td><td>!}[+ other_rail_votes_dec +]%{!</td></tr>!}

{!</table>!}

@post_election_menu
title: Begin the congress...
 
