title: library
new-page: true
is-special: true
go-to: menu

@menu

- @figures: Figures and charts
- @backSpecialScene: Exit library.





@figures
go-to: menu
on-display: {!
// Soviet graph
// do the graphs
var data = [
{"id": "anarchist",
 "legend": "Anarchist",
 "name": "Anarchist",
 "seats": Math.round(Q.anarchist_soviet*10)},
{"id": "b",
 "legend": "Bolshevik",
 "name": "Bolshevik",
 "seats": Math.round(Q.b_soviet*10)},
];
if (Q.internationalist_soviet_votes_dec) {
    data.push({
            "id": "internationalist",
            "legend": "Menshevik-Internationalist",
            "name": "Menshevik-Internationalist",
            "seats": Math.round(Q.internationalist_soviet_votes_dec*10)
            });
}
data.push({
    "id": "m",
    "legend": "Menshevik",
    "name": "Menshevik",
    "seats": Math.round(Q.m_soviet*10)
});
if (Q.defensist_soviet_votes_dec) {
    data.push({
            "id": "defensist",
            "legend": "Menshevik-Defensist",
            "name": "Menshevik-Defensist",
            "seats": Math.round(Q.defensist_soviet_votes_dec*10)
            });
}
if (Q.left_sr_soviet_votes_dec) {
    data.push({
            "id": "left_sr",
            "legend": "Left-SR",
            "name": "Left-SR",
            "seats": Math.round(Q.left_sr_soviet_votes_dec*10)
            });
}
data.push({
    "id": "sr",
    "legend": "SR",
    "name": "SR",
    "seats": Math.round(Q.sr_soviet*10)
});
if (Q.right_sr_soviet_votes_dec) {
    data.push({
            "id": "right_sr",
            "legend": "Right-SR",
            "name": "Right-SR",
            "seats": Math.round(Q.right_sr_soviet_votes_dec*10)
            });
}
data.push({
    "id": "other",
    "legend": "Others",
    "name": "Others",
    "seats": Math.round(Q.other_soviet*10)
});
if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("soviet").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#soviet").datum(data).call(parliament);
}

// ---------------- CHARTS (plain SVG, no plugin needed) ----------------
var chartText = 'font-family:inherit;fill:currentColor;';
var monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
var toTime = function(d) { return new Date(d).getTime(); };
var num = function(v) { return Number(v) || 0; };
var esc = function(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;'); };
var fmt = function(v, dec) { return (Math.round(v * Math.pow(10, dec)) / Math.pow(10, dec)).toFixed(dec); };

// every chart starts at the beginning of March 1917 and zooms out as weeks are added
var CHART_START = new Date(1917, 2, 1).getTime();

// round tick spacing: 1, 2, 5 times a power of ten
var niceStep = function(range, count) {
    var raw = Math.max(range, 1e-9) / count;
    var p = Math.pow(10, Math.floor(Math.log(raw) / Math.LN10));
    var f = raw / p;
    return (f < 1.5 ? 1 : f < 3 ? 2 : f < 7 ? 5 : 10) * p;
};

// y range that fits the data: lo/hi padded and rounded to nice ticks
var yRange = function(lo, hi, forceZero) {
    if (forceZero) { lo = Math.min(0, lo); }
    if (hi - lo < 1e-9) { hi = lo + 1; }
    var pad = (hi - lo) * 0.08;
    var ytop = hi + pad;
    var ybottom = forceZero && lo >= 0 ? 0 : lo - pad;
    if (ybottom < 0 && lo >= 0) { ybottom = 0; }
    var step = niceStep(ytop - ybottom, 4);
    return { lo: Math.floor(ybottom / step) * step, hi: Math.ceil(ytop / step) * step, step: step };
};

// month ticks across [t0, t1]; the step widens as time accumulates
var timeTicks = function(t0, t1) {
    var months = (t1 - t0) / (30.44 * 86400000);
    var step = months <= 8 ? 1 : months <= 16 ? 2 : months <= 30 ? 3 : months <= 60 ? 6 : 12;
    var d = new Date(t0);
    var m = d.getMonth() + (d.getDate() > 1 ? 1 : 0);
    var cur = new Date(d.getFullYear(), m - (m % step), 1);
    var out = [];
    while (cur.getTime() <= t1) {
        if (cur.getTime() >= t0) { out.push(cur.getTime()); }
        cur = new Date(cur.getFullYear(), cur.getMonth() + step, 1);
    }
    return out;
};
var tickLabel = function(t) {
    var d = new Date(t);
    return monthNames[d.getMonth()] + " '" + String(d.getFullYear()).slice(2);
};

// one chart panel: grid, axes, and either lines or stacked areas.
// data-k marks which series an element belongs to (used for hover highlighting)
var panel = function(o) {
    var x0 = o.x, y0 = o.y, w = o.w, h = o.h;
    var left = 46, right = 14, top = 6, bottom = o.xLabels ? 24 : 6;
    var pw = w - left - right, ph = h - top - bottom;
    var t0 = o.t0, t1 = o.t1;
    var sx = function(t) { return x0 + left + (t1 > t0 ? (t - t0) / (t1 - t0) : 0.5) * pw; };
    var sy = function(v) { return y0 + top + (1 - (v - o.yr.lo) / (o.yr.hi - o.yr.lo)) * ph; };
    var s = '';
    for (var v = o.yr.lo; v <= o.yr.hi + o.yr.step * 0.001; v += o.yr.step) {
        var yy = sy(v);
        s += '<line x1="' + (x0 + left) + '" x2="' + (x0 + left + pw) + '" y1="' + yy + '" y2="' + yy + '" style="stroke:currentColor;opacity:0.15"/>';
        s += '<text x="' + (x0 + left - 6) + '" y="' + (yy + 4) + '" text-anchor="end" style="' + chartText + 'font-size:12px">' + fmt(v, o.yr.step < 1 ? 1 : 0) + (o.unit || '') + '</text>';
    }
    var ticks = timeTicks(t0, t1);
    ticks.forEach(function(t) {
        s += '<line x1="' + sx(t) + '" x2="' + sx(t) + '" y1="' + (y0 + top) + '" y2="' + (y0 + top + ph) + '" style="stroke:currentColor;opacity:0.08"/>';
        if (o.xLabels) {
            s += '<text x="' + sx(t) + '" y="' + (y0 + h - 6) + '" text-anchor="middle" style="' + chartText + 'font-size:12px">' + tickLabel(t) + '</text>';
        }
    });
    s += '<rect x="' + (x0 + left) + '" y="' + (y0 + top) + '" width="' + pw + '" height="' + ph + '" style="fill:none;stroke:currentColor;opacity:0.3"/>';

    if (o.stack) {
        // o.stack: [{k,label,color,pts:[[t,v],...]}], bottom first, all with the same times
        var n = o.stack[0].pts.length, base = [], i;
        for (i = 0; i < n; i++) { base.push(0); }
        o.stack.forEach(function(layer) {
            var upper = [], lower = [];
            for (i = 0; i < n; i++) {
                lower.push([layer.pts[i][0], base[i]]);
                base[i] += layer.pts[i][1];
                upper.push([layer.pts[i][0], base[i]]);
            }
            var path = upper.map(function(p, j) { return (j ? 'L' : 'M') + sx(p[0]) + ' ' + sy(p[1]); }).join(' ')
                + ' ' + lower.reverse().map(function(p) { return 'L' + sx(p[0]) + ' ' + sy(p[1]); }).join(' ') + ' Z';
            var last = layer.pts[n - 1][1];
            s += '<path data-k="' + layer.k + '" data-role="area" d="' + path + '" style="fill:' + layer.color + ';fill-opacity:0.85;stroke:' + layer.color + ';stroke-width:1"><title>' + esc(layer.label + ': ' + fmt(last, 1)) + '</title></path>';
        });
        var totalPath = base.map(function(v2, j) { return (j ? 'L' : 'M') + sx(o.stack[0].pts[j][0]) + ' ' + sy(v2); }).join(' ');
        s += '<path d="' + totalPath + '" style="fill:none;stroke:currentColor;stroke-width:2;pointer-events:none"/>';
    } else {
        o.series.forEach(function(ser) {
            var path = ser.pts.map(function(p, j) { return (j ? 'L' : 'M') + sx(p[0]) + ' ' + sy(p[1]); }).join(' ');
            s += '<path data-k="' + ser.k + '" data-role="line" d="' + path + '" style="fill:none;stroke:' + ser.color + ';stroke-width:2.5;stroke-linejoin:round"/>';
            ser.pts.forEach(function(p, j) {
                var last = j === ser.pts.length - 1;
                if (ser.pts.length <= 60 || last) {
                    s += '<circle data-k="' + ser.k + '" data-role="dot" cx="' + sx(p[0]) + '" cy="' + sy(p[1]) + '" r="' + (last ? 4 : 3) + '" style="fill:' + ser.color + '"><title>' + esc(ser.label + ', ' + tickLabel(p[0]) + ': ' + fmt(p[1], 1) + (o.unit || '')) + '</title></circle>';
                }
            });
            // wide invisible stroke so thin lines are easy to hover
            s += '<path data-k="' + ser.k + '" data-role="hit" d="' + path + '" style="fill:none;stroke:transparent;stroke-width:14;pointer-events:stroke"/>';
        });
    }
    // thick main axes on the left and bottom edges
    s += '<line x1="' + (x0 + left) + '" x2="' + (x0 + left) + '" y1="' + (y0 + top) + '" y2="' + (y0 + top + ph) + '" style="stroke:currentColor;stroke-width:3.5;stroke-linecap:square"/>';
    s += '<line x1="' + (x0 + left) + '" x2="' + (x0 + left + pw) + '" y1="' + (y0 + top + ph) + '" y2="' + (y0 + top + ph) + '" style="stroke:currentColor;stroke-width:3.5;stroke-linecap:square"/>';
    return s;
};

// legend placed below the chart; wraps onto more rows if needed
var legendBlock = function(items, W, y0) {
    var s = '', x = 52, row = 0, rowH = 22;
    items.forEach(function(it) {
        var w = 34 + it.label.length * 8;
        if (x + w > W - 14 && x > 52) { x = 52; row++; }
        var y = y0 + row * rowH;
        s += '<g data-k="' + it.k + '" data-role="legend" style="cursor:default">';
        s += '<rect x="' + x + '" y="' + y + '" width="14" height="14" style="fill:' + it.color + '"/>';
        s += '<text data-k="' + it.k + '" data-role="label" data-bw="normal" x="' + (x + 20) + '" y="' + (y + 12) + '" style="' + chartText + 'font-size:14px">' + esc(it.label) + '</text>';
        s += '<rect x="' + x + '" y="' + (y - 2) + '" width="' + w + '" height="20" style="fill:transparent"/>';
        s += '</g>';
        x += w;
    });
    return { svg: s, h: (row + 1) * rowH + 6 };
};

var timeSpan = function(records) {
    var t1 = CHART_START;
    records.forEach(function(r) { t1 = Math.max(t1, toTime(r.date)); });
    if (t1 - CHART_START < 28 * 86400000) { t1 = CHART_START + 28 * 86400000; }
    return { t0: CHART_START, t1: t1 };
};

// hover: highlight the series under the cursor and its legend entry (dim = fade the others)
var wireHover = function(el, dim) {
    var apply = function(k) {
        var nodes = el.querySelectorAll('[data-k]');
        for (var i = 0; i < nodes.length; i++) {
            var n = nodes[i];
            var role = n.getAttribute('data-role');
            var on = k !== null && n.getAttribute('data-k') === k;
            var off = k !== null && !on && dim;
            if (role === 'line') {
                n.style.strokeWidth = on ? '5' : '2.5';
                n.style.opacity = off ? '0.2' : '1';
            } else if (role === 'dot') {
                n.style.opacity = off ? '0.2' : '1';
            } else if (role === 'area') {
                n.style.fillOpacity = on ? '1' : (off ? '0.3' : '0.85');
                n.style.strokeWidth = on ? '2.5' : '1';
            } else if (role === 'legend') {
                n.style.opacity = off ? '0.35' : '1';
            } else if (role === 'label') {
                n.style.fontWeight = on ? 'bold' : (n.getAttribute('data-bw') || 'normal');
            }
        }
    };
    el.onmouseover = function(e) {
        var n = e.target && e.target.closest ? e.target.closest('[data-k]') : null;
        apply(n ? n.getAttribute('data-k') : null);
    };
    el.onmouseleave = function() { apply(null); };
};

var drawSvg = function(id, W, H, inner, dim) {
    var el = document.getElementById(id);
    if (!el) { return; }
    el.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
    el.setAttribute('preserveAspectRatio', 'xMidYMid meet');
    el.removeAttribute('width');
    el.removeAttribute('height');
    el.style.width = '100%';
    el.style.height = 'auto';
    el.innerHTML = inner;
    wireHover(el, dim);
};

var W = 900;

// ---- Soviet support: Bolsheviks, Mensheviks (all wings), SRs, Left-SRs, Others ----
// colors come from the :root variables in game.css
if (Q.soviet_support_records && Q.soviet_support_records.length >= 2) {
    var recs = Q.soviet_support_records.filter(function(r) { return r && r.date; });
    var sumKeys = function(r, keys) {
        var t = 0;
        keys.forEach(function(k) { t += num(r[k]); });
        return t;
    };
    var groups = [
        { label: 'Bolsheviks', color: 'var(--b)', keys: ['b'] },
        { label: 'Mensheviks', color: 'var(--m)', keys: ['m', 'left_m', 'right_m', 'left_m2', 'right_m2', 'sdi', 'internationalist', 'defensist'] },
        { label: 'SRs', color: 'var(--sr)', keys: ['sr', 'right_sr'] },
        { label: 'Left-SRs', color: 'var(--lsr)', keys: ['lsr', 'left_sr'] }
    ];
    var used = {};
    groups.forEach(function(g) { g.keys.forEach(function(k) { used[k] = true; }); });
    var series = groups.map(function(g, gi) {
        return { k: gi, label: g.label, color: g.color, pts: recs.map(function(r) { return [toTime(r.date), sumKeys(r, g.keys)]; }) };
    });
    series.push({
        k: groups.length, label: 'Others', color: 'var(--other)',
        pts: recs.map(function(r) {
            var t = 0;
            Object.keys(r).forEach(function(k) { if (k !== 'date' && !used[k]) { t += num(r[k]); } });
            return [toTime(r.date), t];
        })
    });
    var span = timeSpan(recs), lo = 1e9, hi = -1e9;
    series.forEach(function(s) { s.pts.forEach(function(p) { lo = Math.min(lo, p[1]); hi = Math.max(hi, p[1]); }); });
    var PH1 = 400;
    var inner = panel({ x: 0, y: 0, w: W, h: PH1, t0: span.t0, t1: span.t1, yr: yRange(lo, hi, true), series: series, unit: '%', xLabels: true });
    var lg1 = legendBlock(series.map(function(s) {
        return { k: s.k, label: s.label + ' ' + fmt(s.pts[s.pts.length - 1][1], 1) + '%', color: s.color };
    }), W, PH1 + 8);
    inner += lg1.svg;
    drawSvg('soviet_support_history', W, PH1 + 8 + lg1.h, inner, true);
}

// ---- Economy: one panel per measure, each with its own scale ----
if (Q.economic_records && Q.economic_records.length >= 2) {
    var erecs = Q.economic_records.filter(function(r) { return r && r.date; });
    var measures = [
        { key: ['monthly_inflation'], derive: 'inflation', label: 'Inflation (monthly %)', color: '#2a5bd7', unit: '%', zero: true },
        { key: ['hunger', 'urban_hunger'], label: 'Urban hunger (%)', color: '#c0399f', unit: '%', zero: true },
        { key: ['unemployment'], label: 'Unemployment (%)', color: '#d83b2d', unit: '%', zero: true }
    ];
    var espan = timeSpan(erecs);
    var PH = 170, EH = measures.length * PH + 30, einner = '';
    measures.forEach(function(m, i) {
        var found = null;
        m.key.forEach(function(kk) { if (!found && erecs.some(function(r) { return r[kk] !== undefined; })) { found = kk; } });
        var pts = erecs.map(function(r) {
            if (found) { return [toTime(r.date), num(r[found])]; }
            // older saves only have annual inflation: convert it to the monthly rate
            if (m.derive && r[m.derive] !== undefined) {
                found = found || false;
                return [toTime(r.date), (Math.pow(1 + num(r[m.derive]) / 100, 1 / 12) - 1) * 100];
            }
            return [toTime(r.date), 0];
        });
        if (!found && !m.derive && window.console) { console.log('figures: no record field for "' + m.label + '"; tried ' + m.key.join(', ') + '; record fields are: ' + Object.keys(erecs[erecs.length - 1]).join(', ')); }
        var lo = Math.min.apply(null, pts.map(function(p) { return p[1]; }));
        var hi = Math.max.apply(null, pts.map(function(p) { return p[1]; }));
        var y = i * PH;
        einner += '<text data-k="' + i + '" data-role="label" data-bw="bold" x="52" y="' + (y + 18) + '" style="' + chartText + 'font-size:15px;font-weight:bold">' + esc(m.label) + '</text>';
        einner += '<text x="' + (W - 14) + '" y="' + (y + 18) + '" text-anchor="end" style="' + chartText + 'font-size:15px;font-weight:bold;fill:' + m.color + '">' + fmt(pts[pts.length - 1][1], 1) + m.unit + '</text>';
        einner += panel({ x: 0, y: y + 22, w: W, h: PH - 22, t0: espan.t0, t1: espan.t1, yr: yRange(lo, hi, m.zero), series: [{ k: i, label: m.label, color: m.color, pts: pts }], unit: m.unit, xLabels: i === measures.length - 1 });
    });
    drawSvg('economic_history', W, EH, einner, false);
}

// ---- GDP: stacked sectors adding up to the GDP index ----
if (Q.economic_records && Q.economic_records.length >= 2) {
    var grecs = Q.economic_records.filter(function(r) { return r && r.date; });
    // each sector may be stored under a few possible names; first one found is used
    var sectors = [
        { keys: ['gdp_ag'], label: 'Agriculture', color: '#8fae4b' },
        { keys: ['gdp_industry'], label: 'Industry', color: '#5b6c7d' },
        { keys: ['gdp_trade'], label: 'Trade', color: '#d9a441' },
        { keys: ['gdp_government'], label: 'Government', color: '#a33a3a' }
    ];
    var sectorVal = function(r, s) {
        for (var i = 0; i < s.keys.length; i++) {
            if (r[s.keys[i]] !== undefined) { return num(r[s.keys[i]]); }
        }
        return undefined;
    };
    var hasSectors = grecs.some(function(r) { return sectors.some(function(s) { return sectorVal(r, s) !== undefined; }); });
    if (!hasSectors && window.console) { console.log('figures: no GDP sector fields found; record fields are: ' + Object.keys(grecs[grecs.length - 1]).join(', ')); }
    var gspan = timeSpan(grecs), gmax = 0, stack, gdpNow = 0;
    if (hasSectors) {
        stack = sectors.map(function(s, si) { return { k: si, label: s.label, color: s.color, pts: [] }; });
        grecs.forEach(function(r) {
            // the sector fields are already weighted contributions; scale them so the stack
            // equals the recorded GDP index (covers manual overrides of gdp_index)
            var sum = 0;
            sectors.forEach(function(s) { sum += num(sectorVal(r, s)); });
            var total = r.gdp !== undefined ? num(r.gdp) : sum;
            var scale = sum > 0 ? total / sum : 0;
            sectors.forEach(function(s, i) { stack[i].pts.push([toTime(r.date), num(sectorVal(r, s)) * scale]); });
            gmax = Math.max(gmax, total);
            gdpNow = total;
        });
    } else {
        stack = [{ k: 0, label: 'GDP', color: '#5b6c7d', pts: grecs.map(function(r) {
            var total = r.gdp_index !== undefined ? num(r.gdp_index) : num(r.gdp);
            gmax = Math.max(gmax, total); gdpNow = total;
            return [toTime(r.date), total];
        }) }];
    }
    var GPH = 380;
    var ginner = '<text x="' + (W - 14) + '" y="16" text-anchor="end" style="' + chartText + 'font-size:15px;font-weight:bold">GDP index ' + fmt(gdpNow, 1) + '</text>';
    ginner += panel({ x: 0, y: 24, w: W, h: GPH, t0: gspan.t0, t1: gspan.t1, yr: yRange(0, gmax, true), stack: stack, xLabels: true });
    var lg3 = legendBlock(stack.map(function(l) { return { k: l.k, label: l.label + ' ' + fmt(l.pts[l.pts.length - 1][1], 1), color: l.color }; }), W, GPH + 32);
    ginner += lg3.svg;
    drawSvg('gdp_history', W, GPH + 32 + lg3.h, ginner, true);
}
!}


= Soviet support history

{!<svg id="soviet_support_history" viewBox="0 0 900 460" style="width:100%; height:auto;"></svg>!}


= Economic history

{!<svg id="economic_history" viewBox="0 0 900 540" style="width:100%; height:auto;"></svg>!}

= GDP

{!<svg id="gdp_history" viewBox="0 0 900 420" style="width:100%; height:auto;"></svg>!}
