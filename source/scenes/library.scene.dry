title: library
new-page: true
is-special: true
go-to: figures


@figures
go-to: menu
on-display: {!
// Soviet graph
// do the graphs
var data = [
{"id": "anarchist",
 "legend": "Anarchist",
 "name": "Anarchist",
 "seats": Math.round(Q.anarchist_soviet*10)},
{"id": "b",
 "legend": "Bolshevik",
 "name": "Bolshevik",
 "seats": Math.round(Q.b_soviet*10)},
];
if (Q.internationalist_soviet_votes_dec) {
    data.push({
            "id": "internationalist",
            "legend": "Menshevik-Internationalist",
            "name": "Menshevik-Internationalist",
            "seats": Math.round(Q.internationalist_soviet_votes_dec*10)
            });
}
data.push({
    "id": "m",
    "legend": "Menshevik",
    "name": "Menshevik",
    "seats": Math.round(Q.m_soviet*10)
});
if (Q.defensist_soviet_votes_dec) {
    data.push({
            "id": "defensist",
            "legend": "Menshevik-Defensist",
            "name": "Menshevik-Defensist",
            "seats": Math.round(Q.defensist_soviet_votes_dec*10)
            });
}
if (Q.left_sr_soviet_votes_dec) {
    data.push({
            "id": "left_sr",
            "legend": "Left-SR",
            "name": "Left-SR",
            "seats": Math.round(Q.left_sr_soviet_votes_dec*10)
            });
}
data.push({
    "id": "sr",
    "legend": "SR",
    "name": "SR",
    "seats": Math.round(Q.sr_soviet*10)
});
if (Q.right_sr_soviet_votes_dec) {
    data.push({
            "id": "right_sr",
            "legend": "Right-SR",
            "name": "Right-SR",
            "seats": Math.round(Q.right_sr_soviet_votes_dec*10)
            });
}
data.push({
    "id": "other",
    "legend": "Others",
    "name": "Others",
    "seats": Math.round(Q.other_soviet*10)
});
if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("soviet").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#soviet").datum(data).call(parliament);
}

// ---------------- CHARTS (plain SVG, no plugin needed) ----------------
var chartText = 'font-family:inherit;fill:currentColor;';
var monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
var toTime = function(d) { return new Date(d).getTime(); };
var chartStart = new Date(1917, 2, 1).getTime();
var num = function(v) { return Number(v) || 0; };
var esc = function(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;'); };
var fmt = function(v, dec) { return (Math.round(v * Math.pow(10, dec)) / Math.pow(10, dec)).toFixed(dec); };

// round tick spacing: 1, 2, 5 times a power of ten
var niceStep = function(range, count) {
    var raw = Math.max(range, 1e-9) / count;
    var p = Math.pow(10, Math.floor(Math.log(raw) / Math.LN10));
    var f = raw / p;
    return (f < 1.5 ? 1 : f < 3 ? 2 : f < 7 ? 5 : 10) * p;
};

// y range that fits the data: lo/hi padded and rounded to nice ticks
var yRange = function(lo, hi, forceZero) {
    if (forceZero) { lo = Math.min(0, lo); }
    if (hi - lo < 1e-9) { hi = lo + 1; }
    var pad = (hi - lo) * 0.08;
    var top = hi + pad;
    var bottom = forceZero && lo >= 0 ? 0 : lo - pad;
    if (bottom < 0 && lo >= 0) { bottom = 0; }
    var step = niceStep(top - bottom, 4);
    return { lo: Math.floor(bottom / step) * step, hi: Math.ceil(top / step) * step, step: step };
};

// month ticks across [t0, t1]; the step widens as time accumulates
var timeTicks = function(t0, t1) {
    var months = (t1 - t0) / (30.44 * 86400000);
    var step = months <= 8 ? 1 : months <= 16 ? 2 : months <= 30 ? 3 : months <= 60 ? 6 : 12;
    var d = new Date(t0);
    var m = d.getMonth() + (d.getDate() > 1 ? 1 : 0);
    var cur = new Date(d.getFullYear(), m - (m % step), 1);
    var out = [t0];
    while (cur.getTime() <= t1) {
        if (cur.getTime() > t0) { out.push(cur.getTime()); }
        cur = new Date(cur.getFullYear(), cur.getMonth() + step, 1);
    }
    return out;
};
var tickLabel = function(t) {
    var d = new Date(t);
    return monthNames[d.getMonth()] + (d.getMonth() === 0 || true ? " '" + String(d.getFullYear()).slice(2) : '');
};

// one chart panel: grid, axes, and either lines or stacked areas
var panel = function(o) {
    var x0 = o.x, y0 = o.y, w = o.w, h = o.h;
    var left = 46, right = 14, top = 6, bottom = o.xLabels ? 24 : 6;
    var pw = w - left - right, ph = h - top - bottom;
    var t0 = o.t0, t1 = o.t1;
    var sx = function(t) { return x0 + left + (t1 > t0 ? (t - t0) / (t1 - t0) : 0.5) * pw; };
    var sy = function(v) { return y0 + top + (1 - (v - o.yr.lo) / (o.yr.hi - o.yr.lo)) * ph; };
    var s = '';
    for (var v = o.yr.lo; v <= o.yr.hi + o.yr.step * 0.001; v += o.yr.step) {
        var yy = sy(v);
        s += '<line x1="' + (x0 + left) + '" x2="' + (x0 + left + pw) + '" y1="' + yy + '" y2="' + yy + '" style="stroke:currentColor;opacity:0.15"/>';
        s += '<text x="' + (x0 + left - 6) + '" y="' + (yy + 4) + '" text-anchor="end" style="' + chartText + 'font-size:12px">' + fmt(v, o.yr.step < 1 ? 1 : 0) + (o.unit || '') + '</text>';
    }
    var ticks = timeTicks(t0, t1);
    ticks.forEach(function(t) {
        s += '<line x1="' + sx(t) + '" x2="' + sx(t) + '" y1="' + (y0 + top) + '" y2="' + (y0 + top + ph) + '" style="stroke:currentColor;opacity:0.08"/>';
        if (o.xLabels) {
            s += '<text x="' + sx(t) + '" y="' + (y0 + h - 6) + '" text-anchor="middle" style="' + chartText + 'font-size:12px">' + tickLabel(t) + '</text>';
        }
    });
    s += '<rect x="' + (x0 + left) + '" y="' + (y0 + top) + '" width="' + pw + '" height="' + ph + '" style="fill:none;stroke:currentColor;stroke-width:0.7;opacity:0.25"/>';
    s += '<line x1="' + (x0 + left) + '" x2="' + (x0 + left) + '" y1="' + (y0 + top) + '" y2="' + (y0 + top + ph) + '" style="stroke:currentColor;stroke-width:2.2"/>';
    s += '<line x1="' + (x0 + left) + '" x2="' + (x0 + left + pw) + '" y1="' + (y0 + top + ph) + '" y2="' + (y0 + top + ph) + '" style="stroke:currentColor;stroke-width:2.2"/>';

    if (o.stack) {
        // o.stack: [{label,color,pts:[[t,v],...]}], bottom first, all with the same times
        var n = o.stack[0].pts.length, base = [], i, k;
        for (i = 0; i < n; i++) { base.push(0); }
        o.stack.forEach(function(layer) {
            var upper = [], lower = [];
            for (i = 0; i < n; i++) {
                lower.push([layer.pts[i][0], base[i]]);
                base[i] += layer.pts[i][1];
                upper.push([layer.pts[i][0], base[i]]);
            }
            var path = upper.map(function(p, j) { return (j ? 'L' : 'M') + sx(p[0]) + ' ' + sy(p[1]); }).join(' ')
                + ' ' + lower.reverse().map(function(p) { return 'L' + sx(p[0]) + ' ' + sy(p[1]); }).join(' ') + ' Z';
            s += '<path class="chart-series chart-area" data-series="' + esc(layer.id || layer.label) + '" d="' + path + '" style="fill:' + layer.color + ';fill-opacity:0.85;stroke:' + layer.color + ';stroke-width:1.2"><title>' + esc(layer.label) + '</title></path>';
        });
        var totalPath = base.map(function(v, j) { return (j ? 'L' : 'M') + sx(o.stack[0].pts[j][0]) + ' ' + sy(v); }).join(' ');
        s += '<path d="' + totalPath + '" style="fill:none;stroke:#000;stroke-width:2"/>';
        base.forEach(function(v, j) {
            var t = o.stack[0].pts[j][0];
            var tip = tickLabel(t) + ': ' + fmt(v, 1) + ' (' + o.stack.map(function(l) { return l.label + ' ' + fmt(l.pts[j][1], 1); }).join(', ') + ')';
            s += '<circle cx="' + sx(t) + '" cy="' + sy(v) + '" r="' + (n > 60 ? 3 : 4) + '" style="fill:#000;fill-opacity:0"><title>' + esc(tip) + '</title></circle>';
        });
    } else {
        o.series.forEach(function(ser) {
            var path = ser.pts.map(function(p, j) { return (j ? 'L' : 'M') + sx(p[0]) + ' ' + sy(p[1]); }).join(' ');
            s += '<path class="chart-series chart-line" data-series="' + esc(ser.id || ser.label) + '" d="' + path + '" style="fill:none;stroke:' + ser.color + ';stroke-width:2.5;stroke-linejoin:round"><title>' + esc(ser.label) + '</title></path>';
            ser.pts.forEach(function(p, j) {
                var last = j === ser.pts.length - 1;
                if (ser.pts.length <= 60 || last) {
                    s += '<circle cx="' + sx(p[0]) + '" cy="' + sy(p[1]) + '" r="' + (last ? 4 : 3) + '" style="fill:' + ser.color + '"><title>' + esc(ser.label + ', ' + tickLabel(p[0]) + ': ' + fmt(p[1], 1) + (o.unit || '')) + '</title></circle>';
                }
            });
        });
    }
    return s;
};

var legendRow = function(items, W, y) {
    var s = '', x = 52, yy = y === undefined ? 6 : y;
    items.forEach(function(it) {
        var id = esc(it.id || it.label);
        s += '<g class="chart-legend-item" data-series="' + id + '">';
        s += '<rect x="' + x + '" y="' + yy + '" width="14" height="14" style="fill:' + it.color + '"/>';
        s += '<text x="' + (x + 20) + '" y="' + (yy + 12) + '" style="' + chartText + 'font-size:14px">' + esc(it.label) + '</text>';
        s += '</g>';
        x += 34 + it.label.length * 8;
    });
    return s;
};

var bindChartHover = function(id) {
    var svg = document.getElementById(id);
    if (!svg) { return; }
    var series = svg.querySelectorAll('.chart-series');
    var legends = svg.querySelectorAll('.chart-legend-item, .chart-series-name');
    var highlight = function(key) {
        series.forEach(function(el) {
            var active = el.getAttribute('data-series') === key;
            el.style.opacity = active ? '1' : '0.2';
            if (el.classList.contains('chart-line')) {
                el.style.strokeWidth = active ? '4' : '2';
            } else {
                el.style.fillOpacity = active ? '1' : '0.35';
                el.style.strokeWidth = active ? '2.5' : '1';
            }
        });
        legends.forEach(function(el) {
            var active = el.getAttribute('data-series') === key;
            var label = el.querySelector('text');
            if (label) {
                label.style.fontWeight = active ? 'bold' : 'normal';
                label.style.opacity = active ? '1' : '0.45';
            }
        });
    };
    var clear = function() {
        series.forEach(function(el) {
            el.style.opacity = '1';
            el.style.strokeWidth = el.classList.contains('chart-line') ? '2.5' : '1.2';
            if (el.classList.contains('chart-area')) { el.style.fillOpacity = '0.85'; }
        });
        legends.forEach(function(el) {
            var label = el.querySelector('text');
            if (label) { label.style.fontWeight = 'normal'; label.style.opacity = '1'; }
        });
    };
    series.forEach(function(el) {
        el.addEventListener('mouseenter', function() { highlight(el.getAttribute('data-series')); });
        el.addEventListener('mouseleave', clear);
    });
    legends.forEach(function(el) {
        el.addEventListener('mouseenter', function() { highlight(el.getAttribute('data-series')); });
        el.addEventListener('mouseleave', clear);
    });
};

var timeSpan = function(records) {
    var ts = records.map(function(r) { return toTime(r.date); });
    var t0 = chartStart, t1 = Math.max.apply(null, ts);
    if (t1 < t0 + 28 * 86400000) { t1 = t0 + 28 * 86400000; }
    return { t0: t0, t1: t1 };
};

var drawSvg = function(id, W, H, inner) {
    var el = document.getElementById(id);
    if (!el) { return; }
    el.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
    el.setAttribute('preserveAspectRatio', 'xMidYMid meet');
    el.removeAttribute('width');
    el.removeAttribute('height');
    el.style.width = '100%';
    el.style.height = 'auto';
    el.innerHTML = inner;
};

var W = 900;

// ---- Soviet support: Bolsheviks, Mensheviks (all wings), SRs, Left-SRs, Others ----
if (Q.soviet_support_records && Q.soviet_support_records.length >= 2) {
    var recs = Q.soviet_support_records.filter(function(r) { return r && r.date; });
    var sumKeys = function(r, keys) {
        var t = 0;
        keys.forEach(function(k) { t += num(r[k]); });
        return t;
    };
    var groups = [
        { label: 'Bolsheviks', color: 'var(--bolshevik-color)', keys: ['b'] },
        { label: 'Mensheviks', color: 'var(--m-color)', keys: ['m', 'left_m', 'right_m', 'internationalist', 'defensist'] },
        { label: 'SRs', color: 'var(--sr-color)', keys: ['sr', 'right_sr'] },
        { label: 'Left-SRs', color: 'var(--lsr-color)', keys: ['lsr', 'left_sr'] }
    ];
    var used = {};
    groups.forEach(function(g) { g.keys.forEach(function(k) { used[k] = true; }); });
    var series = groups.map(function(g) {
        return { id: g.label, label: g.label, color: g.color, pts: recs.map(function(r) { return [toTime(r.date), sumKeys(r, g.keys)]; }) };
    });
    series.push({
        id: 'Others', label: 'Others', color: 'var(--other-color, #919191)',
        pts: recs.map(function(r) {
            var t = 0;
            Object.keys(r).forEach(function(k) { if (k !== 'date' && !used[k]) { t += num(r[k]); } });
            return [toTime(r.date), t];
        })
    });
    var span = timeSpan(recs), lo = 1e9, hi = -1e9;
    series.forEach(function(s) { s.pts.forEach(function(p) { lo = Math.min(lo, p[1]); hi = Math.max(hi, p[1]); }); });
    var H1 = 490;
    var inner = panel({ x: 0, y: 0, w: W, h: H1 - 48, t0: span.t0, t1: span.t1, yr: yRange(lo, hi, true), series: series, unit: '%', xLabels: true });
    inner += legendRow(series.map(function(s) {
        return { id: s.id, label: s.label + ' ' + fmt(s.pts[s.pts.length - 1][1], 1) + '%', color: s.color };
    }), W, H1 - 24);
    drawSvg('soviet_support_history', W, H1, inner);
    bindChartHover('soviet_support_history');
}

// ---- Economy: one panel per measure, each with its own scale ----
if (Q.economic_records && Q.economic_records.length >= 2) {
    var erecs = Q.economic_records.filter(function(r) { return r && r.date; });
    var measures = [
        { key: 'inflation', label: 'Inflation (annual %)', color: '#2a5bd7', unit: '%', zero: true },
        { key: 'hunger', label: 'Urban hunger (%)', color: '#c0399f', unit: '%', zero: true },
        { key: 'unemployment', label: 'Unemployment (%)', color: '#d83b2d', unit: '%', zero: true }
    ];
    var espan = timeSpan(erecs);
    var PH = 170, EH = measures.length * PH + 30, einner = '';
    measures.forEach(function(m, i) {
        var pts = erecs.map(function(r) { return [toTime(r.date), num(r[m.key])]; });
        var lo = Math.min.apply(null, pts.map(function(p) { return p[1]; }));
        var hi = Math.max.apply(null, pts.map(function(p) { return p[1]; }));
        var y = i * PH;
        einner += '<text class="chart-series-name" data-series="' + esc(m.label) + '" x="52" y="' + (y + 18) + '" style="' + chartText + 'font-size:15px;font-weight:bold">' + esc(m.label) + '</text>';
        einner += '<text x="' + (W - 14) + '" y="' + (y + 18) + '" text-anchor="end" style="' + chartText + 'font-size:15px;font-weight:bold;fill:' + m.color + '">' + fmt(pts[pts.length - 1][1], 1) + m.unit + '</text>';
        einner += panel({ x: 0, y: y + 22, w: W, h: PH - 22, t0: espan.t0, t1: espan.t1, yr: yRange(lo, hi, m.zero), series: [{ id: m.label, label: m.label, color: m.color, pts: pts }], unit: m.unit, xLabels: i === measures.length - 1 });
    });
    drawSvg('economic_history', W, EH, einner);
    bindChartHover('economic_history');
}

// ---- GDP: stacked sectors adding up to the GDP index ----
if (Q.economic_records && Q.economic_records.length >= 2) {
    var grecs = Q.economic_records.filter(function(r) { return r && r.date; });
    var sectors = [
        { key: 'gdp_ag', label: 'Agriculture', color: '#8fae4b' },
        { key: 'gdp_industry', label: 'Industry', color: '#5b6c7d' },
        { key: 'gdp_trade', label: 'Trade', color: '#d9a441' },
        { key: 'gdp_government', label: 'Government', color: '#a33a3a' }
    ];
    var gdpTotal = function(r) { return num(r.GDP_index !== undefined ? r.GDP_index : r.gdp); };
    var hasSectors = grecs.every(function(r) { return sectors.every(function(s) { return r[s.key] !== undefined; }); });
    var gspan = timeSpan(grecs), top = 0, stack;
    if (hasSectors) {
        // scale each week's sectors so they add up to that week's recorded GDP index
        stack = sectors.map(function(s) { return { id: s.label, label: s.label, color: s.color, pts: [] }; });
        grecs.forEach(function(r) {
            var sum = 0;
            sectors.forEach(function(s) { sum += num(r[s.key]); });
            var k = sum > 0 ? gdpTotal(r) / sum : 0;
            sectors.forEach(function(s, i) { stack[i].pts.push([toTime(r.date), num(r[s.key]) * k]); });
            top = Math.max(top, gdpTotal(r));
        });
    } else {
        stack = [{ id: 'GDP', label: 'GDP', color: '#5b6c7d', pts: grecs.map(function(r) { top = Math.max(top, gdpTotal(r)); return [toTime(r.date), gdpTotal(r)]; }) }];
    }
    var GH = 460;
    var ginner = '<text x="' + (W - 14) + '" y="18" text-anchor="end" style="' + chartText + 'font-size:15px;font-weight:bold">GDP index ' + fmt(gdpTotal(grecs[grecs.length - 1]), 1) + '</text>';
    ginner += panel({ x: 0, y: 24, w: W, h: GH - 72, t0: gspan.t0, t1: gspan.t1, yr: yRange(0, top, true), stack: stack, xLabels: true });
    ginner += legendRow(stack.map(function(l) { return { id: l.id, label: l.label + ' ' + fmt(l.pts[l.pts.length - 1][1], 1), color: l.color }; }), W, GH - 24);
    drawSvg('gdp_history', W, GH, ginner);
    bindChartHover('gdp_history');
}
!}


= Soviet support history

{!<svg id="soviet_support_history" viewBox="0 0 900 490" style="width:100%; height:auto;"></svg>!}


= Economic history

{!<svg id="economic_history" viewBox="0 0 900 540" style="width:100%; height:auto;"></svg>!}

= GDP

{!<svg id="gdp_history" viewBox="0 0 900 460" style="width:100%; height:auto;"></svg>!}

- @backSpecialScene: Exit library.

