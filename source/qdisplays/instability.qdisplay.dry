
(..25) <span style="color: var(--level1-color);">Strong</span>
(25..40) <span style="color: var(--level2-color);">Secure</span>
(40..55) <span style="color: var(--level3-color);">Strained</span>
(55..70) <span style="color: var(--level4-color);">Precarious</span>
(70..85) <span style="color: var(--level5-color);">Turbulent</span>
(85..100) <span style="color: var(--level6-color);">Crisis</span>
(100..) <span style="color: var(--level7-color);">Catastrophe</span>
